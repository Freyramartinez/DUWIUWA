<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Puntos de Atención - WOMEN SAFETY</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.css">
    <link rel="stylesheet" href="/css/main.css">

    <style>
        /* =========================================================
           VARIABLES Y TEMAS
           Un solo selector cambia el "tema" de toda la vista:
           rosa (instancias) o azul (seguridad pública).
        ========================================================= */
        :root {
            --blue-sec:   #2b4a8e;
            --blue-dark:  #1f3568;
            --blue-light: #e8eef7;
            --blue-mid:   #5b7ec5;
            --ease: cubic-bezier(0.22, 0.61, 0.36, 1);
            --nav-h: 74px;
        }
        @media (max-width: 600px) { :root { --nav-h: 65px; } }

        #mapaTheme.theme-instancias {
            --accent:      var(--wine);
            --accent-dark: var(--wine-dark);
            --accent-mid:  var(--pink);
            --accent-soft: var(--pink-light);
            --accent-bg:   #fdf8fb;
            --accent-rgb:  142, 58, 104;
        }
        #mapaTheme.theme-seguridad {
            --accent:      var(--blue-sec);
            --accent-dark: var(--blue-dark);
            --accent-mid:  var(--blue-mid);
            --accent-soft: var(--blue-light);
            --accent-bg:   #f5f8fd;
            --accent-rgb:  43, 74, 142;
        }

        h1, .font-serif { font-family: 'Playfair Display', serif; }
        #mapaTheme .ws-section-label { color: var(--accent); transition: color .45s ease; }

        /* =========================================================
           ENCABEZADO
        ========================================================= */
        .map-hero {
            background: var(--accent-soft);
            transition: background-color .5s ease;
        }

        /* =========================================================
           SELECTOR ÚNICO (reemplaza los tabs de arriba y abajo)
        ========================================================= */
        .ws-switch-bar {
            position: sticky;
            top: var(--nav-h);
            z-index: 1100;
            padding: .75rem 0;
            background: rgba(255, 253, 253, 0.92);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(var(--accent-rgb), .14);
            transition: border-color .5s ease;
        }

        .ws-switch {
            position: relative;
            display: flex;
            max-width: 680px;
            margin: 0 auto;
            padding: 6px;
            border: 1px solid rgba(var(--accent-rgb), .18);
            border-radius: 999px;
            background: var(--accent-soft);
            transition: background-color .5s ease, border-color .5s ease;
        }

        /* Píldora que se desliza y cambia de color */
        .ws-switch-thumb {
            position: absolute;
            top: 6px;
            bottom: 6px;
            left: 6px;
            width: calc(50% - 6px);
            border-radius: 999px;
            background: var(--accent);
            box-shadow: 0 10px 24px rgba(var(--accent-rgb), .35);
            transition: transform .5s var(--ease), background-color .5s ease, box-shadow .5s ease;
        }
        #mapaTheme.theme-seguridad .ws-switch-thumb { transform: translateX(100%); }

        .ws-switch .nav-link {
            position: relative;
            z-index: 1;
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .8rem;
            padding: .8rem 1rem;
            border: 0;
            border-radius: 999px;
            background: transparent;
            color: var(--accent-dark);
            text-align: left;
            transition: color .35s ease;
        }
        .ws-switch .nav-link:hover  { color: var(--accent-dark); }
        .ws-switch .nav-link.active,
        .ws-switch .nav-link.active:hover { color: #fff; }
        .ws-switch .nav-link:focus-visible { outline: 3px solid var(--accent-mid); outline-offset: 2px; }

        .ws-tab-icon {
            width: 38px;
            height: 38px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: rgba(var(--accent-rgb), .12);
            color: var(--accent);
            font-size: 1.05rem;
            transition: background-color .35s ease, color .35s ease, transform .4s var(--ease);
        }
        .ws-switch .nav-link.active .ws-tab-icon { background: rgba(255, 255, 255, .22); color: #fff; transform: scale(1.08); }

        .ws-tab-text { display: flex; flex-direction: column; line-height: 1.2; }
        .ws-tab-title { font-size: .9rem; font-weight: 700; }
        .ws-tab-sub   { font-size: .72rem; font-weight: 500; opacity: .8; }

        @media (max-width: 520px) {
            .ws-switch .nav-link { flex-direction: column; gap: .3rem; padding: .65rem .4rem; text-align: center; }
            .ws-tab-icon { width: 32px; height: 32px; font-size: .9rem; }
            .ws-tab-title { font-size: .78rem; }
            .ws-tab-sub { display: none; }
        }

        /* =========================================================
           TARJETA MÁS CERCANA
        ========================================================= */
        #nearestCard {
            border: 1px solid var(--border);
            border-left: 4px solid var(--accent);
            transition: border-color .45s ease, box-shadow .4s var(--ease), transform .4s var(--ease);
        }
        #nearestCard:hover { transform: translateY(-3px); box-shadow: 0 16px 36px rgba(var(--accent-rgb), .14) !important; }

        .nearest-icon {
            width: 52px;
            height: 52px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: .75rem;
            background: var(--accent-soft);
            color: var(--accent);
            font-size: 1.35rem;
            transition: background-color .45s ease, color .45s ease;
        }
        #nearestLabel {
            font-size: .7rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .12em;
            color: var(--accent);
            transition: color .45s ease;
        }
        #nearestKm {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            line-height: 1;
            color: var(--accent);
            transition: color .45s ease;
        }
        .status-dot {
            width: 8px;
            height: 8px;
            display: inline-block;
            flex-shrink: 0;
            border-radius: 50%;
            background: #bbb;
        }
        .status-dot.live { background: #3fa96a; box-shadow: 0 0 0 4px rgba(63, 169, 106, .18); }

        /* =========================================================
           MAPA
        ========================================================= */
        .map-wrapper {
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(var(--accent-rgb), .28);
            border-radius: 1.25rem;
            box-shadow: 0 10px 34px rgba(var(--accent-rgb), .14);
            transition: border-color .5s ease, box-shadow .5s ease;
        }
        #ws-map { height: 480px; width: 100%; }
        @media (max-width: 767px) { #ws-map { height: 340px; } }

        /* Etiqueta flotante: qué categoría se está viendo */
        .map-chip {
            position: absolute;
            top: 12px;
            right: 12px;
            z-index: 800;
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            padding: .5rem .95rem;
            border-radius: 999px;
            background: var(--accent);
            color: #fff;
            font-size: .78rem;
            font-weight: 700;
            box-shadow: 0 8px 22px rgba(var(--accent-rgb), .35);
            transition: background-color .5s ease, box-shadow .5s ease;
        }

        /* Oculta instrucciones de ruta de LRM */
        .leaflet-routing-container { display: none; }

        /* =========================================================
           AVISO, BUSCADOR Y FILTROS
        ========================================================= */
        .privacy-note {
            background: var(--accent-soft);
            color: var(--accent-dark);
            transition: background-color .5s ease, color .5s ease;
        }

        .section-controls {
            padding: 1rem 1.25rem;
            border: 1px solid rgba(var(--accent-rgb), .2);
            border-radius: 1rem;
            background: #fff;
            transition: border-color .5s ease;
        }
        .section-controls .form-control:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 .2rem rgba(var(--accent-rgb), .18);
        }
        .section-controls .input-group:focus-within .input-group-text { border-color: var(--accent); }

        .filter-pill {
            padding: .35rem 1rem;
            border: 1.5px solid var(--border);
            border-radius: 999px;
            background: #fff;
            color: var(--gray);
            font-size: .8rem;
            font-weight: 600;
            transition: transform .3s var(--ease), background-color .3s ease, border-color .3s ease, color .3s ease;
        }
        .filter-pill:hover { transform: translateY(-2px); border-color: var(--accent); background: var(--accent-soft); color: var(--accent); }
        .filter-pill.active { border-color: var(--accent); background: var(--accent); color: #fff; }
        .filter-pill:focus-visible { outline: 3px solid var(--accent-mid); outline-offset: 2px; }

        /* =========================================================
           LISTADO DE LUGARES
        ========================================================= */
        .place-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1rem;
        }
        @media (max-width: 575px) { .place-grid { grid-template-columns: 1fr; } }

        .place-card {
            padding: 1.1rem;
            border: 1px solid var(--border);
            border-radius: 1rem;
            background: #fff;
            cursor: pointer;
            transition: transform .35s var(--ease), border-color .35s ease,
                        box-shadow .35s var(--ease), background-color .35s ease;
        }
        .place-card:hover {
            transform: translateY(-5px);
            border-color: var(--accent);
            box-shadow: 0 16px 34px rgba(var(--accent-rgb), .16);
        }
        .place-card.selected {
            border-color: var(--accent);
            background: var(--accent-bg);
            box-shadow: 0 12px 28px rgba(var(--accent-rgb), .2);
        }

        .card-label,
        .card-dist {
            padding: .2rem .7rem;
            border-radius: 2rem;
            background: var(--accent-soft);
            color: var(--accent);
            font-size: .7rem;
            font-weight: 700;
            transition: background-color .45s ease, color .45s ease;
        }
        .card-label { letter-spacing: .06em; text-transform: uppercase; }
        .card-dist  { font-size: .75rem; }

        .card-info-row {
            display: flex;
            align-items: flex-start;
            gap: .5rem;
            margin-top: .4rem;
            color: #5a5a5a;
            font-size: .81rem;
            line-height: 1.4;
        }
        .card-info-row .bi { flex-shrink: 0; margin-top: 2px; font-size: .8rem; color: var(--accent); transition: color .45s ease; }
        .card-phone { color: inherit; text-decoration: none; font-weight: 600; }
        .card-phone:hover { color: var(--accent); text-decoration: underline; }

        /* Entrada escalonada al cambiar de pestaña */
        @keyframes cardIn {
            from { opacity: 0; transform: translateY(14px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .place-grid.anim .place-card { animation: cardIn .5s var(--ease) both; animation-delay: calc(var(--i, 0) * 45ms); }

        @media (prefers-reduced-motion: reduce) {
            * { transition: none !important; animation: none !important; }
        }
    </style>
</head>

<body>

    <%- include('partials/navbar') %>

    <!-- Todo lo que está dentro cambia de color con el selector -->
    <div id="mapaTheme" class="theme-instancias">

        <!-- ══════════════════════════════════════
             ENCABEZADO
        ══════════════════════════════════════ -->
        <header class="map-hero py-5">
            <div class="container text-center">
                <span class="ws-section-label">Red de apoyo en Hidalgo</span>
                <h1 class="font-serif fw-medium mb-3" style="font-size: clamp(2rem,4.5vw,3rem); color: var(--dark);">
                    Encuentra ayuda cerca de ti.
                </h1>
                <p class="text-muted mx-auto mb-0" style="max-width: 520px; font-size: .97rem; line-height: 1.7;">
                    Localiza instancias de atención y dependencias de seguridad pública en Hidalgo.
                    Activa tu ubicación para ver la más cercana y trazar la ruta automáticamente.
                </p>
            </div>
        </header>

        <!-- ══════════════════════════════════════
             SELECTOR ÚNICO (queda fijo al hacer scroll)
        ══════════════════════════════════════ -->
        <div class="ws-switch-bar">
            <div class="container">
                <div class="ws-switch nav" role="tablist" aria-label="Tipo de lugares">

                    <span class="ws-switch-thumb" aria-hidden="true"></span>

                    <button class="nav-link active" id="tab-instancias" type="button" role="tab"
                            aria-selected="true" data-tab="instancias">
                        <span class="ws-tab-icon"><i class="bi bi-people-fill"></i></span>
                        <span class="ws-tab-text">
                            <span class="ws-tab-title">Instancias de Atención</span>
                            <span class="ws-tab-sub">Centros de apoyo y justicia</span>
                        </span>
                    </button>

                    <button class="nav-link" id="tab-seguridad" type="button" role="tab"
                            aria-selected="false" data-tab="seguridad" tabindex="-1">
                        <span class="ws-tab-icon"><i class="bi bi-shield-fill"></i></span>
                        <span class="ws-tab-text">
                            <span class="ws-tab-title">Seguridad Pública</span>
                            <span class="ws-tab-sub">Dependencias de Hidalgo</span>
                        </span>
                    </button>

                </div>
            </div>
        </div>

        <main class="container py-4" id="tabPanel" role="tabpanel" aria-labelledby="tab-instancias">

            <!-- ══════════════════════════════════════
                 TARJETA MÁS CERCANA
            ══════════════════════════════════════ -->
            <div class="card shadow-sm rounded-4 mb-4" id="nearestCard">
                <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3 py-3 px-4">

                    <div class="d-flex align-items-center gap-3">
                        <div class="nearest-icon">
                            <i class="bi bi-geo-alt-fill"></i>
                        </div>
                        <div>
                            <div id="nearestLabel">Más cercana a ti</div>
                            <div class="fw-bold mt-1" style="font-size:.97rem;" id="nearestName">
                                Activa tu ubicación
                            </div>
                            <div class="text-muted small mt-1" id="nearestAddress">
                                Te ubicamos y trazamos la ruta automáticamente.
                            </div>
                        </div>
                    </div>

                    <div class="text-end">
                        <div id="nearestKm">—</div>
                        <small class="text-muted" id="nearestEta">distancia aprox.</small>
                    </div>

                    <div class="w-100 d-flex align-items-center gap-2 small text-muted border-top pt-2 mt-1">
                        <span class="status-dot" id="nearestDot"></span>
                        <span id="nearestStatusText">Ubicación no activada</span>
                    </div>

                </div>
            </div>

            <!-- ══════════════════════════════════════
                 MAPA (sin tabs propios)
            ══════════════════════════════════════ -->
            <div class="map-wrapper mb-4">
                <span class="map-chip" id="mapChip">
                    <i class="bi bi-people-fill" id="mapChipIcon"></i>
                    <span id="mapChipText">Instancias de Atención</span>
                </span>
                <div id="ws-map"></div>
            </div>

            <!-- Aviso de privacidad -->
            <div class="privacy-note d-flex align-items-start gap-2 rounded-3 p-3 mb-4 small">
                <i class="bi bi-shield-lock-fill mt-1 flex-shrink-0"></i>
                <span>
                    Tu ubicación se usa solo en este navegador para calcular la ruta.
                    No se guarda ni se envía a ningún servidor.
                </span>
            </div>

            <!-- ══════════════════════════════════════
                 BUSCADOR + FILTROS
            ══════════════════════════════════════ -->
            <div class="section-controls d-flex flex-wrap gap-2 align-items-center mb-4">
                <div class="input-group flex-grow-1" style="max-width: 340px;">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" id="mapSearch" class="form-control border-start-0"
                           placeholder="Buscar municipio o nombre..." aria-label="Buscar municipio o nombre">
                </div>
                <div class="d-flex gap-2 flex-wrap" id="filterGroup">
                    <button type="button" class="filter-pill active" data-filter="todos">Todos</button>
                    <button type="button" class="filter-pill" data-filter="municipal">Municipales</button>
                    <button type="button" class="filter-pill" data-filter="estatal">Estatales</button>
                </div>
            </div>

            <!-- ══════════════════════════════════════
                 LISTADO DE LUGARES
            ══════════════════════════════════════ -->
            <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-3">
                <h2 class="h5 font-serif mb-0" id="listTitle" style="color: var(--accent);">Instancias de Atención</h2>
                <span class="small text-muted" id="resultCount" aria-live="polite"></span>
            </div>

            <div class="place-grid" id="placeList"></div>

        </main>

    </div>

    <%- include('partials/footer') %>

