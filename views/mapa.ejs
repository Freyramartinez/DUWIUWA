            phone: "773 732 0027", hours: "24 horas",
            lat: 20.0580, lng: -99.3410
        },
        {
            name: "Policía Municipal de Tulancingo",
            category: "Municipal", tag: "municipal", municipio: "Tulancingo de Bravo",
            address: "H. Ayuntamiento, Tulancingo de Bravo, Hgo.",
            phone: "775 753 0100", hours: "24 horas",
            lat: 20.0870, lng: -98.3700
        },
        {
            name: "Policía Municipal de Actopan",
            category: "Municipal", tag: "municipal", municipio: "Actopan",
            address: "Palacio Municipal, Actopan, Hgo.",
            phone: "771 722 0005", hours: "24 horas",
            lat: 20.2700, lng: -98.9450
        },
        {
            name: "Policía Municipal de Ixmiquilpan",
            category: "Municipal", tag: "municipal", municipio: "Ixmiquilpan",
            address: "Palacio Municipal, Ixmiquilpan, Hgo.",
            phone: "759 720 0005", hours: "24 horas",
            lat: 20.4860, lng: -99.2200
        },
        {
            name: "Policía Municipal de Mixquiahuala",
            category: "Municipal", tag: "municipal", municipio: "Mixquiahuala",
            address: "Palacio Municipal, Mixquiahuala de Juárez, Hgo.",
            phone: "—", hours: "24 horas",
            lat: 20.2290, lng: -99.2170
        }
    ];

    // ════════════════════════════════════════════════════════
    // MAPA
    // ════════════════════════════════════════════════════════
    const map = L.map("ws-map", { zoomControl: true });
    map.fitBounds([[19.60, -99.90], [21.40, -97.95]]);

    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 18,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(map);

    function makeIcon(color) {
        return L.divIcon({
            className: "",
            html: `<div style="width:14px;height:14px;border-radius:50%;background:${color};border:2.5px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,.28);"></div>`,
            iconSize: [14, 14], iconAnchor: [7, 7]
        });
    }
    const wineIcon = makeIcon("#8e3a68");
    const blueIcon = makeIcon("#2b4a8e");
    const userIcon = L.divIcon({
        className: "",
        html: '<div style="width:16px;height:16px;border-radius:50%;background:#3fa96a;border:2.5px solid #fff;box-shadow:0 0 0 5px rgba(63,169,106,.2);"></div>',
        iconSize: [16, 16], iconAnchor: [8, 8]
    });

    // Crear marcadores sin agregarlos aún al mapa
    const markers = {};
    PLACES.forEach((p, i) => {
        markers["place_" + i] = L.marker([p.lat, p.lng], { icon: wineIcon })
            .bindPopup(`<strong>${p.name}</strong><br><small>${p.address}</small>`);
    });
    SECURITY.forEach((p, i) => {
        markers["sec_" + i] = L.marker([p.lat, p.lng], { icon: blueIcon })
            .bindPopup(`<strong>${p.name}</strong><br><small>${p.address}</small>`);
    });

    let userMarker = null;

    // ════════════════════════════════════════════════════════
    // ESTADO
    // ════════════════════════════════════════════════════════
    let userPos      = null;
    let hasCentered  = false;
    let activeTab    = "instancias";
    let activeFilter = "todos";
    let searchTerm   = "";
    let selectedKey  = null;
    let routingControl = null;

    function currentDataset() { return activeTab === "instancias" ? PLACES  : SECURITY; }
    function currentPrefix()  { return activeTab === "instancias" ? "place_" : "sec_";  }

    // ════════════════════════════════════════════════════════
    // UTILIDADES
    // ════════════════════════════════════════════════════════
    function haversineKm(lat1, lng1, lat2, lng2) {
        const R = 6371;
        const dLat = (lat2 - lat1) * Math.PI / 180;
        const dLng = (lng2 - lng1) * Math.PI / 180;
        const a = Math.sin(dLat / 2) ** 2
            + Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * Math.sin(dLng / 2) ** 2;
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }
    function fmtDist(km) { return km < 1 ? Math.round(km * 1000) + " m" : km.toFixed(1) + " km"; }
    function fmtDur(s) {
        const m = Math.round(s / 60);
        return m < 60 ? m + " min" : Math.floor(m / 60) + "h " + (m % 60) + "min";
    }

    // ════════════════════════════════════════════════════════
    // MARCADORES: mostrar solo los del tab activo
    // ════════════════════════════════════════════════════════
    function syncMarkers() {
        const show = currentPrefix();
        Object.entries(markers).forEach(([key, mk]) => {
            if (key.startsWith(show)) {
                if (!map.hasLayer(mk)) mk.addTo(map);
            } else {
                if (map.hasLayer(mk)) map.removeLayer(mk);
            }
        });
    }

    // ════════════════════════════════════════════════════════
    // RUTA
    // ════════════════════════════════════════════════════════
    function drawRoute(from, to) {
    const wp = [L.latLng(from.lat, from.lng), L.latLng(to.lat, to.lng)];
    const lineColor = activeTab === "instancias" ? "#8e3a68" : "#2b4a8e";

    if (routingControl) {
        // Eliminar el control anterior para recrearlo con el nuevo color
        map.removeControl(routingControl);
        routingControl = null;
    }

    routingControl = L.Routing.control({
        waypoints: wp,
        router: L.Routing.osrmv1({ serviceUrl: "https://router.project-osrm.org/route/v1" }),
        lineOptions: { styles: [{ color: lineColor, weight: 5, opacity: .85 }] },
        addWaypoints: false,
        draggableWaypoints: false,
        fitSelectedRoutes: true,
        show: false,
        createMarker: () => null
    }).addTo(map);

    routingControl.on("routesfound", e => {
        const s = e.routes[0].summary;
        document.getElementById("nearestKm").textContent  = fmtDist(s.totalDistance / 1000);
        document.getElementById("nearestEta").textContent = "aprox. " + fmtDur(s.totalTime) + " en auto";
    });
    routingControl.on("routingerror", () => {
        document.getElementById("nearestEta").textContent = "No se pudo calcular la ruta";
    });
}

    // ════════════════════════════════════════════════════════
    // NEAREST: busca el más cercano del dataset activo
    // ════════════════════════════════════════════════════════
    function updateNearest() {
        if (!userPos) return;

        const nearest = currentDataset()
            .map(p => ({ ...p, distance: haversineKm(userPos.lat, userPos.lng, p.lat, p.lng) }))
            .sort((a, b) => a.distance - b.distance)[0];

        document.getElementById("nearestName").textContent    = nearest.name;
        document.getElementById("nearestAddress").textContent = nearest.address;

        // Color de acento según tab
        const card = document.getElementById("nearestCard");
        if (activeTab === "seguridad") {
            card.classList.add("tab-seguridad");
        } else {
            card.classList.remove("tab-seguridad");
        }

        drawRoute(userPos, nearest);
    }

    // ════════════════════════════════════════════════════════
    // FILTRO Y ORDENAMIENTO
    // ════════════════════════════════════════════════════════
    function getFiltered() {
        return currentDataset()
            .map((p, i) => ({
                ...p, index: i,
                distance: userPos ? haversineKm(userPos.lat, userPos.lng, p.lat, p.lng) : null
            }))
            .filter(p => {
                if (activeFilter !== "todos" && p.tag !== activeFilter) return false;
                if (searchTerm.trim()) {
                    const t = searchTerm.trim().toLowerCase();
                    return p.municipio.toLowerCase().includes(t) || p.name.toLowerCase().includes(t);
                }
                return true;
            })
            .sort((a, b) => userPos ? a.distance - b.distance : 0);
    }

    // ════════════════════════════════════════════════════════
    // RENDER LISTADO
    // ════════════════════════════════════════════════════════
    function renderList() {
        const list      = getFiltered();
        const prefix    = currentPrefix();
        const isInst    = activeTab === "instancias";
        const container = document.getElementById("placeList");

        if (!list.length) {
            container.innerHTML = `
                <div class="text-center text-muted py-5" style="grid-column: 1 / -1;">
                    <i class="bi bi-search fs-2 d-block mb-2 opacity-50"></i>
                    <p class="mb-0">No encontramos resultados con ese criterio.</p>
                </div>`;
            return;
        }

        const iconColor = isInst ? "var(--wine)" : "var(--blue-sec)";

        container.innerHTML = list.map(p => {
            const key      = prefix + p.index;
            const isSel    = key === selectedKey;
            const secClass = isInst ? "" : " sec";
            const badgeCls = isInst ? "label-instancia" : "label-seguridad";

            return `
            <article class="place-card${secClass}${isSel ? " selected" : ""}"
                     data-key="${key}" data-lat="${p.lat}" data-lng="${p.lng}">

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="card-label ${badgeCls}">${p.category}</span>
                    ${p.distance !== null
                        ? `<span class="card-dist">${fmtDist(p.distance)}</span>`
                        : ""}
                </div>

                <h4 class="h6 fw-semibold mb-2" style="line-height:1.35; color: var(--dark);">
                    ${p.name}
                </h4>

                <div class="card-info-row">
                    <i class="bi bi-geo-alt-fill" style="color:${iconColor};"></i>
                    <span>${p.address}</span>
                </div>
                <div class="card-info-row">
                    <i class="bi bi-telephone-fill" style="color:${iconColor};"></i>
                    <span>${p.phone || "—"}</span>
                </div>
                <div class="card-info-row">
                    <i class="bi bi-clock-fill" style="color:${iconColor};"></i>
                    <span>${p.hours || "—"}</span>
                </div>
                <div class="card-info-row">
                    <i class="bi bi-building" style="color:${iconColor};"></i>
                    <span>${p.municipio}</span>
                </div>

            </article>`;
        }).join("");

        container.querySelectorAll(".place-card").forEach(card => {
            card.addEventListener("click", () => {
                selectedKey = card.dataset.key;
                const lat = parseFloat(card.dataset.lat);
                const lng = parseFloat(card.dataset.lng);
                map.flyTo([lat, lng], 14, { duration: .6 });
                const mk = markers[selectedKey];
                if (mk) mk.openPopup();
                if (userPos) {
                    const idx = parseInt(selectedKey.replace("place_", "").replace("sec_", ""));
                    drawRoute(userPos, currentDataset()[idx]);
                }
                renderList();
            });
        });
    }

    // ════════════════════════════════════════════════════════
    // GEOLOCALIZACIÓN
    // ════════════════════════════════════════════════════════
    function onPosition(pos) {
        userPos = { lat: pos.coords.latitude, lng: pos.coords.longitude };

        if (!userMarker) {
            userMarker = L.marker([userPos.lat, userPos.lng], { icon: userIcon })
                .addTo(map).bindPopup("Tu ubicación");
        } else {
            userMarker.setLatLng([userPos.lat, userPos.lng]);
        }

        if (!hasCentered) {
            map.flyTo([userPos.lat, userPos.lng], 12, { duration: 1 });
            hasCentered = true;
        }

        document.getElementById("nearestDot").classList.add("live");
        document.getElementById("nearestStatusText").textContent =
            "Ubicación activa — ruta actualizándose en vivo";

        updateNearest();
        renderList();
    }

    function onError() {
        document.getElementById("nearestStatusText").textContent =
            "No pudimos acceder a tu ubicación. Mostrando el mapa completo de Hidalgo.";
        document.getElementById("nearestName").textContent =
            "Activa tu ubicación para ver la más cercana";
    }

    if ("geolocation" in navigator) {
        navigator.geolocation.watchPosition(onPosition, onError, {
            enableHighAccuracy: true, maximumAge: 5000, timeout: 10000
        });
    } else {
        onError();
    }

    // ════════════════════════════════════════════════════════
    // TABS — función central, sincroniza arriba y abajo
    // ════════════════════════════════════════════════════════
    function setTab(tab) {
        activeTab   = tab;
        selectedKey = null;

        // Sincronizar botones
        document.querySelectorAll(".ws-map-tab").forEach(btn => {
            btn.classList.toggle("active", btn.dataset.tab === tab);
        });

        // Mover indicador de línea en ambas barras
        document.querySelectorAll(".ws-map-tabs").forEach(bar => {
            bar.classList.toggle("tab-seguridad", tab === "seguridad");
        });

        syncMarkers();
        updateNearest();
        renderList();
    }

    document.querySelectorAll(".ws-map-tab").forEach(btn => {
        btn.addEventListener("click", () => setTab(btn.dataset.tab));
    });

    // ════════════════════════════════════════════════════════
    // FILTROS
    // ════════════════════════════════════════════════════════
    document.querySelectorAll("#filterGroup button").forEach(btn => {
        btn.addEventListener("click", () => {
            document.querySelectorAll("#filterGroup button").forEach(b => {
                b.classList.remove("btn-wine");
                b.classList.add("btn-outline-secondary");
            });
            btn.classList.remove("btn-outline-secondary");
            btn.classList.add("btn-wine");
            activeFilter = btn.dataset.filter;
            renderList();
        });
    });

    // ════════════════════════════════════════════════════════
    // BÚSQUEDA
    // ════════════════════════════════════════════════════════
    document.getElementById("mapSearch").addEventListener("input", e => {
        searchTerm = e.target.value;
        renderList();
    });

    // ════════════════════════════════════════════════════════
    // INICIO
    // ════════════════════════════════════════════════════════
    setTab("instancias");

    </script>

</body>
</html>