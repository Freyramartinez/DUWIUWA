<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Puntos de Atención - WOMEN SAFETY</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.css">
    <link rel="stylesheet" href="/css/main.css">

    <style>
        /* Variables adicionales de esta vista */
        :root {
            --blue-sec:   #2b4a8e;
            --blue-light: #e8eef7;
            --blue-mid:   #5b7ec5;
        }

        h1, .font-serif { font-family: 'Playfair Display', serif; }

        /* ══════════════════════════════════════
           TARJETA MÁS CERCANA
        ══════════════════════════════════════ */
        #nearestCard {
            border-left: 4px solid var(--wine);
            transition: border-color .3s;
        }
        #nearestCard.tab-seguridad {
            border-left-color: var(--blue-sec);
        }

        .nearest-icon {
            width: 52px;
            height: 52px;
            border-radius: .75rem;
            background: var(--pink-light);
            color: var(--wine);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
            flex-shrink: 0;
            transition: background .3s, color .3s;
        }
        #nearestCard.tab-seguridad .nearest-icon {
            background: var(--blue-light);
            color: var(--blue-sec);
        }

        #nearestLabel {
            font-size: .7rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .12em;
            color: var(--wine);
            transition: color .3s;
        }
        #nearestCard.tab-seguridad #nearestLabel {
            color: var(--blue-sec);
        }

        #nearestKm {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            line-height: 1;
            color: var(--wine);
            transition: color .3s;
        }
        #nearestCard.tab-seguridad #nearestKm {
            color: var(--blue-sec);
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #bbb;
            display: inline-block;
            flex-shrink: 0;
        }
        .status-dot.live {
            background: #3fa96a;
            box-shadow: 0 0 0 4px rgba(63,169,106,.18);
        }

        /* ══════════════════════════════════════
           BLOQUE MAPA + TABS
        ══════════════════════════════════════ */
        .map-wrapper {
            border-radius: 1rem;
            overflow: hidden;
            box-shadow: 0 4px 24px rgba(142,58,104,.10);
            border: 1px solid var(--border);
        }

        /* Barra de tabs */
        .ws-map-tabs {
            display: flex;
            align-items: stretch;
            background: var(--cream);
            border-bottom: 1px solid var(--border);
            position: relative;
        }
        .ws-map-tabs--bottom {
            border-bottom: none;
            border-top: 1px solid var(--border);
        }

        /* Línea indicadora animada */
        .ws-map-tabs::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 0;
            height: 3px;
            width: 50%;
            background: var(--wine);
            border-radius: 3px 3px 0 0;
            transition: left .28s cubic-bezier(.4,0,.2,1), background .25s;
        }
        .ws-map-tabs--bottom::after {
            bottom: auto;
            top: 0;
            border-radius: 0 0 3px 3px;
        }
        .ws-map-tabs.tab-seguridad::after {
            left: 50%;
            background: var(--blue-sec);
        }

        /* Divisor vertical */
        .ws-tab-divider {
            width: 1px;
            background: var(--border);
            flex-shrink: 0;
        }

        /* Botón de tab */
        .ws-map-tab {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .85rem;
            padding: .95rem 1.25rem;
            background: transparent;
            border: none;
            cursor: pointer;
            text-align: left;
            transition: background .2s;
        }
        .ws-map-tab:hover {
            background: var(--pink-light);
        }

        .ws-tab-icon {
            width: 38px;
            height: 38px;
            border-radius: .55rem;
            background: var(--pink-light);
            color: var(--wine);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.05rem;
            flex-shrink: 0;
            transition: background .25s, color .25s;
        }

        .ws-tab-text {
            display: flex;
            flex-direction: column;
            gap: .1rem;
        }
        .ws-tab-title {
            font-size: .88rem;
            font-weight: 700;
            color: var(--gray);
            transition: color .25s;
            line-height: 1.2;
        }
        .ws-tab-sub {
            font-size: .72rem;
            color: #aaa;
            font-weight: 500;
            line-height: 1.2;
        }

        /* Tab activo */
        .ws-map-tab.active .ws-tab-icon {
            background: var(--wine);
            color: #fff;
        }
        .ws-map-tab.active .ws-tab-title {
            color: var(--wine);
        }
        .ws-map-tab.active .ws-tab-sub {
            color: var(--pink);
        }

        /* Tab seguridad activo */
        .ws-map-tab.active[data-tab="seguridad"] .ws-tab-icon {
            background: var(--blue-sec);
        }
        .ws-map-tab.active[data-tab="seguridad"] .ws-tab-title {
            color: var(--blue-sec);
        }
        .ws-map-tab.active[data-tab="seguridad"] .ws-tab-sub {
            color: var(--blue-mid);
        }

        /* Mapa */
        #ws-map {
            height: 480px;
            width: 100%;
        }
        @media (max-width: 767px) { #ws-map { height: 320px; } }

        /* Responsive tabs */
        @media (max-width: 480px) {
            .ws-map-tab {
                flex-direction: column;
                gap: .35rem;
                padding: .75rem .5rem;
                text-align: center;
            }
            .ws-tab-icon { width: 32px; height: 32px; font-size: .9rem; }
            .ws-tab-title { font-size: .78rem; }
            .ws-tab-sub { display: none; }
        }

        /* ══════════════════════════════════════
           SECCIÓN BUSCADOR + FILTROS
        ══════════════════════════════════════ */
        .section-controls {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: .75rem;
            padding: 1rem 1.25rem;
        }

        .btn-wine {
            background: var(--wine);
            border-color: var(--wine);
            color: #fff;
        }
        .btn-wine:hover, .btn-wine:focus {
            background: var(--wine-dark);
            border-color: var(--wine-dark);
            color: #fff;
        }

        /* ══════════════════════════════════════
           GRID DE CARDS
        ══════════════════════════════════════ */
        .place-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1rem;
        }
        @media (max-width: 575px) {
            .place-grid { grid-template-columns: 1fr; }
        }

        .place-card {
            cursor: pointer;
            border: 1px solid var(--border) !important;
            border-radius: .75rem !important;
            padding: 1.1rem;
            transition: border-color .2s, box-shadow .2s, transform .15s;
            background: #fff;
        }
        .place-card:hover {
            border-color: var(--wine) !important;
            box-shadow: 0 4px 18px rgba(142,58,104,.10);
            transform: translateY(-2px);
        }
        .place-card.selected {
            border-color: var(--wine) !important;
            box-shadow: 0 4px 20px rgba(142,58,104,.15);
            background: #fdf8fb;
        }
        .place-card.sec:hover {
            border-color: var(--blue-sec) !important;
            box-shadow: 0 4px 18px rgba(43,74,142,.10);
        }
        .place-card.sec.selected {
            border-color: var(--blue-sec) !important;
            box-shadow: 0 4px 20px rgba(43,74,142,.12);
            background: #f5f8fd;
        }

        /* Badge de categoría */
        .card-label {
            font-size: .68rem;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
            padding: .2rem .7rem;
            border-radius: 2rem;
        }
        .label-instancia { background: var(--pink-light); color: var(--wine); }
        .label-seguridad  { background: var(--blue-light); color: var(--blue-sec); }

        /* Badge de distancia */
        .card-dist {
            font-size: .75rem;
            font-weight: 700;
            padding: .2rem .65rem;
            border-radius: 2rem;
            background: var(--pink-light);
            color: var(--wine);
        }
        .sec .card-dist {
            background: var(--blue-light);
            color: var(--blue-sec);
        }

        /* Filas de info dentro de la card */
        .card-info-row {
            display: flex;
            align-items: flex-start;
            gap: .5rem;
            font-size: .81rem;
            color: #5a5a5a;
            margin-top: .4rem;
            line-height: 1.4;
        }
        .card-info-row .bi {
            flex-shrink: 0;
            margin-top: 2px;
            font-size: .8rem;
        }

        /* Oculta instrucciones de ruta de LRM */
        .leaflet-routing-container { display: none; }
    </style>
</head>

<body>

    <%- include('partials/navbar') %>

    <!-- ══════════════════════════════════════
         ENCABEZADO
    ══════════════════════════════════════ -->
    <header class="py-5" style="background: var(--pink-light);">
        <div class="container text-center">
            <span class="ws-section-label">Red de apoyo en Hidalgo</span>
            <h1 class="font-serif fw-medium mb-3" style="font-size: clamp(2rem,4.5vw,3rem); color: var(--dark);">
                Encuentra ayuda cerca de ti.
            </h1>
            <p class="text-muted mx-auto mb-0" style="max-width: 520px; font-size: .97rem; line-height: 1.7;">
                Localiza instancias de atención y dependencias de seguridad pública en Hidalgo.
                Activa tu ubicación para ver la más cercana y trazar la ruta automáticamente.
            </p>
        </div>
    </header>

    <main class="container py-4">

        <!-- ══════════════════════════════════════
             TARJETA MÁS CERCANA
        ══════════════════════════════════════ -->
        <div class="card shadow-sm rounded-4 mb-4 border-0" id="nearestCard">
            <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3 py-3 px-4">

                <div class="d-flex align-items-center gap-3">
                    <div class="nearest-icon">
                        <i class="bi bi-geo-alt-fill"></i>
                    </div>
                    <div>
                        <div id="nearestLabel">Más cercana a ti</div>
                        <div class="fw-bold mt-1" style="font-size:.97rem;" id="nearestName">
                            Activa tu ubicación
                        </div>
                        <div class="text-muted small mt-1" id="nearestAddress">
                            Te ubicamos y trazamos la ruta automáticamente.
                        </div>
                    </div>
                </div>

                <div class="text-end">
                    <div id="nearestKm">—</div>
                    <small class="text-muted" id="nearestEta">distancia aprox.</small>
                </div>

                <div class="w-100 d-flex align-items-center gap-2 small text-muted border-top pt-2 mt-1">
                    <span class="status-dot" id="nearestDot"></span>
                    <span id="nearestStatusText">Ubicación no activada</span>
                </div>

            </div>
        </div>

        <!-- ══════════════════════════════════════
             BLOQUE MAPA: tabs arriba + mapa + tabs abajo
        ══════════════════════════════════════ -->
        <div class="map-wrapper mb-4">

            <!-- Tabs arriba -->
            <div class="ws-map-tabs" id="tabsTop">
                <button class="ws-map-tab active" data-tab="instancias" type="button">
                    <span class="ws-tab-icon">
                        <i class="bi bi-people-fill"></i>
                    </span>
                    <span class="ws-tab-text">
                        <span class="ws-tab-title">Instancias de Atención</span>
                        <span class="ws-tab-sub">Centros de apoyo y justicia</span>
                    </span>
                </button>
                <div class="ws-tab-divider"></div>
                <button class="ws-map-tab" data-tab="seguridad" type="button">
                    <span class="ws-tab-icon">
                        <i class="bi bi-shield-fill"></i>
                    </span>
                    <span class="ws-tab-text">
                        <span class="ws-tab-title">Seguridad Pública</span>
                        <span class="ws-tab-sub">Dependencias de Hidalgo</span>
                    </span>
                </button>
            </div>

            <!-- Mapa único compartido -->
            <div id="ws-map"></div>

            <!-- Tabs abajo (misma estructura, sincronizados por JS) -->
            <div class="ws-map-tabs ws-map-tabs--bottom" id="tabsBottom">
                <button class="ws-map-tab active" data-tab="instancias" type="button">
                    <span class="ws-tab-icon">
                        <i class="bi bi-people-fill"></i>
                    </span>
                    <span class="ws-tab-text">
                        <span class="ws-tab-title">Instancias de Atención</span>
                        <span class="ws-tab-sub">Centros de apoyo y justicia</span>
                    </span>
                </button>
                <div class="ws-tab-divider"></div>
                <button class="ws-map-tab" data-tab="seguridad" type="button">
                    <span class="ws-tab-icon">
                        <i class="bi bi-shield-fill"></i>
                    </span>
                    <span class="ws-tab-text">
                        <span class="ws-tab-title">Seguridad Pública</span>
                        <span class="ws-tab-sub">Dependencias de Hidalgo</span>
                    </span>
                </button>
            </div>

        </div>

        <!-- Aviso de privacidad -->
        <div class="d-flex align-items-start gap-2 rounded-3 p-3 mb-4 small"
             style="background: var(--pink-light); color: var(--wine);">
            <i class="bi bi-shield-lock-fill mt-1 flex-shrink-0"></i>
            <span>
                Tu ubicación se usa solo en este navegador para calcular la ruta.
                No se guarda ni se envía a ningún servidor.
            </span>
        </div>

        <!-- ══════════════════════════════════════
             BUSCADOR + FILTROS
        ══════════════════════════════════════ -->
        <div class="section-controls d-flex flex-wrap gap-2 align-items-center mb-4">
            <div class="input-group flex-grow-1" style="max-width: 340px;">
                <span class="input-group-text bg-white border-end-0 text-muted">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" id="mapSearch" class="form-control border-start-0"
                       placeholder="Buscar municipio o nombre...">
            </div>
            <div class="d-flex gap-2 flex-wrap" id="filterGroup">
                <button class="btn btn-wine btn-sm rounded-pill" data-filter="todos">Todos</button>
                <button class="btn btn-outline-secondary btn-sm rounded-pill" data-filter="municipal">Municipales</button>
                <button class="btn btn-outline-secondary btn-sm rounded-pill" data-filter="estatal">Estatales</button>
            </div>
        </div>

        <!-- ══════════════════════════════════════
             LISTADO DE LUGARES
        ══════════════════════════════════════ -->
        <div class="place-grid" id="placeList"></div>

    </main>

    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
    <script src="https://cdn.jsdelivr.net/npm/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.js"></script>

    <script>
    // ════════════════════════════════════════════════════════
    // DATOS
    // AVISO: coordenadas, teléfonos y horarios son de ejemplo.
    // Verifica en fuentes oficiales antes de publicar.
    // ════════════════════════════════════════════════════════

    const PLACES = [
        {
            name: "Instancia Municipal de las Mujeres",
            category: "Municipal", tag: "municipal", municipio: "Tlahuelipan",
            address: "Plaza Principal S/N, Col. Centro, Tlahuelipan, Hgo.",
            phone: "—", hours: "Lun–Vie 9:00–17:00",
            lat: 20.1339, lng: -99.0995
        },
        {
            name: "Instancia Municipal de la Mujer",
            category: "Municipal", tag: "municipal", municipio: "Mixquiahuala",
            address: "Palacio Municipal, Mixquiahuala de Juárez, Hgo.",
            phone: "—", hours: "Lun–Vie 9:00–17:00",
            lat: 20.2278, lng: -99.2153
        },
        {
            name: "Instancia Municipal de las Mujeres",
            category: "Municipal", tag: "municipal", municipio: "Tula de Allende",
            address: "Presidencia Municipal, Tula de Allende, Hgo.",
            phone: "—", hours: "Lun–Vie 9:00–17:00",
            lat: 20.0553, lng: -99.3428
        },
        {
            name: "Fiscalía Especializada en Delitos de Violencia contra las Mujeres",
            category: "Estatal", tag: "estatal", municipio: "Pachuca de Soto",
            address: "Fiscalía General del Estado de Hidalgo, Pachuca, Hgo.",
            phone: "079", hours: "24 horas",
            lat: 20.1234, lng: -98.7346
        },
        {
            name: "Centro de Justicia para las Mujeres de Hidalgo",
            category: "Estatal", tag: "estatal", municipio: "Pachuca de Soto",
            address: "Pachuca de Soto, Hgo.",
            phone: "079", hours: "Lun–Vie 8:00–20:00",
            lat: 20.1011, lng: -98.7591
        },
        {
            name: "Instancia Municipal de las Mujeres",
            category: "Municipal", tag: "municipal", municipio: "Actopan",
            address: "Palacio Municipal, Actopan, Hgo.",
            phone: "—", hours: "Lun–Vie 9:00–17:00",
            lat: 20.2678, lng: -98.9436
        },
        {
            name: "Juzgado de lo Familiar",
            category: "Estatal", tag: "estatal", municipio: "Tulancingo de Bravo",
            address: "Tulancingo de Bravo, Hgo.",
            phone: "—", hours: "Lun–Vie 9:00–14:00",
            lat: 20.0842, lng: -98.3667
        },
        {
            name: "Instancia Municipal de las Mujeres",
            category: "Municipal", tag: "municipal", municipio: "Ixmiquilpan",
            address: "Palacio Municipal, Ixmiquilpan, Hgo.",
            phone: "—", hours: "Lun–Vie 9:00–17:00",
            lat: 20.4842, lng: -99.2178
        }
    ];

    const SECURITY = [
        {
            name: "Secretaría de Seguridad Pública de Hidalgo",
            category: "Estatal", tag: "estatal", municipio: "Pachuca de Soto",
            address: "Blvd. Felipe Ángeles S/N, Pachuca de Soto, Hgo.",
            phone: "800 009 3400", hours: "24 horas",
            lat: 20.1120, lng: -98.7650
        },
        {
            name: "Policía Municipal de Pachuca",
            category: "Municipal", tag: "municipal", municipio: "Pachuca de Soto",
            address: "H. Ayuntamiento de Pachuca, Hgo.",
            phone: "771 714 0101", hours: "24 horas",
            lat: 20.1174, lng: -98.7324
        },
        {
            name: "Centro C4 Hidalgo",
            category: "Estatal", tag: "estatal", municipio: "Pachuca de Soto",
            address: "Pachuca de Soto, Hgo.",
            phone: "911", hours: "24 horas",
            lat: 20.1060, lng: -98.7480
        },
        {
