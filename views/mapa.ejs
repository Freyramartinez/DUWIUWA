<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Puntos de Atención y Mapa - Women Safety</title>

  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <!-- MapLibre GL CSS -->
  <link href="https://unpkg.com/maplibre-gl@3.6.2/dist/maplibre-gl.css" rel="stylesheet" />

  <style>
    :root {
      --brand-primary: #831843;
      --brand-dark: #4c1d95;
      --brand-light: #fdf2f8;
      --brand-accent: #db2777;
    }

    body {
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      background-color: #fafafa;
      color: #1f2937;
    }

    .bg-brand-light { background-color: var(--brand-light); }
    .text-brand { color: var(--brand-primary); }

    /* Botón Principal */
    .btn-brand {
      background-color: var(--brand-primary);
      color: white;
      border-radius: 50px;
      font-weight: 500;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .btn-brand:hover {
      background-color: #6b1236;
      color: white;
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(131, 24, 67, 0.25);
    }

    /* Contenedor Mapa */
    #map {
      height: 560px;
      width: 100%;
      border-radius: 16px;
    }

    /* IHC: Tarjetas Interactivas */
    .card-location {
      border: 1px solid rgba(0, 0, 0, 0.06);
      border-radius: 14px;
      background-color: #ffffff;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
    }

    .card-location:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 18px rgba(0, 0, 0, 0.07) !important;
      border-color: rgba(131, 24, 67, 0.2);
    }

    /* Estado ACTIVO visual cuando la tarjeta es seleccionada */
    .card-location.active-card {
      border: 2px solid var(--brand-primary) !important;
      background-color: #fffafc !important;
      box-shadow: 0 6px 18px rgba(131, 24, 67, 0.12) !important;
    }

    /* Chips de Categorías (UX Universal) */
    .chip-filter {
      font-size: 0.75rem;
      border-radius: 20px;
      padding: 5px 14px;
      background-color: #ffffff;
      color: #4b5563;
      border: 1px solid #e5e7eb;
      cursor: pointer;
      transition: all 0.2s ease;
      user-select: none;
      font-weight: 500;
    }
    .chip-filter:hover, .chip-filter.active {
      background-color: var(--brand-primary);
      color: white;
      border-color: var(--brand-primary);
    }

    /* Popups MapLibre GL */
    .maplibregl-popup-content {
      border-radius: 12px !important;
      padding: 12px 14px !important;
      box-shadow: 0 10px 25px rgba(0,0,0,0.15) !important;
    }
  </style>
</head>
<body>

  <!-- Header Banner -->
  <section class="py-4 text-center bg-brand-light border-bottom">
    <div class="container py-1">
      <span class="badge rounded-pill bg-white border text-brand px-3 py-1 mb-2 fw-semibold" style="font-size: 0.75rem;">RED DE APOYO EN HIDALGO</span>
      <h2 class="h3 fw-bold text-brand mb-1">Centros de Atención e Instancias</h2>
      <p class="text-muted small mx-auto mb-0" style="max-width: 600px;">
        Encuentra apoyo institucional seguro en Tlahuelipan, Mixquiahuala, Tula, Pachuca y todo el estado.
      </p>
    </div>
  </section>

  <div class="container py-4 mb-4">
    
    <!-- Alerta de Emergencia Inmediata (Llamada 1 Clic) -->
    <div class="alert alert-danger border-0 shadow-sm d-flex flex-wrap align-items-center justify-content-between p-3 mb-4 rounded-4" role="alert">
      <div class="d-flex align-items-center mb-2 mb-md-0">
        <div class="bg-white p-2 rounded-circle text-danger me-3 shadow-sm">
          <i class="bi bi-exclamation-triangle-fill fs-4"></i>
        </div>
        <div>
          <h6 class="fw-bold mb-0 text-danger">¿Requieres asistencia inmediata de emergencia?</h6>
          <p class="small mb-0 text-muted">Haz clic para realizar una llamada gratuita de ayuda activa 24/7.</p>
        </div>
      </div>
      <div class="d-flex gap-2">
        <a href="tel:911" class="btn btn-danger btn-sm rounded-pill fw-bold px-3 shadow-sm"><i class="bi bi-telephone-fill me-1"></i> Llamar 911</a>
        <a href="tel:079" class="btn btn-dark btn-sm rounded-pill fw-bold px-3 shadow-sm"><i class="bi bi-telephone me-1"></i> Línea 079</a>
      </div>
    </div>

    <!-- Layout Interactivo principal -->
    <div class="row g-4">

      <!-- Columna Izquierda: Buscador, Acción Rápida IHC y Tarjetas -->
      <div class="col-lg-5">
        
        <!-- IHC UX: Botón Prominente para "Instancia Más Cercana" -->
        <button id="btnNearest" class="btn btn-brand w-100 mb-3 py-2 d-flex align-items-center justify-content-center shadow-sm" onclick="findNearestLocation()">
          <i class="bi bi-geo-fill me-2 fs-5"></i>
          <span>Ubicar mi Instancia más Cercana</span>
        </button>

        <!-- Buscador Accesible -->
        <div class="input-group input-group-sm mb-2 shadow-sm rounded-3 overflow-hidden">
          <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
          <input type="text" id="searchInput" class="form-control border-start-0 py-2" placeholder="Buscar municipio (ej. Tlahuelipan, Mixquiahuala)..." onkeyup="filterLocations()">
        </div>

        <!-- Chips de Categoría Universales -->
        <div class="d-flex gap-1 mb-3 align-items-center flex-wrap">
          <span class="chip-filter active" onclick="applyFilter('todos', this)">Todos</span>
          <span class="chip-filter" onclick="applyFilter('Municipal', this)">Instancias Municipales</span>
          <span class="chip-filter" onclick="applyFilter('Justicia', this)">Justicia / Estatal</span>
        </div>

        <!-- Lista Scrollable con Tarjetas -->
        <div class="overflow-auto pe-1" style="max-height: 420px;" id="locationList">
          <!-- Tarjetas generadas dinámicamente -->
        </div>

      </div>

      <!-- Columna Derecha: Mapa Interactivo Sticky -->
      <div class="col-lg-7">
        <div class="card border-0 shadow-sm p-2 rounded-4 sticky-top" style="top: 20px; z-index: 1;">
          <div id="map"></div>
        </div>
      </div>

    </div>
  </div>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://unpkg.com/maplibre-gl@3.6.2/dist/maplibre-gl.js"></script>

  <script>
    let locations = <%- JSON.stringify(locations) %>;
    let map, userLocation = null;
    let markers = {};
    let activeCardId = null;

    function initMap() {
      map = new maplibregl.Map({
        container: 'map',
        style: 'https://tiles.openfreemap.org/styles/liberty',
        center: [-99.1500, 20.1200], // Centrado general en la región de Hidalgo
        zoom: 9.5
      });

      map.addControl(new maplibregl.NavigationControl(), 'top-right');

      // Intentar obtener ubicación inicial
      if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            userLocation = [pos.coords.longitude, pos.coords.latitude];
            
            new maplibregl.Marker({ color: '#2563eb' })
              .setLngLat(userLocation)
              .setPopup(new maplibregl.Popup().setHTML("<b class='small text-primary'><i class='bi bi-person-fill'></i> Tu ubicación actual</b>"))
              .addTo(map);

            calculateDistances();
          }
        );
      }

      // Marcadores del mapa
      locations.forEach(loc => {
        const popupHTML = `
          <div class="p-1" style="max-width: 210px;">
            <span class="badge bg-light text-dark border mb-1" style="font-size: 0.65rem;">${loc.category}</span>
            <h6 class="fw-bold text-brand mb-1 small">${loc.name}</h6>
            <p class="text-muted mb-1" style="font-size: 0.75rem;"><i class="bi bi-geo-alt"></i> ${loc.address}</p>
            <p class="mb-2" style="font-size: 0.75rem;"><i class="bi bi-telephone"></i> ${loc.phone}</p>
            <button class="btn btn-sm btn-brand w-100 py-1" style="font-size: 0.75rem;" onclick="drawRoute(${loc.coordinates.lng}, ${loc.coordinates.lat})">
              <i class="bi bi-sign-turn-right me-1"></i> Cómo llegar
            </button>
          </div>
        `;

        const marker = new maplibregl.Marker({ color: '#831843' })
          .setLngLat([loc.coordinates.lng, loc.coordinates.lat])
          .setPopup(new maplibregl.Popup().setHTML(popupHTML))
          .addTo(map);

        markers[loc.id] = marker;
      });
    }

    // Fórmula Haversine para cálculo de distancia en km
    function getDistance(lat1, lon1, lat2, lon2) {
      const R = 6371;
      const dLat = (lat2 - lat1) * Math.PI / 180;
      const dLon = (lon2 - lon1) * Math.PI / 180;
      const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                Math.sin(dLon/2) * Math.sin(dLon/2);
      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
      return R * c;
    }

    function calculateDistances() {
      if (!userLocation) return;
      locations.forEach(loc => {
        loc.distance = getDistance(userLocation[1], userLocation[0], loc.coordinates.lat, loc.coordinates.lng);
      });
    }

    // Encuentra visual y matemáticamente la opción más cercana (IHC)
    function findNearestLocation() {
      if (!userLocation) {
        if (navigator.geolocation) {
          navigator.geolocation.getCurrentPosition(
            (pos) => {
              userLocation = [pos.coords.longitude, pos.coords.latitude];
              findNearestLocation();
            },
            () => alert("Por favor concede permiso de ubicación para calcular la distancia.")
          );
        }
        return;
      }

      calculateDistances();
      // Ordenar lista por cercanía
      locations.sort((a, b) => a.distance - b.distance);
      
      const nearest = locations[0];
      renderCards(locations);
      focusMap(nearest.id, nearest.coordinates.lng, nearest.coordinates.lat);
      drawRoute(nearest.coordinates.lng, nearest.coordinates.lat);
    }

    // Renderizado dinámico de tarjetas
    function renderCards(items) {
      const container = document.getElementById('locationList');
      container.innerHTML = '';

      if (items.length === 0) {
        container.innerHTML = `
          <div class="text-center py-4 text-muted bg-white rounded-3 border">
            <i class="bi bi-geo-fill display-6 d-block mb-2 text-black-50"></i>
            <p class="small mb-0">No se encontraron instituciones en este municipio.</p>
          </div>
        `;
        return;
      }

      items.forEach(loc => {
        const isActive = activeCardId === loc.id ? 'active-card' : '';
        const distanceTag = loc.distance ? `<span class="badge bg-light text-dark border ms-2" style="font-size: 0.7rem;"><i class="bi bi-signpost-2 text-brand me-1"></i>${loc.distance.toFixed(1)} km</span>` : '';

        const card = document.createElement('div');
        card.className = `card card-location p-3 mb-2 shadow-sm ${isActive}`;
        card.id = `card-${loc.id}`;
        
        card.onclick = (e) => {
          if (!e.target.closest('button')) {
            focusMap(loc.id, loc.coordinates.lng, loc.coordinates.lat);
          }
        };

        card.innerHTML = `
          <div class="d-flex justify-content-between align-items-start mb-1">
            <div>
              <span class="badge bg-brand-light text-brand fw-semibold" style="font-size: 0.7rem;">${loc.category}</span>
              ${distanceTag}
            </div>
            <small class="text-muted fw-bold" style="font-size: 0.75rem;"><i class="bi bi-geo-alt text-danger me-1"></i>${loc.municipality}</small>
          </div>
          <h6 class="fw-bold mb-1 text-dark" style="font-size: 0.88rem;">${loc.name}</h6>
          <p class="small text-muted mb-1" style="font-size: 0.78rem;"><i class="bi bi-house-door me-1"></i>${loc.address}</p>
          <p class="small text-muted mb-1" style="font-size: 0.78rem;"><i class="bi bi-telephone me-1"></i>${loc.phone}</p>
          <p class="small text-muted mb-3" style="font-size: 0.72rem;"><i class="bi bi-clock me-1"></i>${loc.hours}</p>
          
          <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-secondary py-1 w-50" style="font-size: 0.75rem;" onclick="focusMap('${loc.id}', ${loc.coordinates.lng}, ${loc.coordinates.lat})">
              <i class="bi bi-pin-map me-1"></i> Ubicar
            </button>
            <button class="btn btn-sm btn-brand py-1 w-50" style="font-size: 0.75rem;" onclick="drawRoute(${loc.coordinates.lng}, ${loc.coordinates.lat})">
              <i class="bi bi-compass me-1"></i> Ruta
            </button>
          </div>
        `;
        container.appendChild(card);
      });
    }

    function focusMap(id, lng, lat) {
      activeCardId = id;
      document.querySelectorAll('.card-location').forEach(el => el.classList.remove('active-card'));
      const activeEl = document.getElementById(`card-${id}`);
      if (activeEl) activeEl.classList.add('active-card');

      map.flyTo({ center: [lng, lat], zoom: 14.5, speed: 1.2 });
      if (markers[id]) markers[id].togglePopup();
    }

    async function drawRoute(destLng, destLat) {
      if (!userLocation) {
        alert("Por favor habilita la ubicación de tu navegador para trazar la ruta.");
        return;
      }

      const url = `https://router.project-osrm.org/route/v1/driving/${userLocation[0]},${userLocation[1]};${destLng},${destLat}?overview=full&geometries=geojson`;

      try {
        const res = await fetch(url);
        const data = await res.json();
        const route = data.routes[0].geometry;

        if (map.getSource('route')) {
          map.getSource('route').setData(route);
        } else {
          map.addSource('route', { type: 'geojson', data: route });
          map.addLayer({
            id: 'route',
            type: 'line',
            source: 'route',
            layout: { 'line-join': 'round', 'line-cap': 'round' },
            paint: { 'line-color': '#831843', 'line-width': 5, 'line-opacity': 0.85 }
          });
        }

        const bounds = new maplibregl.LngLatBounds();
        bounds.extend(userLocation);
        bounds.extend([destLng, destLat]);
        map.fitBounds(bounds, { padding: 60 });

      } catch (e) {
        console.error("Error calculando la ruta:", e);
      }
    }

    function filterLocations() {
      const term = document.getElementById('searchInput').value.toLowerCase();
      const filtered = locations.filter(loc => 
        loc.name.toLowerCase().includes(term) || 
        loc.municipality.toLowerCase().includes(term)
      );
      renderCards(filtered);
    }

    function applyFilter(category, chipElement) {
      document.querySelectorAll('.chip-filter').forEach(el => el.classList.remove('active'));
      chipElement.classList.add('active');

      if (category === 'todos') {
        renderCards(locations);
      } else {
        const filtered = locations.filter(loc => loc.category.toLowerCase().includes(category.toLowerCase()));
        renderCards(filtered);
      }
    }

    window.onload = () => {
      initMap();
      renderCards(locations);
    };
  </script>
</body>
</html>