<% const u = locals.usuario || { nombre: 'Usuario' }; %>
<%- include('partials/panel-top', { titulo: 'Cambiar contraseña', nombre: u.nombre, rol: locals.rol || '', error: locals.error }) %>

<div class="row justify-content-center">
  <div class="col-md-7 col-lg-5">
    <span class="ws-section-label">Seguridad de tu cuenta</span>
    <h1 class="ws-title">Crea tu <em>contraseña</em></h1>
    <p class="ws-sub mb-4">La contraseña que recibiste es temporal. Elige una nueva que solo tú conozcas para continuar.</p>

    <div class="card"><div class="card-body p-4">
      <form method="POST" action="/cambiar-password">
        <div class="mb-3"><label class="form-label">Nueva contraseña</label><div class="input-group"><input type="password" name="password" class="form-control" minlength="8" required autocomplete="new-password"><button type="button" class="btn ws-toggle-pass" aria-label="Mostrar contraseña"><i class="bi bi-eye"></i></button></div><div class="form-text">Mínimo 8 caracteres.</div></div>
        <div class="mb-4"><label class="form-label">Confirmar contraseña</label><div class="input-group"><input type="password" name="password2" class="form-control" minlength="8" required autocomplete="new-password"><button type="button" class="btn ws-toggle-pass" aria-label="Mostrar contraseña"><i class="bi bi-eye"></i></button></div></div>
        <button class="btn btn-primary w-100">Guardar y continuar</button>
      </form>
    </div></div>
  </div>
</div>

<%- include('partials/panel-bottom') %>
</body>
</html>
