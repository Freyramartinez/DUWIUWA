<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Historial de donaciones · WOMEN SAFETY</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body{background:#fff8fb;color:#2b1d25}
    h1{color:#67294c}
    .resumen{background:#f8e8f1;border-radius:14px;padding:16px 20px}
    .resumen b{color:#67294c;font-size:1.5rem}
    thead th{background:#8e3a68;color:#fff;white-space:nowrap}
  </style>
</head>
<body>
<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h1 class="h2 m-0">Historial de donaciones</h1>
    <a href="/jefe" class="btn btn-outline-secondary btn-sm">Volver al panel</a>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-sm-6"><div class="resumen">Total recibido<br><b>$<%= total.toLocaleString('es-MX') %> MXN</b></div></div>
    <div class="col-sm-6"><div class="resumen">Donaciones registradas<br><b><%= donaciones.length %></b></div></div>
  </div>

  <input type="search" id="buscar" class="form-control mb-3" placeholder="Buscar por folio, donante, correo o método…">

  <% if (donaciones.length === 0) { %>
    <div class="alert alert-light border">Aún no hay donaciones registradas.</div>
  <% } else { %>
  <div class="table-responsive">
    <table class="table table-hover align-middle bg-white" id="tabla">
      <thead>
        <tr><th>Folio</th><th>Donante</th><th>Correo</th><th>Monto</th><th>Método</th><th>Estado</th><th>Fecha</th></tr>
      </thead>
      <tbody>
        <% donaciones.forEach(d => { %>
        <tr>
          <td><code><%= d.folio %></code></td>
          <td><%= d.donante %></td>
          <td><%= d.correo || '—' %></td>
          <td>$<%= d.monto.toLocaleString('es-MX') %><%= d.frecuencia === 'mensual' ? ' /mes' : '' %></td>
          <td><%= d.metodo %></td>
          <td><span class="badge <%= d.estado === 'completada' ? 'bg-success' : 'bg-warning text-dark' %>"><%= d.estado %></span></td>
          <td><%= new Date(d.fecha).toLocaleString('es-MX', { dateStyle: 'medium', timeStyle: 'short' }) %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>

<script>
  const q = document.getElementById('buscar');
  if (q) q.addEventListener('input', () => {
    const t = q.value.toLowerCase();
    document.querySelectorAll('#tabla tbody tr').forEach(tr => {
      tr.style.display = tr.textContent.toLowerCase().includes(t) ? '' : 'none';
    });
  });
</script>
</body>
</html>