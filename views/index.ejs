<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>WOMEN SAFETY</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
        rel="stylesheet"
    >

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Bootstrap Icons -->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <style>

        /* =========================================================
           CONFIGURACIÓN GENERAL
        ========================================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #fffdfd;
            color: #292329;
        }

        section {
            scroll-margin-top: 85px;
        }


        /* =========================================================
           PALETA
        ========================================================= */

        :root {
            --wine: #8e3a68;
            --wine-dark: #67294c;
            --pink: #b34d83;
            --pink-light: #f8e8f1;
            --cream: #fff8fb;
            --dark: #292329;
            --gray: #6f6470;
            --white: #ffffff;
            --border: #eadbe4;
        }


        /* =========================================================
           NAVBAR
        ========================================================= */

        .ws-navbar {
            position: sticky;
            top: 0;
            z-index: 2000;
            width: 100%;

            background: rgba(255, 255, 255, 0.94);

            backdrop-filter: blur(14px);

            border-bottom: 1px solid rgba(142, 58, 104, 0.12);

            transition: box-shadow 0.3s ease;
        }

        .ws-navbar:hover {
            box-shadow: 0 5px 25px rgba(80, 40, 65, 0.08);
        }

        .ws-navbar-inner {
            max-width: 1250px;
            min-height: 74px;

            margin: 0 auto;
            padding: 0 28px;

            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .ws-logo {
            text-decoration: none;
            color: var(--dark);

            font-size: 1.05rem;
            font-weight: 700;

            letter-spacing: 0.08em;
            white-space: nowrap;
        }

        .ws-logo-symbol {
            color: var(--wine);
            font-size: 1.35rem;
            margin-right: 5px;
        }

        .ws-nav-links {
            display: flex;
            align-items: center;
            gap: 28px;
        }

        .ws-nav-links a {
            position: relative;

            text-decoration: none;
            color: #3d363d;

            font-size: 0.86rem;
            font-weight: 500;

            padding: 8px 0;

            transition: color 0.25s ease;
        }

        .ws-nav-links a::after {
            content: "";

            position: absolute;

            left: 0;
            bottom: 1px;

            width: 0;
            height: 2px;

            background: var(--wine);

            transition: width 0.25s ease;
        }

        .ws-nav-links a:hover {
            color: var(--wine);
        }

        .ws-nav-links a:hover::after {
            width: 100%;
        }

        .ws-menu-button {
            display: none;

            border: none;
            background: transparent;

            font-size: 1.7rem;
            color: var(--dark);

            cursor: pointer;
        }


        /* =========================================================
           HERO
        ========================================================= */

        .ws-hero {
            min-height: 650px;

            display: flex;
            align-items: center;

            position: relative;
            overflow: hidden;

            background:
                radial-gradient(
                    circle at 80% 20%,
                    rgba(179, 77, 131, 0.16),
                    transparent 30%
                ),
                linear-gradient(
                    135deg,
                    #fff8fb 0%,
                    #ffffff 55%,
                    #f8e8f1 100%
                );
        }

        .ws-hero-inner {
            max-width: 1250px;
            width: 100%;

            margin: 0 auto;

            padding: 100px 28px;

            display: grid;

            grid-template-columns: 1.1fr 0.9fr;

            gap: 70px;

            align-items: center;
        }

        .ws-label {
            display: inline-block;

            margin-bottom: 20px;

            color: var(--wine);

            font-size: 0.75rem;
            font-weight: 700;

            letter-spacing: 0.18em;
        }

        .ws-hero h1 {
            max-width: 720px;

            font-family: 'Playfair Display', serif;

            font-size: clamp(3.2rem, 7vw, 6rem);

            line-height: 0.98;

            color: var(--dark);

            margin-bottom: 28px;
        }

        .ws-hero h1 span {
            color: var(--wine);
        }

        .ws-hero p {
            max-width: 600px;

            color: var(--gray);

            font-size: 1.05rem;

            line-height: 1.8;

            margin-bottom: 32px;
        }

        .ws-primary-button {
            display: inline-flex;

            align-items: center;

            gap: 10px;

            padding: 14px 25px;

            border-radius: 30px;

            background: var(--wine);

            color: white;

            text-decoration: none;

            font-size: 0.9rem;

            font-weight: 600;

            transition: all 0.3s ease;
        }

        .ws-primary-button:hover {
            background: var(--wine-dark);

            color: white;

            transform: translateY(-3px);

            box-shadow:
                0 10px 25px
                rgba(142, 58, 104, 0.22);
        }

        .ws-hero-card {
            min-height: 420px;

            border-radius: 35px;

            background:
                radial-gradient(
                    circle at 30% 20%,
                    rgba(255,255,255,0.8),
                    transparent 25%
                ),
                linear-gradient(
                    145deg,
                    #f4d9e7,
                    #8e3a68
                );

            display: flex;

            align-items: center;
            justify-content: center;

            box-shadow:
                0 25px 60px
                rgba(100, 40, 75, 0.15);

            position: relative;

            overflow: hidden;
        }

        .ws-hero-card::before {
            content: "♀";

            position: absolute;

            font-size: 19rem;
            font-weight: 300;

            color: rgba(255,255,255,0.16);
        }

        .ws-hero-card-content {
            position: relative;
            z-index: 2;

            text-align: center;

            color: white;

            padding: 40px;
        }

        .ws-hero-card-content i {
            font-size: 4rem;
        }

        .ws-hero-card-content h3 {
            margin-top: 20px;

            font-family: 'Playfair Display', serif;

            font-size: 2rem;
        }
                /* =====================================================
        ¿QUIÉNES SOMOS? — NUEVO DISEÑO
        ===================================================== */

        .ws-about {
        overflow: hidden;
        }


        /* =====================================================
        INTRO
        ===================================================== */

        .ws-about-intro {
        padding: 95px 0 90px;
        text-align: center;

        background:
            radial-gradient(
            circle at 15% 20%,
            rgba(179, 77, 131, 0.10),
            transparent 28%
            ),
            var(--cream);
        }

        .ws-about-label,
        .ws-small-label {
        display: inline-block;

        color: var(--wine);

        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.2em;

        text-transform: uppercase;
        }

        .ws-about-intro h2 {
        max-width: 780px;

        margin: 18px auto 22px;

        color: var(--dark);

        font-family: "Playfair Display", serif;

        font-size: clamp(2.4rem, 4vw, 3.7rem);

        font-weight: 500;

        line-height: 1.08;
        }

        .ws-about-intro h2 span {
        color: var(--wine);
        }

        .ws-about-intro p {
        max-width: 700px;

        margin: auto;

        color: var(--gray);

        font-size: 0.95rem;

        line-height: 1.85;
        }


        /* =====================================================
        RAZÓN DE SER
        ===================================================== */

        .ws-about-reason {
        padding: 90px 0;

        background: var(--white);
        }

        .ws-reason-grid {
        display: grid;

        grid-template-columns: 1fr 0.8fr;

        gap: 80px;

        align-items: center;

        max-width: 1050px;

        margin: auto;
        }

        .ws-reason-text {
        max-width: 600px;
        }

        .ws-small-label {
        margin-bottom: 16px;
        }

        .ws-reason-text h3 {
        margin: 0 0 22px;

        color: var(--dark);

        font-family: "Playfair Display", serif;

        font-size: clamp(2rem, 3.5vw, 3rem);

        font-weight: 500;

        line-height: 1.15;
        }

        .ws-reason-text p {
        margin-bottom: 16px;

        color: var(--gray);

        font-size: 0.9rem;

        line-height: 1.85;
        }

        .ws-about-quote {
        display: flex;

        align-items: center;

        gap: 12px;

        width: fit-content;

        margin-top: 25px;

        padding: 13px 18px;

        border-left: 3px solid var(--wine);

        background: var(--pink-light);

        color: var(--wine-dark);

        font-size: 0.85rem;

        font-weight: 700;
        }

        .ws-about-quote i {
        font-size: 1.2rem;
        }


        /* =====================================================
        ELEMENTO VISUAL
        ===================================================== */

        .ws-reason-visual {
        position: relative;

        width: 350px;
        height: 350px;

        margin: auto;

        display: flex;

        align-items: center;
        justify-content: center;
        }

        .ws-heart-circle {
        position: relative;
        z-index: 3;

        width: 145px;
        height: 145px;

        display: flex;

        align-items: center;
        justify-content: center;

        border-radius: 50%;

        color: var(--white);

        background:
            linear-gradient(
            145deg,
            var(--wine-dark),
            var(--wine)
            );

        box-shadow:
            0 20px 45px rgba(103, 41, 76, 0.25);

        font-size: 3rem;

        transition: transform 0.4s ease;
        }

        .ws-reason-visual:hover .ws-heart-circle {
        transform: scale(1.08) rotate(-4deg);
        }

        .ws-orbit {
        position: absolute;

        border: 1px solid rgba(142, 58, 104, 0.22);

        border-radius: 50%;
        }

        .orbit-one {
        width: 230px;
        height: 230px;
        }

        .orbit-two {
        width: 330px;
        height: 330px;

        border-color: rgba(179, 77, 131, 0.14);
        }

        .ws-floating-dot {
        position: absolute;

        width: 13px;
        height: 13px;

        border-radius: 50%;

        background: var(--pink);

        box-shadow:
            0 0 0 7px rgba(179, 77, 131, 0.10);
        }

        .dot-one {
        top: 35px;
        right: 55px;
        }

        .dot-two {
        bottom: 45px;
        left: 45px;

        width: 9px;
        height: 9px;
        }

        .dot-three {
        top: 105px;
        left: 15px;

        width: 7px;
        height: 7px;
        }


        /* =====================================================
        ESTADÍSTICAS
        ===================================================== */

        .ws-about-stats {
        padding: 90px 0 100px;

        background:
            linear-gradient(
            135deg,
            var(--pink-light),
            #fff8fb
            );
        }

        .ws-stats-heading {
        display: flex;

        justify-content: space-between;

        align-items: flex-end;

        gap: 40px;

        max-width: 1050px;

        margin: 0 auto 45px;
        }

        .ws-stats-heading h3 {
        max-width: 600px;

        margin: 12px 0 0;

        color: var(--dark);

        font-family: "Playfair Display", serif;

        font-size: clamp(2rem, 3.5vw, 3rem);

        font-weight: 500;

        line-height: 1.1;
        }

        .ws-stats-heading h3 span {
        color: var(--wine);
        }

        .ws-stats-heading > p {
        max-width: 290px;

        margin: 0;

        color: var(--gray);

        font-size: 0.8rem;

        line-height: 1.7;
        }


        /* =====================================================
        TARJETAS DE DATOS
        ===================================================== */

        .ws-stat-grid {
        display: grid;

        grid-template-columns: repeat(3, 1fr);

        gap: 22px;

        max-width: 1050px;

        margin: auto;
        }

        .ws-stat-card {
        position: relative;

        min-height: 330px;

        padding: 30px;

        border: 1px solid var(--border);

        border-radius: 22px;

        background: var(--white);

        box-shadow:
            0 8px 25px rgba(103, 41, 76, 0.04);

        transition:
            transform 0.35s ease,
            box-shadow 0.35s ease,
            background 0.35s ease;
        }

        .ws-stat-card:hover {
        transform: translateY(-8px);

        background: var(--wine);

        box-shadow:
            0 20px 45px rgba(103, 41, 76, 0.18);
        }

        .ws-stat-top {
        display: flex;

        justify-content: space-between;

        align-items: center;

        margin-bottom: 40px;

        color: var(--gray);

        font-size: 0.7rem;

        font-weight: 800;
        }

        .ws-stat-top i {
        width: 40px;
        height: 40px;

        display: flex;

        align-items: center;
        justify-content: center;

        border-radius: 12px;

        color: var(--wine);

        background: var(--pink-light);

        font-size: 1rem;

        transition:
            color 0.35s ease,
            background 0.35s ease;
        }

        .ws-stat-card:hover .ws-stat-top {
        color: rgba(255,255,255,0.55);
        }

        .ws-stat-card:hover .ws-stat-top i {
        color: var(--wine);

        background: var(--white);
        }

        .ws-stat-card strong {
        display: block;

        margin-bottom: 12px;

        color: var(--wine);

        font-size: 3.4rem;

        font-weight: 800;

        letter-spacing: -0.05em;

        line-height: 1;

        transition: color 0.35s ease;
        }

        .ws-stat-card:hover strong {
        color: var(--white);
        }

        .ws-stat-card h4 {
        margin-bottom: 12px;

        color: var(--dark);

        font-size: 0.95rem;

        font-weight: 800;

        line-height: 1.35;

        transition: color 0.35s ease;
        }

        .ws-stat-card p {
        margin: 0;

        color: var(--gray);

        font-size: 0.78rem;

        line-height: 1.7;

        transition: color 0.35s ease;
        }

        .ws-stat-card:hover h4 {
        color: var(--white);
        }

        .ws-stat-card:hover p {
        color: rgba(255,255,255,0.75);
        }


        /* Fuente */

        .ws-stat-source {
        display: flex;

        justify-content: center;

        align-items: center;

        gap: 8px;

        margin-top: 30px;

        color: var(--gray);

        font-size: 0.68rem;
        }

        .ws-stat-source i {
        color: var(--wine);
        }


        /* =====================================================
        NUESTRO ENFOQUE
        ===================================================== */

        .ws-about-focus {
        padding: 100px 0;

        background: var(--white);
        }

        .ws-focus-title {
        max-width: 700px;

        margin: 0 auto 50px;

        text-align: center;
        }

        .ws-focus-title h3 {
        margin: 14px 0 16px;

        color: var(--dark);

        font-family: "Playfair Display", serif;

        font-size: clamp(2.1rem, 4vw, 3.2rem);

        font-weight: 500;

        line-height: 1.1;
        }

        .ws-focus-title h3 span {
        color: var(--wine);
        }

        .ws-focus-title p {
        max-width: 600px;

        margin: auto;

        color: var(--gray);

        font-size: 0.85rem;

        line-height: 1.8;
        }


        /* =====================================================
        ENFOQUE — TARJETAS
        ===================================================== */

        .ws-focus-grid {
        display: grid;

        grid-template-columns: repeat(3, 1fr);

        gap: 22px;

        max-width: 1050px;

        margin: auto;
        }

        .ws-focus-card {
        position: relative;

        min-height: 300px;

        padding: 32px;

        border-radius: 22px;

        background: var(--cream);

        border: 1px solid var(--border);

        transition:
            transform 0.35s ease,
            background 0.35s ease,
            box-shadow 0.35s ease;
        }

        .ws-focus-card:hover {
        transform: translateY(-8px);

        background: var(--wine-dark);

        box-shadow:
            0 20px 45px rgba(103, 41, 76, 0.18);
        }

        .ws-focus-number {
        position: absolute;

        top: 28px;
        right: 28px;

        color: #d9c7d2;

        font-size: 0.7rem;

        font-weight: 800;

        transition: color 0.35s ease;
        }

        .ws-focus-card:hover .ws-focus-number {
        color: rgba(255,255,255,0.35);
        }

        .ws-focus-icon {
        width: 55px;
        height: 55px;

        display: flex;

        align-items: center;
        justify-content: center;

        margin-bottom: 45px;

        border-radius: 15px;

        color: var(--wine);

        background: var(--pink-light);

        font-size: 1.25rem;

        transition:
            background 0.35s ease,
            color 0.35s ease;
        }

        .ws-focus-card:hover .ws-focus-icon {
        color: var(--wine);

        background: var(--white);
        }

        .ws-focus-card h4 {
        margin-bottom: 12px;

        color: var(--dark);

        font-size: 1.05rem;

        font-weight: 800;

        transition: color 0.35s ease;
        }

        .ws-focus-card p {
        margin: 0;

        color: var(--gray);

        font-size: 0.8rem;

        line-height: 1.75;

        transition: color 0.35s ease;
        }

        .ws-focus-card:hover h4 {
        color: var(--white);
        }

        .ws-focus-card:hover p {
        color: rgba(255,255,255,0.75);
        }

        .ws-focus-line {
        position: absolute;

        left: 32px;
        bottom: 28px;

        width: 35px;
        height: 2px;

        background: var(--pink);

        transition:
            width 0.35s ease,
            background 0.35s ease;
        }

        .ws-focus-card:hover .ws-focus-line {
        width: 70px;

        background: var(--white);
        }


        /* =====================================================
        RESPONSIVE
        ===================================================== */

        @media (max-width: 900px) {

        .ws-reason-grid {
            grid-template-columns: 1fr;

            gap: 50px;
        }

        .ws-reason-text {
            max-width: 700px;
        }

        .ws-reason-visual {
            width: 300px;
            height: 300px;
        }

        .ws-stats-heading {
            flex-direction: column;

            align-items: flex-start;
        }

        .ws-stat-grid,
        .ws-focus-grid {
            grid-template-columns: 1fr;
        }

        .ws-stat-card {
            min-height: 280px;
        }
        }


        @media (max-width: 600px) {

        .ws-about-intro {
            padding: 70px 0;
        }

        .ws-about-intro h2 {
            font-size: 2.35rem;
        }

        .ws-about-reason,
        .ws-about-stats,
        .ws-about-focus {
            padding: 70px 0;
        }

        .ws-reason-visual {
            width: 260px;
            height: 260px;
        }

        .ws-heart-circle {
            width: 115px;
            height: 115px;

            font-size: 2.4rem;
        }

        .orbit-one {
            width: 190px;
            height: 190px;
        }

        .orbit-two {
            width: 255px;
            height: 255px;
        }

        .ws-stat-card {
            min-height: 300px;
        }

        .ws-stat-card strong {
            font-size: 3rem;
        }
        }
            /* =========================================================
   LA PULSERAn
   ========================================================= */

.ws-bracelet {
    padding: 110px 0;
    background:
        radial-gradient(
            circle at 15% 50%,
            rgba(179, 77, 131, 0.12),
            transparent 30%
        ),
        #fffdfd;
}

.ws-bracelet-inner {
    max-width: 1150px;
    margin: 0 auto;
    padding: 0 28px;

    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 80px;

    align-items: center;
}

.ws-bracelet-visual {
    min-height: 390px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 35px;

    background:
        radial-gradient(
            circle at 50% 35%,
            rgba(255,255,255,0.75),
            transparent 30%
        ),
        linear-gradient(
            145deg,
            #f4d9e7,
            #ead0df
        );

    box-shadow:
        0 25px 60px rgba(103, 41, 76, 0.10);

    position: relative;
    overflow: hidden;
}

.ws-bracelet-visual::before,
.ws-bracelet-visual::after {
    content: "";
    position: absolute;

    border: 1px solid rgba(142, 58, 104, 0.16);
    border-radius: 50%;
}

.ws-bracelet-visual::before {
    width: 280px;
    height: 280px;
}

.ws-bracelet-visual::after {
    width: 390px;
    height: 390px;
}

.ws-bracelet-icon {
    position: relative;
    z-index: 2;

    width: 155px;
    height: 155px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background:
        linear-gradient(
            145deg,
            var(--wine-dark),
            var(--wine)
        );

    color: white;

    font-size: 4.2rem;

    box-shadow:
        0 20px 45px rgba(103, 41, 76, 0.25);

    transition: transform 0.4s ease;
}

.ws-bracelet-visual:hover .ws-bracelet-icon {
    transform: scale(1.08) rotate(-4deg);
}

.ws-bracelet-text {
    max-width: 600px;
}

.ws-section-label {
    display: inline-block;

    margin-bottom: 18px;

    color: var(--wine);

    font-size: 0.72rem;
    font-weight: 800;

    letter-spacing: 0.18em;

    text-transform: uppercase;
}

.ws-bracelet-text h2 {
    margin: 0 0 24px;

    color: var(--dark);

    font-family: "Playfair Display", serif;

    font-size: clamp(2.3rem, 4vw, 4rem);

    font-weight: 500;

    line-height: 1.08;
}

.ws-bracelet-text p {
    max-width: 560px;

    margin: 0;

    color: var(--gray);

    font-size: 0.95rem;

    line-height: 1.9;
}


/* =========================================================
   FUNCIONALIDADES
   ========================================================= */

.ws-features {
    padding: 105px 28px;

    background:
        linear-gradient(
            135deg,
            #f8e8f1,
            #fff8fb
        );
}

.ws-features-header {
    max-width: 720px;

    margin: 0 auto 55px;

    text-align: center;
}

.ws-features-header h2 {
    margin: 10px 0 18px;

    color: var(--dark);

    font-family: "Playfair Display", serif;

    font-size: clamp(2.3rem, 4vw, 3.5rem);

    font-weight: 500;

