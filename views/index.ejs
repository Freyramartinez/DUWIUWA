         FOOTER
    ========================================================= -->
    <footer class="ws-footer">
        <p class="mb-0">
            © 2026 WOMEN SAFETY · Tecnología para la seguridad y el bienestar de las mujeres.
        </p>
    </footer>


    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Menú móvil -->
    <script>
        const wsNav = document.getElementById("wsNav");
        const wsMenuButton = document.querySelector(".ws-menu-button");

        function toggleMenu() {
            const open = wsNav.classList.toggle("active");
            wsMenuButton.setAttribute("aria-expanded", open);
        }

        // Cerrar el menú al elegir una sección
        wsNav.querySelectorAll("a").forEach(link => {
            link.addEventListener("click", () => {
                wsNav.classList.remove("active");
                wsMenuButton.setAttribute("aria-expanded", "false");
            });
        });
    </script>

