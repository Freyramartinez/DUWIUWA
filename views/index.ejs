                </div>


                <h3>
                    Botón de emergencia
                </h3>


                <p>

                    Permite generar una alerta cuando
                    la usuaria necesita solicitar apoyo.

                </p>

            </div>



            <!-- FUNCIONALIDAD 2 -->

            <div class="ws-feature-card">

                <div class="ws-feature-icon">

                    <i class="bi bi-geo-alt"></i>

                </div>


                <h3>
                    Ubicación
                </h3>


                <p>

                    La tecnología puede integrarse con
                    información de ubicación para facilitar
                    la atención de una emergencia.

                </p>

            </div>



            <!-- FUNCIONALIDAD 3 -->

            <div class="ws-feature-card">

                <div class="ws-feature-icon">

                    <i class="bi bi-broadcast-pin"></i>

                </div>


                <h3>
                    Comunicación
                </h3>


                <p>

                    Diseñada para conectar las alertas
                    con una red de apoyo y monitoreo.

                </p>

            </div>


        </div>

    </section>



    <!-- =========================================================
         SLIDER DE ANDREA
    ========================================================= -->

    <section
        id="slider"
        class="ws-slider-section"
    >

        <%- include('partials/slider') %>

    </section>



    <!-- =========================================================
         SERVICIOS / CATÁLOGO
    ========================================================= -->

    <section
        id="servicios"
        class="ws-services"
    >

        <div class="ws-services-header">

            <span class="ws-section-label">
                NUESTROS SERVICIOS
            </span>


            <h2>

                Soluciones para
                una red más segura.

            </h2>


            <p>

                Conoce las soluciones tecnológicas y servicios
                desarrollados por WOMEN SAFETY.

            </p>

        </div>



        <div class="ws-services-grid">

            <div class="row g-4">

                <% products.forEach(product => { %>


                    <div class="col-md-6 col-lg-4">

                        <article class="ws-service-card">


                            <img
                                src="<%= product.image %>"
                                alt="<%= product.name %>"
                            >


                            <div class="ws-service-body">


                                <span class="ws-service-category">

                                    <%= product.category %>

                                </span>


                                <h3>

                                    <%= product.name %>

                                </h3>


                                <p>

                                    <%= product.description %>

                                </p>



                                <% if (product.specs && product.specs.length > 0) { %>


                                    <ul>

                                        <% product.specs.forEach(spec => { %>

                                            <li>

                                                <%= spec %>

                                            </li>

                                        <% }) %>

                                    </ul>


                                <% } %>


                            </div>

                        </article>

                    </div>


                <% }) %>

            </div>

        </div>

    </section>



    <!-- =========================================================
         UBICACIÓN
    ========================================================= -->

    <section
        id="ubicacion"
        class="ws-location"
    >

        <div class="ws-location-inner">


            <div>

                <span class="ws-section-label">
                    RED DE APOYO
                </span>


                <h2>

                    Encuentra apoyo
                    cerca de ti.

                </h2>


                <p>

                    Consulta nuestro mapa para encontrar
                    centros de atención, instituciones y
                    espacios de apoyo para mujeres.

                </p>


                <a
                    href="/mapa"
                    class="ws-primary-button"
                >

                    Ver ubicación

                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>



            <div class="ws-location-box">

                <div>

                    <i class="bi bi-geo-alt"></i>


                    <h4>
                        Centros de atención
                    </h4>


                    <p>
                        Red de apoyo en Hidalgo
                    </p>

                </div>

            </div>

        </div>

    </section>



    <!-- =========================================================
         CONTACTO
    ========================================================= -->

    <section
        id="contacto"
        class="ws-contact"
    >

        <div class="ws-contact-inner">


            <span
                class="ws-section-label"
                style="color: #f2c5db;"
            >
                WOMEN SAFETY
            </span>


            <h2>

                La tecnología también
                puede acompañarnos.

            </h2>


            <p>

                Conoce más sobre nuestro proyecto,
                nuestras soluciones y la red de apoyo
                que estamos construyendo.

            </p>


            <a
                href="/quienes-somos"
                class="ws-contact-button"
            >

                Conocer el proyecto

                <i class="bi bi-arrow-right"></i>

            </a>

        </div>

    </section>



    <!-- =========================================================
         FOOTER
    ========================================================= -->

    <footer class="ws-footer">

        <p class="mb-0">

            © 2026 WOMEN SAFETY ·
            Tecnología para la seguridad y el bienestar de las mujeres.

        </p>

    </footer>



    <!-- =========================================================
         BOOTSTRAP JAVASCRIPT
    ========================================================= -->

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>



    <!-- =========================================================
         MENÚ MÓVIL
    ========================================================= -->

    <script>

        function toggleMenu() {

            const menu =
                document.getElementById("wsNav");

            menu.classList.toggle("active");

        }


        // Cerrar el menú cuando se selecciona una sección

        document
            .querySelectorAll(".ws-nav-links a")
            .forEach(link => {

                link.addEventListener("click", () => {

                    document
                        .getElementById("wsNav")
                        .classList.remove("active");

                });

            });

    </script>

</body>

</html>