<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>WOMEN SAFETY</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
        rel="stylesheet"
    >

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Bootstrap Icons -->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <style>

        /* =========================================================
           CONFIGURACIÓN GENERAL
        ========================================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #fffdfd;
            color: #292329;
        }

        section {
            scroll-margin-top: 85px;
        }


        /* =========================================================
           PALETA
        ========================================================= */

        :root {
            --wine: #8e3a68;
            --wine-dark: #67294c;
            --pink: #b34d83;
            --pink-light: #f8e8f1;
            --cream: #fff8fb;
            --dark: #292329;
            --gray: #6f6470;
            --white: #ffffff;
            --border: #eadbe4;
        }


        /* =========================================================
           NAVBAR
        ========================================================= */

        .ws-navbar {
            position: sticky;
            top: 0;
            z-index: 2000;
            width: 100%;

            background: rgba(255, 255, 255, 0.94);

            backdrop-filter: blur(14px);

            border-bottom: 1px solid rgba(142, 58, 104, 0.12);

            transition: box-shadow 0.3s ease;
        }

        .ws-navbar:hover {
            box-shadow: 0 5px 25px rgba(80, 40, 65, 0.08);
        }

        .ws-navbar-inner {
            max-width: 1250px;
            min-height: 74px;

            margin: 0 auto;
            padding: 0 28px;

            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .ws-logo {
            text-decoration: none;
            color: var(--dark);

            font-size: 1.05rem;
            font-weight: 700;

            letter-spacing: 0.08em;
            white-space: nowrap;
        }

        .ws-logo-symbol {
            color: var(--wine);
            font-size: 1.35rem;
            margin-right: 5px;
        }

        .ws-nav-links {
            display: flex;
            align-items: center;
            gap: 28px;
        }

        .ws-nav-links a {
            position: relative;

            text-decoration: none;
            color: #3d363d;

            font-size: 0.86rem;
            font-weight: 500;

            padding: 8px 0;

            transition: color 0.25s ease;
        }

        .ws-nav-links a::after {
            content: "";

            position: absolute;

            left: 0;
            bottom: 1px;

            width: 0;
            height: 2px;

            background: var(--wine);

            transition: width 0.25s ease;
        }

        .ws-nav-links a:hover {
            color: var(--wine);
        }

        .ws-nav-links a:hover::after {
            width: 100%;
        }

        .ws-menu-button {
            display: none;

            border: none;
            background: transparent;

            font-size: 1.7rem;
            color: var(--dark);

            cursor: pointer;
        }


        /* =========================================================
           HERO
        ========================================================= */

        .ws-hero {
            min-height: 650px;

            display: flex;
            align-items: center;

            position: relative;
            overflow: hidden;

            background:
                radial-gradient(
                    circle at 80% 20%,
                    rgba(179, 77, 131, 0.16),
                    transparent 30%
                ),
                linear-gradient(
                    135deg,
                    #fff8fb 0%,
                    #ffffff 55%,
                    #f8e8f1 100%
                );
        }

        .ws-hero-inner {
            max-width: 1250px;
            width: 100%;

            margin: 0 auto;

            padding: 100px 28px;

            display: grid;

            grid-template-columns: 1.1fr 0.9fr;

            gap: 70px;

            align-items: center;
        }

        .ws-label {
            display: inline-block;

            margin-bottom: 20px;

            color: var(--wine);

            font-size: 0.75rem;
            font-weight: 700;

            letter-spacing: 0.18em;
        }

        .ws-hero h1 {
            max-width: 720px;

            font-family: 'Playfair Display', serif;

            font-size: clamp(3.2rem, 7vw, 6rem);

            line-height: 0.98;

            color: var(--dark);

            margin-bottom: 28px;
        }

        .ws-hero h1 span {
            color: var(--wine);
        }

        .ws-hero p {
            max-width: 600px;

            color: var(--gray);

            font-size: 1.05rem;

            line-height: 1.8;

            margin-bottom: 32px;
        }

        .ws-primary-button {
            display: inline-flex;

            align-items: center;

            gap: 10px;

            padding: 14px 25px;

            border-radius: 30px;

            background: var(--wine);

            color: white;

            text-decoration: none;

            font-size: 0.9rem;

            font-weight: 600;

            transition: all 0.3s ease;
        }

        .ws-primary-button:hover {
            background: var(--wine-dark);

            color: white;

            transform: translateY(-3px);

            box-shadow:
                0 10px 25px
                rgba(142, 58, 104, 0.22);
        }

        .ws-hero-card {
            min-height: 420px;

            border-radius: 35px;

            background:
                radial-gradient(
                    circle at 30% 20%,
                    rgba(255,255,255,0.8),
                    transparent 25%
                ),
                linear-gradient(
                    145deg,
                    #f4d9e7,
                    #8e3a68
                );

            display: flex;

            align-items: center;
            justify-content: center;

            box-shadow:
                0 25px 60px
                rgba(100, 40, 75, 0.15);

            position: relative;

            overflow: hidden;
        }

        .ws-hero-card::before {
            content: "♀";

            position: absolute;

            font-size: 19rem;
            font-weight: 300;

            color: rgba(255,255,255,0.16);
        }

        .ws-hero-card-content {
            position: relative;
            z-index: 2;

            text-align: center;

            color: white;

            padding: 40px;
        }

        .ws-hero-card-content i {
            font-size: 4rem;
        }

        .ws-hero-card-content h3 {
            margin-top: 20px;

            font-family: 'Playfair Display', serif;

            font-size: 2rem;
        }


        /* =========================================================
           ¿QUIÉNES SOMOS?
        ========================================================= */

        .ws-about {
            padding: 120px 20px;

            background: white;

            text-align: center;
        }

        .ws-about-inner {
            max-width: 800px;

            margin: 0 auto;
        }

        .ws-section-label {
            display: block;

            margin-bottom: 18px;

            color: var(--wine);

            font-size: 0.75rem;
            font-weight: 700;

            letter-spacing: 0.18em;
        }

        .ws-about h2 {
            font-family: 'Playfair Display', serif;

            font-size: clamp(2.5rem, 5vw, 4.4rem);

            line-height: 1.08;

            color: var(--dark);

            margin-bottom: 28px;
        }

        .ws-about h2 span {
            color: var(--wine);
        }

        .ws-about p {
            max-width: 650px;

            margin: 0 auto 32px;

            color: var(--gray);

            font-size: 1.05rem;

            line-height: 1.8;
        }

        .ws-outline-button {
            display: inline-flex;

            align-items: center;

            gap: 10px;

            padding: 13px 25px;

            border: 1px solid var(--wine);

            border-radius: 30px;

            color: var(--wine);

            text-decoration: none;

            font-size: 0.9rem;

            font-weight: 600;

            transition: all 0.3s ease;
        }

        .ws-outline-button:hover {
            background: var(--wine);

            color: white;

            transform: translateY(-2px);
        }


        /* =========================================================
           LA PULSERA
        ========================================================= */

        .ws-bracelet {
            padding: 110px 20px;

            background: var(--cream);
        }

        .ws-bracelet-inner {
            max-width: 1150px;

            margin: auto;

            display: grid;

            grid-template-columns: 0.8fr 1.2fr;

            gap: 70px;

            align-items: center;
        }

        .ws-bracelet-visual {
            min-height: 420px;

            border-radius: 30px;

            background:
                radial-gradient(
                    circle,
                    rgba(255,255,255,0.8),
                    transparent 45%
                ),
                linear-gradient(
                    145deg,
                    #f3d4e4,
                    #d989b1
                );

            display: flex;

            align-items: center;
            justify-content: center;

            box-shadow:
                0 20px 45px
                rgba(100, 40, 75, 0.12);
        }

        .ws-bracelet-icon {
            width: 210px;
            height: 210px;

            border-radius: 50%;

            display: flex;

            align-items: center;
            justify-content: center;

            background: white;

            box-shadow:
                0 0 0 18px rgba(255,255,255,0.3),
                0 20px 45px
                rgba(100, 40, 75, 0.18);
        }

        .ws-bracelet-icon i {
            font-size: 5rem;

            color: var(--wine);
        }

        .ws-bracelet-text .ws-section-label {
            margin-bottom: 12px;
        }

        .ws-bracelet-text h2 {
            font-family: 'Playfair Display', serif;

            font-size: clamp(2.5rem, 5vw, 4rem);

            margin-bottom: 25px;
        }

        .ws-bracelet-text p {
            color: var(--gray);

            line-height: 1.8;

            margin-bottom: 0;
        }


        /* =========================================================
           FUNCIONALIDADES
        ========================================================= */

        .ws-features {
            padding: 110px 20px;

            background: white;
        }

        .ws-features-header {
            max-width: 700px;

            margin: 0 auto 55px;

            text-align: center;
        }

        .ws-features-header h2 {
            font-family: 'Playfair Display', serif;

            font-size: clamp(2.5rem, 5vw, 4rem);

            margin-bottom: 18px;
        }

        .ws-features-header p {
            color: var(--gray);

            line-height: 1.7;
        }

        .ws-feature-grid {
            max-width: 1150px;

            margin: auto;

            display: grid;

            grid-template-columns: repeat(3, 1fr);

            gap: 22px;
        }

        .ws-feature-card {
            padding: 38px 30px;

            border: 1px solid var(--border);

            border-radius: 24px;

            background: white;

            transition: all 0.3s ease;
        }

        .ws-feature-card:hover {
            transform: translateY(-7px);

            border-color: #d9b6ca;

            box-shadow:
                0 18px 40px
                rgba(80, 40, 65, 0.09);
        }

        .ws-feature-icon {
            width: 52px;
            height: 52px;

            margin-bottom: 25px;

            display: flex;

            align-items: center;
            justify-content: center;

            border-radius: 15px;

            background: var(--pink-light);

            color: var(--wine);

            font-size: 1.4rem;
        }

        .ws-feature-card h3 {
            font-size: 1.1rem;

            margin-bottom: 12px;
        }

        .ws-feature-card p {
            color: var(--gray);

            font-size: 0.9rem;

            line-height: 1.7;

            margin: 0;
        }


        /* =========================================================
           SLIDER
        ========================================================= */

        .ws-slider-section {
            padding: 80px 20px;

            background: var(--cream);
        }


        /* =========================================================
           SERVICIOS
        ========================================================= */

        .ws-services {
            padding: 110px 20px;

            background: white;
        }

        .ws-services-header {
            max-width: 700px;

            margin: 0 auto 55px;

            text-align: center;
        }

        .ws-services-header h2 {
            font-family: 'Playfair Display', serif;

            font-size: clamp(2.5rem, 5vw, 4rem);

            color: var(--dark);

            margin-bottom: 18px;
        }

        .ws-services-header p {
            color: var(--gray);

            line-height: 1.7;
        }

        .ws-services-grid {
            max-width: 1200px;

            margin: auto;
        }

        .ws-service-card {
            height: 100%;

            overflow: hidden;

            border: 1px solid var(--border);

            border-radius: 22px;

            background: white;

            transition: all 0.3s ease;
        }

        .ws-service-card:hover {
            transform: translateY(-6px);

            box-shadow:
                0 18px 40px
                rgba(80, 40, 65, 0.1);
        }

        .ws-service-card img {
            width: 100%;

            height: 210px;

            object-fit: cover;

            background: #f5eaf0;
        }

        .ws-service-body {
            padding: 27px;
        }

        .ws-service-category {
            color: var(--pink);

            font-size: 0.75rem;

            font-weight: 700;

            text-transform: uppercase;

            letter-spacing: 0.08em;
        }

        .ws-service-body h3 {
            color: var(--wine);

            font-size: 1.25rem;

            margin: 10px 0 12px;
        }

        .ws-service-body p {
            color: var(--gray);

            font-size: 0.9rem;

            line-height: 1.7;
        }

        .ws-service-body ul {
            padding-left: 18px;

            margin-bottom: 0;

            color: #574c55;

            font-size: 0.85rem;

            line-height: 1.8;
        }


        /* =========================================================
           UBICACIÓN
        ========================================================= */

        .ws-location {
            padding: 110px 20px;

            background: var(--cream);
        }

        .ws-location-inner {
            max-width: 1100px;

            margin: auto;

            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 60px;

            align-items: center;
        }

        .ws-location h2 {
            font-family: 'Playfair Display', serif;

            font-size: clamp(2.5rem, 5vw, 4rem);

            margin-bottom: 20px;
        }

        .ws-location p {
            color: var(--gray);

            line-height: 1.8;

            margin-bottom: 28px;
        }

        .ws-location-box {
            min-height: 330px;

            border-radius: 30px;

            background:
                linear-gradient(
                    rgba(142, 58, 104, 0.08),
                    rgba(142, 58, 104, 0.08)
                ),
                #eee5ea;

            display: flex;

            align-items: center;
            justify-content: center;

            text-align: center;

            border: 1px solid var(--border);
        }

        .ws-location-box i {
            display: block;

            font-size: 4rem;

            color: var(--wine);

            margin-bottom: 15px;
        }


        /* =========================================================
           CONTACTO
        ========================================================= */

        .ws-contact {
            padding: 100px 20px;

            background: var(--wine);

            color: white;

            text-align: center;
        }

        .ws-contact-inner {
            max-width: 750px;

            margin: auto;
        }

        .ws-contact h2 {
            font-family: 'Playfair Display', serif;

            font-size: clamp(2.5rem, 5vw, 4rem);

            margin-bottom: 20px;
        }

        .ws-contact p {
            color: rgba(255,255,255,0.82);

            line-height: 1.8;

            margin-bottom: 30px;
        }

        .ws-contact-button {
            display: inline-flex;

            align-items: center;

            gap: 10px;

            padding: 14px 27px;

            border-radius: 30px;

            background: white;

            color: var(--wine);

            text-decoration: none;

            font-weight: 600;

            transition: all 0.3s ease;
        }

        .ws-contact-button:hover {
            transform: translateY(-3px);

            background: #fff4f8;

            color: var(--wine-dark);
        }


        /* =========================================================
           FOOTER
        ========================================================= */

        .ws-footer {
            padding: 30px 20px;

            background: #54223f;

            color: rgba(255,255,255,0.75);

            text-align: center;

            font-size: 0.8rem;
        }


        /* =========================================================
           RESPONSIVE
        ========================================================= */

        @media (max-width: 900px) {

            .ws-nav-links {
                position: absolute;

                top: 74px;
                left: 0;

                width: 100%;

                padding: 20px;

                background: white;

                display: none;

                flex-direction: column;

                gap: 12px;

                box-shadow:
                    0 15px 25px
                    rgba(80, 40, 65, 0.1);
            }

            .ws-nav-links.active {
                display: flex;
            }

            .ws-menu-button {
                display: block;
            }

            .ws-hero-inner {
                grid-template-columns: 1fr;

                text-align: center;

                padding: 80px 25px;
            }

            .ws-hero p {
                margin-left: auto;
                margin-right: auto;
            }

            .ws-bracelet-inner,
            .ws-location-inner {
                grid-template-columns: 1fr;
            }

            .ws-feature-grid {
                grid-template-columns: 1fr;
            }

            .ws-hero-card {
                min-height: 330px;
            }
        }

        @media (max-width: 600px) {

            .ws-navbar-inner {
                min-height: 64px;

                padding: 0 18px;
            }

            .ws-logo {
                font-size: 0.9rem;
            }

            .ws-hero {
                min-height: auto;
            }

            .ws-hero-inner {
                padding: 70px 20px;
            }

            .ws-hero h1 {
                font-size: 3.1rem;
            }

            .ws-about,
            .ws-bracelet,
            .ws-features,
            .ws-services,
            .ws-location {
                padding: 80px 20px;
            }

            .ws-bracelet-visual {
                min-height: 300px;
            }

            .ws-bracelet-icon {
                width: 160px;
                height: 160px;
            }

            .ws-bracelet-icon i {
                font-size: 3.8rem;
            }
        }

    </style>
</head>


<body>


    <!-- =========================================================
         MENÚ
    ========================================================= -->

    <nav class="ws-navbar">

        <div class="ws-navbar-inner">

            <a href="#inicio" class="ws-logo">

                <span class="ws-logo-symbol">♀</span>

                WOMEN SAFETY

            </a>


            <div class="ws-nav-links" id="wsNav">

                <a href="#quienes-somos">
                    ¿Quiénes somos?
                </a>

                <a href="#pulsera">
                    La pulsera
                </a>

                <a href="#funcionalidades">
                    Funcionalidades
                </a>

                <a href="#servicios">
                    Servicios
                </a>

                <!-- Página real del mapa -->
                <a href="/mapa">
                    Ubicación
                </a>

                <a href="#contacto">
                    Contacto
                </a>

            </div>


            <button
                class="ws-menu-button"
                type="button"
                aria-label="Abrir menú"
                onclick="toggleMenu()"
            >

                <i class="bi bi-list"></i>

            </button>

        </div>

    </nav>



    <!-- =========================================================
         HERO / INICIO
    ========================================================= -->

    <section id="inicio" class="ws-hero">

        <div class="ws-hero-inner">

            <div>

                <span class="ws-label">
                    TECNOLOGÍA PARA LA SEGURIDAD
                </span>


                <h1>

                    Tu seguridad

                    <span>
                        también importa.
                    </span>

                </h1>


                <p>

                    WOMEN SAFETY es un espacio creado para acercar
                    tecnología, información y recursos de apoyo
                    a mujeres que buscan sentirse más seguras
                    y acompañadas.

                </p>


                <a
                    href="#quienes-somos"
                    class="ws-primary-button"
                >

                    Conócenos

                    <i class="bi bi-arrow-down"></i>

                </a>

            </div>



            <div class="ws-hero-card">

                <div class="ws-hero-card-content">

                    <i class="bi bi-shield-heart"></i>


                    <!-- CAMBIO -->
                    <h3>
                        Tu seguridad también importa.
                    </h3>


                    <p>

                        Tecnología pensada para brindar
                        apoyo, protección y tranquilidad.

                    </p>

                </div>

            </div>

        </div>

    </section>



    <!-- =========================================================
         ¿QUIÉNES SOMOS?
    ========================================================= -->

    <section
        id="quienes-somos"
        class="ws-about"
    >

        <div class="ws-about-inner">

            <span class="ws-section-label">
                ¿QUIÉNES SOMOS?
            </span>


            <!-- CAMBIO -->
            <h2>

                Tecnología para sentirte

                <span>
                    más segura.
                </span>

            </h2>


            <p>

                WOMEN SAFETY nace para acercar tecnología
                y recursos de apoyo a mujeres que necesitan
                sentirse más seguras y acompañadas.

            </p>


            <a
                href="/quienes-somos"
                class="ws-outline-button"
            >

                Conocernos

                <i class="bi bi-arrow-right"></i>

            </a>

        </div>

    </section>



    <!-- =========================================================
         LA PULSERA
    ========================================================= -->

    <section
        id="pulsera"
        class="ws-bracelet"
    >

        <div class="ws-bracelet-inner">


            <div class="ws-bracelet-visual">

                <div class="ws-bracelet-icon">

                    <i class="bi bi-watch"></i>

                </div>

            </div>



            <div class="ws-bracelet-text">

                <span class="ws-section-label">
                    NUESTRA TECNOLOGÍA
                </span>


                <h2>

                    Una pulsera pensada
                    para acompañarte.

                </h2>


                <p>

                    La pulsera inteligente WOMEN SAFETY busca
                    brindar una herramienta accesible para
                    solicitar ayuda en situaciones de emergencia,
                    conectando tecnología y redes de apoyo.

                </p>

            </div>

        </div>

    </section>



    <!-- =========================================================
         FUNCIONALIDADES
    ========================================================= -->

    <section
        id="funcionalidades"
        class="ws-features"
    >

        <div class="ws-features-header">

            <span class="ws-section-label">
                FUNCIONALIDADES
            </span>


            <h2>

                Tecnología que
                responde contigo.

            </h2>


            <p>

                Diseñamos las funcionalidades pensando en
                situaciones reales y en la necesidad de
                obtener apoyo de manera rápida.

            </p>

        </div>



        <div class="ws-feature-grid">


            <!-- FUNCIONALIDAD 1 -->

            <div class="ws-feature-card">

                <div class="ws-feature-icon">

                    <i class="bi bi-exclamation-circle"></i>

                </div>


                <h3>
                    Botón de emergencia
                </h3>


                <p>

                    Permite generar una alerta cuando
                    la usuaria necesita solicitar apoyo.

                </p>

            </div>



            <!-- FUNCIONALIDAD 2 -->

            <div class="ws-feature-card">

                <div class="ws-feature-icon">

                    <i class="bi bi-geo-alt"></i>

                </div>


                <h3>
                    Ubicación
                </h3>


                <p>

                    La tecnología puede integrarse con
                    información de ubicación para facilitar
                    la atención de una emergencia.

                </p>

            </div>



            <!-- FUNCIONALIDAD 3 -->

            <div class="ws-feature-card">

                <div class="ws-feature-icon">

                    <i class="bi bi-broadcast-pin"></i>

                </div>


                <h3>
                    Comunicación
                </h3>


                <p>

                    Diseñada para conectar las alertas
                    con una red de apoyo y monitoreo.

                </p>

            </div>


        </div>

    </section>



    <!-- =========================================================
         SLIDER DE ANDREA
    ========================================================= -->

    <section
        id="slider"
        class="ws-slider-section"
    >

        <%- include('partials/slider') %>

    </section>



    <!-- =========================================================
         SERVICIOS / CATÁLOGO
    ========================================================= -->

    <section
        id="servicios"
        class="ws-services"
    >

        <div class="ws-services-header">

            <span class="ws-section-label">
                NUESTROS SERVICIOS
            </span>


            <h2>

                Soluciones para
                una red más segura.

            </h2>


            <p>

                Conoce las soluciones tecnológicas y servicios
                desarrollados por WOMEN SAFETY.

            </p>

        </div>



        <div class="ws-services-grid">

            <div class="row g-4">

                <% products.forEach(product => { %>


                    <div class="col-md-6 col-lg-4">

                        <article class="ws-service-card">


                            <img
                                src="<%= product.image %>"
                                alt="<%= product.name %>"
                            >


                            <div class="ws-service-body">


                                <span class="ws-service-category">

                                    <%= product.category %>

                                </span>


                                <h3>

                                    <%= product.name %>

                                </h3>


                                <p>

                                    <%= product.description %>

                                </p>



                                <% if (product.specs && product.specs.length > 0) { %>


                                    <ul>

                                        <% product.specs.forEach(spec => { %>

                                            <li>

                                                <%= spec %>

                                            </li>

                                        <% }) %>

                                    </ul>


                                <% } %>


                            </div>

                        </article>

                    </div>


                <% }) %>

            </div>

        </div>

    </section>



    <!-- =========================================================
         UBICACIÓN
    ========================================================= -->

    <section
        id="ubicacion"
        class="ws-location"
    >

        <div class="ws-location-inner">


            <div>

                <span class="ws-section-label">
                    RED DE APOYO
                </span>


                <h2>

                    Encuentra apoyo
                    cerca de ti.

                </h2>


                <p>

                    Consulta nuestro mapa para encontrar
                    centros de atención, instituciones y
                    espacios de apoyo para mujeres.

                </p>


                <a
                    href="/mapa"
                    class="ws-primary-button"
                >

                    Ver ubicación

                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>



            <div class="ws-location-box">

                <div>

                    <i class="bi bi-geo-alt"></i>


                    <h4>
                        Centros de atención
                    </h4>


                    <p>
                        Red de apoyo en Hidalgo
                    </p>

                </div>

            </div>

        </div>

    </section>



    <!-- =========================================================
         CONTACTO
    ========================================================= -->

    <section
        id="contacto"
        class="ws-contact"
    >

        <div class="ws-contact-inner">


            <span
                class="ws-section-label"
                style="color: #f2c5db;"
            >
                WOMEN SAFETY
            </span>


            <h2>

                La tecnología también
                puede acompañarnos.

            </h2>


            <p>

                Conoce más sobre nuestro proyecto,
                nuestras soluciones y la red de apoyo
                que estamos construyendo.

            </p>


            <a
                href="/quienes-somos"
                class="ws-contact-button"
            >

                Conocer el proyecto

                <i class="bi bi-arrow-right"></i>

            </a>

        </div>

    </section>



    <!-- =========================================================
         FOOTER
    ========================================================= -->

    <footer class="ws-footer">

        <p class="mb-0">

            © 2026 WOMEN SAFETY ·
            Tecnología para la seguridad y el bienestar de las mujeres.

        </p>

    </footer>



    <!-- =========================================================
         BOOTSTRAP JAVASCRIPT
    ========================================================= -->

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>



    <!-- =========================================================
         MENÚ MÓVIL
    ========================================================= -->

    <script>

        function toggleMenu() {

            const menu =
                document.getElementById("wsNav");

            menu.classList.toggle("active");

        }


        // Cerrar el menú cuando se selecciona una sección

        document
            .querySelectorAll(".ws-nav-links a")
            .forEach(link => {

                link.addEventListener("click", () => {

                    document
                        .getElementById("wsNav")
                        .classList.remove("active");

                });

            });

    </script>

</body>

</html>