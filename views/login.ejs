<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Acceso | WOMEN SAFETY</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --wine: #8e3a68;
            --wine-dark: #67294c;
            --pink: #b34d83;
            --pink-light: #f8e8f1;
            --cream: #fff8fb;
            --dark: #292329;
            --gray: #6f6470;
            --border: #eadbe4;
        }

        body {
            min-height: 100vh;
            font-family: 'Inter', sans-serif;
            color: var(--dark);
            background:
                radial-gradient(circle at 85% 15%, rgba(179, 77, 131, 0.14), transparent 30%),
                linear-gradient(135deg, var(--cream), #fff 55%, var(--pink-light));
            display: flex;
            flex-direction: column;
        }

        /* Barra superior mínima */
        .auth-top {
            max-width: 1100px;
            width: 100%;
            margin: 0 auto;
            padding: 22px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .auth-logo {
            text-decoration: none;
            color: var(--dark);
            font-weight: 700;
            letter-spacing: 0.08em;
        }

        .auth-logo span { color: var(--wine); font-size: 1.3rem; margin-right: 5px; }

        .auth-back {
            text-decoration: none;
            color: var(--gray);
            font-size: 0.85rem;
        }

        .auth-back:hover { color: var(--wine); }

        /* Tarjeta principal */
        .auth-main {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px 20px 60px;
        }

        .auth-card {
            width: 100%;
            max-width: 940px;
            display: grid;
            grid-template-columns: 0.9fr 1.1fr;
            border-radius: 30px;
            overflow: hidden;
            background: #fff;
            border: 1px solid var(--border);
            box-shadow: 0 25px 60px rgba(103, 41, 76, 0.12);
        }

        .auth-side {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
            background: #ffffff;
            border-right: 1px solid var(--border);
        }

        .auth-side img {
            width: 100%;
            max-width: 340px;
            height: auto;
        }

        /* Panel del formulario */
        .auth-form-wrap { padding: 44px 46px; }

        .auth-tabs {
            display: flex;
            gap: 6px;
            padding: 5px;
            margin-bottom: 30px;
            border-radius: 30px;
            background: var(--pink-light);
        }

        .auth-tab {
            flex: 1;
            border: none;
            padding: 10px 14px;
            border-radius: 25px;
            background: transparent;
            color: var(--wine-dark);
            font-size: 0.88rem;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.25s ease, color 0.25s ease;
        }

        .auth-tab.active {
            background: var(--wine);
            color: #fff;
        }

        .auth-tab:focus-visible,
        .auth-btn:focus-visible { outline: 3px solid rgba(179, 77, 131, 0.45); outline-offset: 2px; }

        .auth-panel { display: none; }
        .auth-panel.active { display: block; }

        .auth-panel h1 {
            font-family: 'Playfair Display', serif;
            font-size: 1.9rem;
            font-weight: 500;
            margin-bottom: 6px;
        }

        .auth-sub { color: var(--gray); font-size: 0.85rem; margin-bottom: 26px; }

        .form-label { font-size: 0.8rem; font-weight: 600; margin-bottom: 6px; }

        .form-control {
            padding: 12px 14px;
            border-radius: 12px;
            border: 1px solid var(--border);
            font-size: 0.9rem;
        }

        .form-control:focus {
            border-color: var(--pink);
            box-shadow: 0 0 0 4px rgba(179, 77, 131, 0.14);
        }

        .pass-group { position: relative; }
        .pass-group .form-control { padding-right: 46px; }

        .pass-toggle {
            position: absolute;
            top: 50%;
            right: 8px;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            padding: 6px 8px;
            color: var(--gray);
            cursor: pointer;
        }

        .pass-toggle:hover { color: var(--wine); }

        .was-validated .pass-group .form-control:valid,
        .was-validated .pass-group .form-control:invalid {
            background-image: none;
            padding-right: 46px;
        }

        .was-validated .pass-group:has(:invalid) + .invalid-feedback { display: block; }

        .auth-btn {
            width: 100%;
            margin-top: 8px;
            padding: 13px;
            border: none;
            border-radius: 30px;
            background: var(--wine);
            color: #fff;
            font-size: 0.92rem;
            font-weight: 600;
            transition: background 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
        }

        .auth-btn:hover {
            background: var(--wine-dark);
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(142, 58, 104, 0.22);
        }

        .auth-switch { margin-top: 22px; text-align: center; font-size: 0.83rem; color: var(--gray); }

        .auth-switch a { color: var(--wine); font-weight: 600; text-decoration: none; }
        .auth-switch a:hover { text-decoration: underline; }

        .auth-alert {
            border-radius: 12px;
            font-size: 0.83rem;
            border: 1px solid #f0c2d4;
            background: #fdecf3;
            color: var(--wine-dark);
        }

        .auth-hint { font-size: 0.75rem; color: var(--gray); margin-top: 6px; }

        /* Requisitos de contraseña */
        .pass-reqs-box {
            margin: 14px 0 6px;
            padding: 14px 16px;
            border-radius: 14px;
            background: var(--cream);
            border: 1px solid var(--border);
        }

        .pass-reqs-title { font-size: 0.78rem; font-weight: 600; color: var(--wine-dark); }
        .pass-reqs-level { font-size: 0.75rem; font-weight: 600; color: var(--gray); }

        .pass-reqs-box .progress { height: 6px; background: var(--pink-light); border-radius: 10px; }
        .pass-reqs-box .progress-bar { border-radius: 10px; transition: width 0.3s ease, background-color 0.3s ease; }

        #pass-reqs li { font-size: 0.78rem; color: var(--gray); transition: color 0.25s ease; }
        #pass-reqs li.ok { color: #2e7d32; font-weight: 600; }

        @media (max-width: 800px) {
            .auth-card { grid-template-columns: 1fr; }
            .auth-side { display: none; }
            .auth-form-wrap { padding: 34px 26px; }
        }

        @media (prefers-reduced-motion: reduce) {
            * { transition: none !important; }
        }
    </style>
</head>

<body>

    <header class="auth-top">
        <a href="/" class="auth-logo"><span>♀</span>WOMEN SAFETY</a>
        <a href="/" class="auth-back"><i class="bi bi-arrow-left"></i> Volver al inicio</a>
    </header>

    <main class="auth-main">
        <div class="auth-card">

            <!-- Panel decorativo -->
            <aside class="auth-side">
                <img src="/img/mujer-flor.svg" alt="Ilustración de una mujer sosteniendo una flor">
            </aside>

            <!-- Formularios -->
            <section class="auth-form-wrap">

                <div class="auth-tabs" role="tablist">
                    <button type="button" class="auth-tab active" id="tab-login" role="tab" aria-controls="panel-login" aria-selected="true">Iniciar sesión</button>
                    <button type="button" class="auth-tab" id="tab-registro" role="tab" aria-controls="panel-registro" aria-selected="false">Crear cuenta</button>
                </div>

                <!-- LOGIN -->
                <div class="auth-panel active" id="panel-login" role="tabpanel" aria-labelledby="tab-login">
                    <h1>Bienvenida de nuevo</h1>
                    <p class="auth-sub">Ingresa con tu correo y contraseña.</p>

                    <!-- SECCIÓN DE ALERTAS (ERROR Y ÉXITO) -->
                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="alert alert-danger py-2 px-3 mb-3 text-center" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
                        </div>
                    <% } %>

                    <% if (typeof success !== 'undefined' && success) { %>
                        <div class="alert alert-success py-2 px-3 mb-3 text-center" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i><%= success %>
                        </div>
                    <% } %>

                    <form action="/login" method="POST" class="needs-validation" novalidate>
                        <div class="mb-3">
                            <label for="login-email" class="form-label">Correo electrónico</label>
                            <input type="email" class="form-control" id="login-email" name="email" autocomplete="email" required>
                            <div class="invalid-feedback">Escribe un correo válido.</div>
                        </div>

                        <div class="mb-3">
                            <label for="login-password" class="form-label">Contraseña</label>
                            <div class="pass-group">
                                <input type="password" class="form-control" id="login-password" name="password" autocomplete="current-password" required>
                                <button type="button" class="pass-toggle" data-target="login-password" aria-label="Mostrar contraseña">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <div class="invalid-feedback">Escribe tu contraseña.</div>
                        </div>

                        <button type="submit" class="auth-btn">Iniciar sesión</button>
                    </form>

                    <p class="auth-switch">¿No tienes cuenta? <a href="#registro" data-switch="registro">Crea una aquí</a></p>
                </div>

                <!-- REGISTRO -->
                <div class="auth-panel" id="panel-registro" role="tabpanel" aria-labelledby="tab-registro">
                    <h1>Crea tu cuenta</h1>
                    <p class="auth-sub">Solo necesitamos unos datos básicos.</p>

                    <form action="/registro" method="POST" class="needs-validation" novalidate>
                        <div class="mb-3">
                            <label for="reg-nombre" class="form-label">Nombre</label>
                            <input type="text" class="form-control" id="reg-nombre" name="nombre" autocomplete="name" minlength="2" required>
                            <div class="invalid-feedback">Escribe tu nombre.</div>
                        </div>

                        <div class="mb-3">
                            <label for="reg-email" class="form-label">Correo electrónico</label>
                            <input type="email" class="form-control" id="reg-email" name="email" autocomplete="email" required>
                            <div class="invalid-feedback">Escribe un correo válido.</div>
                        </div>

                        <div class="row g-3 mb-1">
                            <div class="col-md-6">
                                <label for="reg-password" class="form-label">Contraseña</label>
                                <div class="pass-group">
                                    <input type="password" class="form-control" id="reg-password" name="password" autocomplete="new-password" minlength="8" required>
                                    <button type="button" class="pass-toggle" data-target="reg-password" aria-label="Mostrar contraseña">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <div class="invalid-feedback">La contraseña no cumple los requisitos.</div>
                            </div>

                            <div class="col-md-6">
                                <label for="reg-password2" class="form-label">Confirmar contraseña</label>
                                <div class="pass-group">
                                    <input type="password" class="form-control" id="reg-password2" name="password2" autocomplete="new-password" required>
                                    <button type="button" class="pass-toggle" data-target="reg-password2" aria-label="Mostrar contraseña">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <div class="invalid-feedback" id="pass2-feedback">Las contraseñas no coinciden.</div>
                            </div>
                        </div>

                        <!-- Requisitos de contraseña (se marcan en vivo) -->
                        <div class="pass-reqs-box">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="pass-reqs-title">Tu contraseña debe tener</span>
                                <span class="pass-reqs-level" id="pass-level"></span>
                            </div>
                            <div class="progress mb-3" role="progressbar" aria-label="Seguridad de la contraseña">
                                <div class="progress-bar" id="pass-bar" style="width: 0%"></div>
                            </div>
                            <ul class="list-unstyled row row-cols-1 row-cols-sm-2 g-2 mb-0" id="pass-reqs">
                                <li class="col" data-rule="len"><i class="bi bi-circle me-2"></i>8 caracteres</li>
                                <li class="col" data-rule="lower"><i class="bi bi-circle me-2"></i>Una minúscula</li>
                                <li class="col" data-rule="upper"><i class="bi bi-circle me-2"></i>Una mayúscula</li>
                                <li class="col" data-rule="digit"><i class="bi bi-circle me-2"></i>Un número</li>
                                <li class="col" data-rule="symbol"><i class="bi bi-circle me-2"></i>Un símbolo (!@#$%)</li>
                                <li class="col" data-rule="nospace"><i class="bi bi-circle me-2"></i>Sin espacios</li>
                            </ul>
                        </div>

                        <button type="submit" class="auth-btn mt-3">Crear cuenta</button>
                    </form>

                    <p class="auth-switch">¿Ya tienes cuenta? <a href="#login" data-switch="login">Inicia sesión</a></p>
                </div>

            </section>
        </div>
    </main>

    <script>
        // Cambiar entre pestañas
        const tabs = { login: document.getElementById('tab-login'), registro: document.getElementById('tab-registro') };
        const panels = { login: document.getElementById('panel-login'), registro: document.getElementById('panel-registro') };

        function showTab(name) {
            Object.keys(tabs).forEach(key => {
                const active = key === name;
                tabs[key].classList.toggle('active', active);
                tabs[key].setAttribute('aria-selected', active);
                panels[key].classList.toggle('active', active);
            });
        }

        Object.keys(tabs).forEach(key => tabs[key].addEventListener('click', () => showTab(key)));

        document.querySelectorAll('[data-switch]').forEach(link => {
            link.addEventListener('click', e => {
                e.preventDefault();
                showTab(link.dataset.switch);
            });
        });

        // Permite abrir directo /login#registro
        if (location.hash === '#registro') showTab('registro');

        // Mostrar / ocultar contraseña
        document.querySelectorAll('.pass-toggle').forEach(btn => {
            btn.addEventListener('click', () => {
                const input = document.getElementById(btn.dataset.target);
                const show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                btn.innerHTML = show ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
                btn.setAttribute('aria-label', show ? 'Ocultar contraseña' : 'Mostrar contraseña');
            });
        });

        // Requisitos de contraseña en vivo (el servidor valida de nuevo)
        const regPass = document.getElementById('reg-password');
        const regPass2 = document.getElementById('reg-password2');
        const reglas = {
            len:     v => v.length >= 8,
            lower:   v => /[a-z]/.test(v),
            upper:   v => /[A-Z]/.test(v),
            digit:   v => /\d/.test(v),
            symbol:  v => /[^A-Za-z0-9]/.test(v),
            nospace: v => !/\s/.test(v)
        };

        function revisarPassword() {
            let cumplidas = 0;
            const total = Object.keys(reglas).length;

            document.querySelectorAll('#pass-reqs li').forEach(li => {
                const ok = reglas[li.dataset.rule](regPass.value);
                li.classList.toggle('ok', ok);
                const icono = li.querySelector('i');
                icono.classList.toggle('bi-check-circle-fill', ok);
                icono.classList.toggle('bi-circle', !ok);
                if (ok) cumplidas++;
            });

            const porcentaje = regPass.value ? Math.round((cumplidas / total) * 100) : 0;
            const bar = document.getElementById('pass-bar');
            const nivel = document.getElementById('pass-level');
            bar.style.width = porcentaje + '%';

            let texto = '', color = '#dc3545';
            if (!regPass.value) { texto = ''; }
            else if (cumplidas < 4) { texto = 'Débil'; color = '#dc3545'; }
            else if (cumplidas < total) { texto = 'Media'; color = '#f0a020'; }
            else { texto = 'Segura'; color = '#2e7d32'; }

            bar.style.backgroundColor = color;
            nivel.textContent = texto;
            nivel.style.color = color;

            regPass.setCustomValidity(cumplidas === total ? '' : 'La contraseña no cumple los requisitos.');
        }

        function revisarCoincidencia() {
            regPass2.setCustomValidity(regPass.value === regPass2.value ? '' : 'No coinciden');
        }

        regPass.addEventListener('input', () => { revisarPassword(); revisarCoincidencia(); });
        regPass2.addEventListener('input', revisarCoincidencia);

        // Validación de Bootstrap
        document.querySelectorAll('.needs-validation').forEach(form => {
            form.addEventListener('submit', e => {
                if (form.querySelector('#reg-password')) {
                    revisarPassword();
                    revisarCoincidencia();
                }
                if (!form.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                form.classList.add('was-validated');
            });
        });
    </script>

</body>

</html>