<!-- =========================================================
     VIOLENTÓMETRO (solo Bootstrap + variables de tu paleta)
========================================================= -->

<div id="vio" class="row g-4">

    <!-- ===================== MEDIDOR ===================== -->
    <div class="col-lg-5">
        <div class="card h-100 border-0 shadow-sm rounded-4">
            <div class="card-body p-4 d-flex flex-column">

                <span class="ws-section-label mb-2">Niveles del violentómetro</span>
                <p class="small text-secondary mb-4">
                    El medidor sube según las señales que identifiques. Cada nivel indica qué tan pronto conviene buscar apoyo.
                </p>

                <div class="d-flex gap-3 flex-fill" style="min-height: 300px;">

                    <!-- Columna del medidor -->
                    <div class="position-relative overflow-hidden rounded-pill border flex-shrink-0 align-self-stretch" style="width: 46px;">
                        <div class="d-flex flex-column h-100">
                            <div class="flex-fill" style="background: var(--bs-danger);"></div>
                            <div class="flex-fill" style="background: var(--bs-orange);"></div>
                            <div class="flex-fill" style="background: var(--bs-warning);"></div>
                            <div class="flex-fill" style="background: var(--bs-success);"></div>
                        </div>
                        <!-- Cubierta: al bajar su altura, el medidor "sube" -->
                        <div id="vio-cover" class="position-absolute top-0 start-0 w-100 bg-body-secondary" style="height: 100%;"></div>
                    </div>

                    <!-- Leyenda -->
                    <div class="d-flex flex-column flex-fill gap-2">

                        <div id="vio-lvl-4" class="flex-fill p-2 rounded-3 d-flex flex-column justify-content-center">
                            <div class="fw-semibold small"><i class="bi bi-circle-fill text-danger me-2"></i>Riesgo alto</div>
                            <div class="small text-secondary">Hay señales de peligro para tu integridad. Busca ayuda de inmediato.</div>
                        </div>

                        <div id="vio-lvl-3" class="flex-fill p-2 rounded-3 d-flex flex-column justify-content-center">
                            <div class="fw-semibold small"><i class="bi bi-circle-fill me-2" style="color: var(--bs-orange);"></i>Riesgo medio-alto</div>
                            <div class="small text-secondary">La violencia es frecuente o severa. Necesitas orientación y acompañamiento.</div>
                        </div>

                        <div id="vio-lvl-2" class="flex-fill p-2 rounded-3 d-flex flex-column justify-content-center">
                            <div class="fw-semibold small"><i class="bi bi-circle-fill text-warning me-2"></i>Señales de violencia</div>
                            <div class="small text-secondary">Hay conductas que conviene revisar antes de que escalen.</div>
                        </div>

                        <div id="vio-lvl-1" class="flex-fill p-2 rounded-3 d-flex flex-column justify-content-center">
                            <div class="fw-semibold small"><i class="bi bi-circle-fill text-success me-2"></i>Sin señales de alerta</div>
                            <div class="small text-secondary">No se detectaron señales relevantes.</div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>


    <!-- ===================== TEST ===================== -->
    <div class="col-lg-7">
        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">

            <div class="card-header border-0 text-white px-4 py-3" style="background: var(--wine);">
                <span class="fw-semibold"><i class="bi bi-shield-heart me-2"></i>Test de orientación</span>
            </div>

            <div class="progress rounded-0" style="height: 6px;" role="progressbar" aria-label="Avance del test" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="vio-progress">
                <div id="vio-bar" class="progress-bar" style="width: 0%; background: var(--wine);"></div>
            </div>

            <div class="card-body p-4">

                <!-- Bienvenida -->
                <div id="vio-welcome" class="fade show">
                    <h4 class="h5 fw-bold mb-1">Antes de comenzar</h4>
                    <p class="text-secondary mb-4">Este es un espacio seguro y confidencial.</p>

                    <ul class="list-group list-group-flush mb-4">
                        <li class="list-group-item px-0 d-flex gap-2"><i class="bi bi-check2-circle" style="color: var(--wine);"></i>Son 17 preguntas y toma unos 2 minutos.</li>
                        <li class="list-group-item px-0 d-flex gap-2"><i class="bi bi-check2-circle" style="color: var(--wine);"></i>Solo toca una opción: avanzas sola, sin escribir nada.</li>
                        <li class="list-group-item px-0 d-flex gap-2"><i class="bi bi-check2-circle" style="color: var(--wine);"></i>Puedes omitir cualquier pregunta.</li>
                        <li class="list-group-item px-0 d-flex gap-2"><i class="bi bi-check2-circle" style="color: var(--wine);"></i>Puedes salir en cualquier momento presionando la tecla Esc.</li>
                        <li class="list-group-item px-0 d-flex gap-2"><i class="bi bi-check2-circle" style="color: var(--wine);"></i>No es un diagnóstico: es una guía para orientarte.</li>
                        <li class="list-group-item px-0 d-flex gap-2"><i class="bi bi-check2-circle" style="color: var(--wine);"></i>Tus respuestas no se guardan ni se envían.</li>
                    </ul>

                    <button type="button" class="ws-primary-button border-0" id="vio-start">
                        Comenzar<i class="bi bi-arrow-right"></i>
                    </button>
                </div>

                <!-- Pregunta -->
                <div id="vio-test" class="fade d-none">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span id="vio-dim-badge" class="badge rounded-pill fw-semibold px-3 py-2" style="background: var(--pink-light); color: var(--wine-dark);"></span>
                        <span id="vio-count" class="small text-secondary"></span>
                    </div>

                    <p id="vio-dim-desc" class="small text-secondary mb-2"></p>
                    <h4 id="vio-q" class="h5 fw-bold mb-4" aria-live="polite"></h4>

                    <div id="vio-options" class="row g-2 mb-4" role="radiogroup"></div>

                    <div class="d-flex justify-content-between align-items-center">
                        <button type="button" class="btn btn-outline-secondary rounded-pill" id="vio-prev">
                            <i class="bi bi-arrow-left me-1"></i>Anterior
                        </button>
                        <button type="button" class="btn btn-link text-secondary text-decoration-none" id="vio-skip">Omitir</button>
                    </div>
                </div>

                <!-- Resultado -->
                <div id="vio-result" class="fade d-none"></div>

            </div>

            <div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0 small text-secondary">
                Esta herramienta orienta, no sustituye la atención profesional. Si estás en peligro, llama al 911.
            </div>
        </div>
    </div>

    <!-- Testimonios (se llenan al final del test si el riesgo es medio-alto o alto) -->
    <div id="vio-testimonios" class="col-12 d-none" style="scroll-margin-top: 90px;"></div>

</div>


<script>
(function () {

    /* ---------- Datos ---------- */

    const DIM = {
        psicologica: { nombre: "Violencia psicológica", icono: "bi-chat-heart",        desc: "Insultos, humillaciones, amenazas y culpa que dañan tu autoestima." },
        fisica:      { nombre: "Violencia física",      icono: "bi-bandaid",           desc: "Agresiones que afectan tu cuerpo o buscan intimidarte." },
        sexual:      { nombre: "Violencia sexual",      icono: "bi-shield-exclamation",desc: "Cualquier acto sexual sin tu consentimiento o que limite tu decisión sobre tu cuerpo." },
        economica:   { nombre: "Violencia económica",   icono: "bi-wallet2",           desc: "Control del dinero, del trabajo o de tus bienes para hacerte depender." },
        digital:     { nombre: "Violencia digital",     icono: "bi-phone",             desc: "Vigilancia, acoso o difusión de contenido a través de medios digitales." },
        control:     { nombre: "Control y aislamiento", icono: "bi-lock",              desc: "Conductas que limitan tu libertad y te alejan de tus redes de apoyo." },
        riesgo:      { nombre: "Factores de riesgo",    icono: "bi-exclamation-triangle", desc: "Situaciones que aumentan la posibilidad de un daño grave." }
    };

    // Orden pensado para la experiencia: temas menos intensos primero,
    // y los más sensibles al final, cuando ya hay confianza.
    const P = [
        { id: "6.1", dim: "control", t: "¿Te impide ver a tu familia o amistades?" },
        { id: "6.3", dim: "control", t: "¿Decide por ti lo que puedes o no hacer, vestir o decir?" },

        { id: "1.1", dim: "psicologica", t: "¿Tu pareja te humilla, insulta o te hace sentir menos?" },
        { id: "1.4", dim: "psicologica", t: "¿Te amenaza con hacerte daño a ti o a alguien que quieres?" },

        { id: "4.1", dim: "economica", t: "¿Te controla el dinero que ganas o te da?" },
        { id: "4.2", dim: "economica", t: "¿Te impide trabajar o estudiar?" },

        { id: "5.1", dim: "digital", t: "¿Revisa tus mensajes, redes sociales o correo sin tu permiso?" },
        { id: "5.4", dim: "digital", t: "¿Ha difundido o amenazado con difundir imágenes íntimas tuyas?" },

        { id: "2.1", dim: "fisica", t: "¿Te ha empujado, jalado o sujetado con fuerza?" },
        { id: "2.2", dim: "fisica", t: "¿Te ha golpeado, abofeteado o pateado?" },

        { id: "3.1", dim: "sexual", t: "¿Te ha obligado a tener relaciones sexuales cuando no quieres?" },
        { id: "3.2", dim: "sexual", t: "¿Te ha presionado o manipulado para tener relaciones sexuales?" },

        // Riesgo: un solo "Sí" ya indica riesgo alto (7.9 se trata aparte)
        { id: "7.1", dim: "riesgo", bin: true, t: "¿Tu pareja ha amenazado con matarte o matarse?" },
        { id: "7.2", dim: "riesgo", bin: true, t: "¿Tienes miedo de que pueda matarte o hacerte daño grave?" },
        { id: "7.5", dim: "riesgo", bin: true, t: "¿Ha intentado estrangularte o asfixiarte?" },
        { id: "7.3", dim: "riesgo", bin: true, t: "¿Tiene acceso a armas (fuego, punzocortantes)?" },
        { id: "7.9", dim: "riesgo", bin: true, t: "¿Has pensado en quitarte la vida o has tenido ideación suicida?" }
    ];

    const FREC = [
        { v: 0, t: "Nunca" }, { v: 1, t: "A veces" }, { v: 2, t: "Frecuentemente" }
    ];
    const BIN = [ { v: 0, t: "No" }, { v: 1, t: "Sí" } ];

    const NIVELES = {
        rojo: {
            idx: 4, icono: "bi-exclamation-octagon-fill", color: "var(--bs-danger)", texto: "text-white",
            titulo: "Riesgo alto",
            mensaje: "Tu seguridad es lo más importante. Detectamos señales que requieren atención inmediata. No estás sola.",
            pasos: [
                "Busca un lugar seguro y avisa a una persona de confianza.",
                "Guarda mensajes, fotos y documentos importantes en un lugar seguro."
            ]
        },
        naranja: {
            idx: 3, icono: "bi-exclamation-triangle-fill", color: "var(--bs-orange)", texto: "text-white",
            titulo: "Riesgo medio-alto",
            mensaje: "Detectamos señales de violencia que requieren atención. Puedes recibir acompañamiento.",
            pasos: [
                "Habla con una persona de confianza sobre lo que estás viviendo.",
                "Guarda mensajes, fotos y documentos importantes en un lugar seguro.",
                "Identifica a quién podrías recurrir si la situación empeora."
            ]
        },
        amarillo: {
            idx: 2, icono: "bi-info-circle-fill", color: "var(--bs-warning)", texto: "text-dark",
            titulo: "Señales de violencia",
            mensaje: "Detectamos algunas señales que vale la pena revisar. La violencia puede aumentar con el tiempo.",
            pasos: [
                "Comparte lo que sientes con alguien de confianza.",
                "Presta atención a si estas conductas se repiten o se intensifican."
            ]
        },
        verde: {
            idx: 1, icono: "bi-check-circle-fill", color: "var(--bs-success)", texto: "text-white",
            titulo: "Sin señales de alerta",
            mensaje: "No detectamos señales relevantes de violencia en tus respuestas.",
            pasos: [
                "Una relación sana se basa en respeto, libertad y buen trato.",
                "Comparte esta herramienta con quien pueda necesitarla."
            ]
        }
    };

    /* ---------- Testimonios ----------
       Provisionales: escritos por el equipo mientras se reúnen los reales.
       Cuando tengas testimonios reales (con consentimiento), reemplaza los textos
       y cambia TESTIMONIOS_REALES a true para que la etiqueta deje de decir "ilustrativas".
       naranja = riesgo medio-alto · rojo = riesgo alto */

    const TESTIMONIOS_REALES = false;

    const TESTIMONIOS = {
        naranja: [
            { titulo: "Reconocer la violencia", autor: "Anónimo · Atención psicológica",
              texto: `“Antes creía que era normal que mi pareja me tratara así. Pensaba que los celos y que quisiera controlar todo lo que hacía eran una forma de demostrarme amor. Con el tiempo, las cosas empeoraron y comencé a tener miedo. Una amiga me orientó para acudir a la Instancia de la Mujer, donde recibí apoyo y orientación. Poco a poco entendí que no tenía la culpa de lo que estaba viviendo y que merecía una relación en la que me sintiera segura. Hoy estoy aprendiendo a tomar mis propias decisiones y a recuperar mi tranquilidad”.` },
            { titulo: "Recuperar la libertad", autor: "Anónimo · Orientación y acompañamiento",
              texto: `“Durante mucho tiempo dejé de hacer cosas que me gustaban porque mi pareja se molestaba si salía sin su permiso. Llegué a pensar que tenía que pedir autorización para todo. Cuando recibí orientación, comencé a comprender que una relación no debería hacerme sentir prisionera. Fue un proceso difícil, pero con acompañamiento pude tomar decisiones pensando en mi bienestar. Ahora estoy recuperando mi independencia y me siento más libre de ser yo misma”.` },
            { titulo: "Dejar de sentirse culpable", autor: "Anónimo · Apoyo emocional",
              texto: `“Yo pensaba que las discusiones eran mi culpa y que, si cambiaba mi forma de ser, mi pareja dejaría de tratarme mal. Siempre terminaba disculpándome, incluso cuando me sentía lastimada. Buscar ayuda me permitió hablar de lo que estaba viviendo sin sentirme juzgada. Aprendí que mis sentimientos importan y que no soy responsable de las decisiones violentas de otra persona. Todavía estoy trabajando en mí, pero ahora sé que merezco respeto”.` },
            { titulo: "Pedir ayuda sin miedo", autor: "Anónimo · Orientación sobre seguridad",
              texto: `“Me daba miedo contarle a alguien lo que ocurría en mi relación. Pensaba que nadie me creería o que me dirían que estaba exagerando. Cuando finalmente busqué orientación, pude expresar mis preocupaciones y conocer las opciones de apoyo disponibles para mí. Comprendí que no tenía que resolverlo todo sola ni tomar todas las decisiones de un día para otro. Saber que existen personas e instituciones que pueden orientarme me ayudó a sentirme menos sola”.` },
            { titulo: "Volver a empezar", autor: "Anónimo · Proceso de recuperación",
              texto: `“Después de vivir una relación en la que constantemente me hacían sentir menos, había perdido mucha confianza en mí misma. Me costaba expresar lo que quería y hasta dudaba de mis propias decisiones. Con el apoyo que recibí, comencé a reconocer mis capacidades y a poner límites. Mi proceso no ha sido perfecto ni rápido, pero he aprendido que merezco vivir sin miedo y que pedir ayuda no me hace débil. Hoy miro mi futuro con más esperanza”.` },
            { titulo: "No estoy sola", autor: "Anónimo · Acompañamiento institucional",
              texto: `“Durante mucho tiempo guardé silencio porque me daba vergüenza que otras personas supieran lo que estaba pasando. Creía que tenía que soportarlo y resolverlo por mi cuenta. Cuando acudí a recibir orientación, descubrí que podía hablar de mi situación y conocer alternativas para cuidar de mí. Entendí que no soy la única que ha pasado por algo así y que merezco ser escuchada con respeto. Hoy sé que buscar ayuda fue un paso importante para mi bienestar”.` }
        ],
        rojo: [
            { titulo: "“Llegué a tener miedo de estar en mi propia casa”", cat: "",
              texto: `“Al principio eran insultos y discusiones que terminaban con promesas de que todo iba a cambiar. Después comenzó a empujarme, a amenazarme y a culparme por sus reacciones. Yo trataba de evitar cualquier cosa que pudiera hacerlo enojar, pero nunca era suficiente. Llegué a sentir miedo incluso cuando escuchaba que abría la puerta. Me costaba aceptar que la persona que decía amarme también me estaba haciendo daño. Cuando finalmente pude hablar con alguien de confianza y recibir orientación, comprendí que mi seguridad tenía que ser una prioridad. No fue fácil enfrentar lo que estaba viviendo, pero hoy sé que no merecía ese trato y que no tenía por qué soportarlo”.` },
            { titulo: "“Sentía que ya no podía decidir sobre mi propia vida”", cat: "Control y amenazas",
              texto: `“Mi pareja quería saber dónde estaba en todo momento, revisaba mi teléfono y se molestaba si hablaba con mis amigas o visitaba a mi familia. Poco a poco me fui quedando sola. Si no contestaba sus llamadas, me amenazaba con hacerme pagar las consecuencias cuando regresara a casa. Vivía pendiente de sus mensajes y había dejado de hacer muchas cosas por miedo a su reacción. Durante mucho tiempo pensé que eran problemas privados que debía resolver yo sola. Cuando busqué orientación, pude hablar de las amenazas y conocer alternativas para protegerme. Comprendí que el amor no debería obligarme a vivir bajo vigilancia ni hacerme sentir que mi vida le pertenece a otra persona”.` },
            { titulo: "“Comprendí que ser su pareja no significaba que pudiera obligarme”", cat: "Violencia sexual y falta de consentimiento",
              texto: `“Durante mi relación, mi pareja me hacía sentir que tenía la obligación de aceptar cosas que no quería. Cuando intentaba negarme, se enojaba, me culpaba o me decía que, si realmente lo amaba, no debería rechazarlo. Empecé a sentir que mi opinión no importaba y que no tenía derecho a poner límites. Me costó mucho hablar de esto por vergüenza y por miedo a que no me creyeran. Cuando recibí orientación, pude comprender que estar en una relación no elimina mi derecho a decidir sobre mi cuerpo. Aprenderlo fue doloroso, pero también fue un paso importante para recuperar mi voz y reconocer que merezco respeto”.` },
            { titulo: "“Pensé que pedir ayuda podía empeorar las cosas”", cat: "Amenazas contra la seguridad",
              texto: `“Mi pareja había comenzado a amenazarme cuando hablaba de terminar la relación. Me decía que no iba a dejarme ir y que, si lo hacía, me arrepentiría. Yo quería alejarme, pero tenía miedo de lo que pudiera pasar y no sabía cómo hacerlo de manera segura. Durante mucho tiempo guardé silencio porque pensaba que nadie podría ayudarme. Cuando conseguí hablar con una persona de confianza, pude conocer opciones de atención y orientación para mi situación. Entendí que no tenía que enfrentar las amenazas sola ni anunciar mis decisiones si eso podía ponerme en riesgo. Con apoyo, comencé a pensar en mi seguridad y en cómo recuperar mi tranquilidad”.` },
            { titulo: "“Me hizo creer que sin él no podría sobrevivir”", cat: "Aislamiento y dependencia económica",
              texto: `“Dejé de trabajar porque mi pareja insistía en que debía dedicarme únicamente a la casa. Después empezó a controlar el dinero y tenía que pedirle hasta para cubrir necesidades básicas. Cuando hablaba de irme, me decía que no tenía nada, que nadie me ayudaría y que terminaría arrepintiéndome. Con el tiempo llegué a creerle. Me sentía atrapada porque no sabía cómo empezar de nuevo. Al recibir orientación, pude conocer alternativas y pensar en un plan para recuperar mi independencia. El proceso ha requerido tiempo y apoyo, pero hoy estoy aprendiendo que mis capacidades no desaparecieron y que merezco construir una vida en la que pueda tomar mis propias decisiones”.` },
            { titulo: "“Dejé de pensar que eran simples discusiones”", cat: "Escalada de violencia",
              texto: `“Durante mucho tiempo minimicé lo que sucedía. Me decía que todas las parejas discutían y que, después de cada episodio, las cosas mejorarían. Pero las amenazas, los insultos y las agresiones se volvieron cada vez más frecuentes. Empecé a modificar mi comportamiento por miedo y a ocultar lo que ocurría para que nadie se preocupara por mí. Un día comprendí que no podía seguir ignorando el peligro que estaba viviendo. Busqué orientación y pude hablar de mi situación sin tener que justificar el comportamiento de mi pareja. Todavía estoy reconstruyendo muchas partes de mi vida, pero ahora entiendo que reconocer la violencia y pedir ayuda son pasos importantes para protegerme”.` }
        ]
    };

    function pintarTestimonios(clave) {
        const lista = TESTIMONIOS[clave];
        if (!lista) return;

        const slides = lista.map((t, k) => {
            const partes = t.autor ? t.autor.split(" · ") : ["Anónimo", t.cat || ""];
            const rol = partes[1] || "";
            return '<div class="carousel-item' + (k === 0 ? ' active' : '') + '">' +
                '<article class="card border-0 shadow-sm rounded-4 position-relative" style="min-height: 21rem;">' +
                    '<i class="bi bi-quote position-absolute top-0 end-0 mt-2 me-4 opacity-25" style="font-size: 4rem; color: var(--wine);"></i>' +
                    '<div class="card-body p-4 p-md-5">' +
                        '<div class="d-flex align-items-center gap-3 mb-4">' +
                            '<div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px; font-size: 1.25rem; background: var(--pink-light); color: var(--wine);"><i class="bi bi-person-fill"></i></div>' +
                            '<div class="lh-sm">' +
                                '<div class="fw-semibold">' + partes[0] + '</div>' +
                                (rol ? '<div class="small" style="color: var(--wine);">' + rol + '</div>' : '') +
                            '</div>' +
                        '</div>' +
                        '<h5 class="h6 fw-bold mb-2">' + t.titulo + '</h5>' +
                        '<p class="mb-0" style="line-height: 1.7;">' + t.texto + '</p>' +
                    '</div>' +
                '</article>' +
            '</div>';
        }).join("");

        const puntos = lista.map((t, k) =>
            '<button type="button" data-bs-target="#vio-car" data-bs-slide-to="' + k + '"' + (k === 0 ? ' class="active" aria-current="true"' : '') +
            ' aria-label="Historia ' + (k + 1) + '" style="background-color: var(--wine);"></button>'
        ).join("");

        const nota = TESTIMONIOS_REALES
            ? "Testimonios de mujeres que recibieron apoyo."
            : "Historias ilustrativas escritas por el equipo de WOMEN SAFETY.";

        const aviso = clave === "rojo" ? " Algunas hablan de violencia y pueden ser difíciles de leer." : "";

        const cont = $("vio-testimonios");
        cont.innerHTML =
            '<div class="pt-4 mx-auto" style="max-width: 860px;">' +
                '<div class="text-center mb-4">' +
                    '<span class="ws-section-label mb-2">No estás sola</span>' +
                    '<h3 class="fs-3 fw-medium mb-2" style="font-family: \'Playfair Display\', serif;">Otras mujeres también pidieron apoyo</h3>' +
                    '<p class="small text-secondary mb-0">' + nota + aviso + '</p>' +
                '</div>' +
                '<div class="d-flex align-items-center gap-3">' +
                    '<button type="button" class="btn btn-light border rounded-circle shadow-sm flex-shrink-0 d-none d-md-flex align-items-center justify-content-center" style="width: 44px; height: 44px;" data-bs-target="#vio-car" data-bs-slide="prev" aria-label="Historia anterior"><i class="bi bi-chevron-left"></i></button>' +
                    '<div id="vio-car" class="carousel slide carousel-fade flex-fill" data-bs-interval="false" style="min-width: 0;">' +
                        '<div class="carousel-inner">' + slides + '</div>' +
                        '<div class="carousel-indicators position-static mx-0 mt-4 mb-0">' + puntos + '</div>' +
                    '</div>' +
                    '<button type="button" class="btn btn-light border rounded-circle shadow-sm flex-shrink-0 d-none d-md-flex align-items-center justify-content-center" style="width: 44px; height: 44px;" data-bs-target="#vio-car" data-bs-slide="next" aria-label="Historia siguiente"><i class="bi bi-chevron-right"></i></button>' +
                '</div>' +
            '</div>';

        cont.classList.remove("d-none", "show");
        cont.classList.add("fade");
        void cont.offsetWidth;
        setTimeout(() => cont.classList.add("show"), reducido ? 0 : 700);
    }

    function ocultarTestimonios() {
        const cont = $("vio-testimonios");
        cont.classList.add("d-none");
        cont.classList.remove("show");
        cont.innerHTML = "";
    }

    /* ---------- Estilos Bootstrap con la paleta del sitio ---------- */

    const OPT = "--bs-btn-color:var(--dark);--bs-btn-border-color:var(--border);" +
                "--bs-btn-hover-color:var(--wine-dark);--bs-btn-hover-bg:var(--pink-light);--bs-btn-hover-border-color:var(--wine);" +
                "--bs-btn-active-color:#fff;--bs-btn-active-bg:var(--wine);--bs-btn-active-border-color:var(--wine);";

    const $ = id => document.getElementById(id);
    const reducido = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    /* ---------- Estado ---------- */

    let est = { i: 0, r: {}, activo: false };

    const pantallas = ["vio-welcome", "vio-test", "vio-result"];

    function mostrar(id) {
        pantallas.forEach(s => $(s).classList.add("d-none"));
        const el = $(id);
        el.classList.remove("d-none", "show");
        el.classList.add("fade");
        void el.offsetWidth;
        el.classList.add("show");
    }

    function setProgreso(pct) {
        $("vio-bar").style.width = pct + "%";
        $("vio-progress").setAttribute("aria-valuenow", Math.round(pct));
    }

    function setMedidor(idx) {
        $("vio-cover").style.height = (100 - idx * 25) + "%";
        for (let n = 1; n <= 4; n++) {
            const li = $("vio-lvl-" + n);
            li.classList.toggle("bg-body-tertiary", idx === n);
            li.classList.toggle("opacity-50", idx !== 0 && idx !== n);
        }
    }

    /* ---------- Flujo del test ---------- */

    function iniciar() {
        ocultarTestimonios();
        est = { i: 0, r: {}, activo: true };
        setMedidor(0);
        mostrar("vio-test");
        pintarPregunta();
    }

    function pintarPregunta() {
        const p = P[est.i];
        const d = DIM[p.dim];
        const opciones = p.bin ? BIN : FREC;
        const guardada = est.r[p.id];
        const faltan = P.length - est.i - 1;

        $("vio-count").textContent = "Pregunta " + (est.i + 1) + " de " + P.length + (faltan <= 2 ? " · ¡Ya casi!" : "");
        $("vio-dim-badge").innerHTML = '<i class="bi ' + d.icono + ' me-1"></i>' + d.nombre;
        $("vio-dim-desc").textContent = d.desc;
        $("vio-q").textContent = p.t;
        setProgreso((est.i / P.length) * 100);

        const cont = $("vio-options");
        cont.innerHTML = "";
        opciones.forEach((op, k) => {
            const col = document.createElement("div");
            col.className = opciones.length === 3 ? "col-12 col-sm-4" : "col-6";
            const inputId = "vio-o-" + k;
            col.innerHTML =
                '<input type="radio" class="btn-check" name="vio-opt" id="' + inputId + '" autocomplete="off"' +
                (guardada === op.v ? " checked" : "") + '>' +
                '<label class="btn w-100 text-center py-3 rounded-3 border" style="' + OPT + '" for="' + inputId + '">' + op.t + '</label>';
            // Al tocar una opción se avanza sola: un toque por pregunta
            col.querySelector("input").addEventListener("click", () => {
                est.r[p.id] = op.v;
                const idx = est.i;
                setTimeout(() => { if (est.activo && est.i === idx) avanzar(); }, reducido ? 0 : 280);
            });
            cont.appendChild(col);
        });

        $("vio-prev").disabled = est.i === 0;
        mostrar("vio-test");
    }

    function avanzar() {
        if (est.i === P.length - 1) return finalizar();
        est.i++;
        pintarPregunta();
    }

    function omitir() {
        est.r[P[est.i].id] = null;
        avanzar();
    }

    function retroceder() {
        if (est.i > 0) { est.i--; pintarPregunta(); }
    }

    /* ---------- Resultado ---------- */

    function calcular() {
        const s = { control: 0, psicologica: 0, economica: 0, digital: 0, fisica: 0, sexual: 0 };
        let criticos = 0, ideacion = false;

        P.forEach(p => {
            const v = est.r[p.id];
            if (!v) return;
            if (p.bin) {
                if (p.id === "7.9") ideacion = true; else criticos++;
            } else {
                s[p.dim] += v;
            }
        });

        s.total = s.control + s.psicologica + s.economica + s.digital + s.fisica + s.sexual;
        return { s, criticos, ideacion };
    }

    // Cada dimensión suma de 0 a 4 (2 preguntas x 0-2). Umbrales equivalentes a los del test original.
    function clasificar(c) {
        const s = c.s;
        if (c.criticos > 0) return "rojo";
        if (s.fisica >= 2 || s.sexual >= 2) return "rojo";
        if (s.fisica >= 1 || s.sexual >= 1) return "naranja";

        const moderadas = [s.psicologica, s.economica, s.digital, s.control].filter(v => v >= 2).length;
        if (moderadas >= 2 || s.total >= 5) return "naranja";
        if (s.total >= 2) return "amarillo";
        return "verde";
    }

    function etiqueta(pct) {
        if (pct === 0) return "Sin señales";
        if (pct < 34) return "Leve";
        if (pct < 67) return "Moderada";
        return "Alta";
    }

    function finalizar() {
        const c = calcular();
        const clave = clasificar(c);
        const n = NIVELES[clave];

        setProgreso(100);

        const barras = ["control", "psicologica", "economica", "digital", "fisica", "sexual"].map(k => {
            const pct = Math.round((c.s[k] / 4) * 100);
            const d = DIM[k];
            return '<div class="col-12 col-sm-6">' +
                '<div class="d-flex justify-content-between small mb-1">' +
                    '<span class="fw-semibold">' + d.nombre + '</span>' +
                    '<span class="text-secondary">' + etiqueta(pct) + '</span>' +
                '</div>' +
                '<div class="progress" style="height: 6px;" role="progressbar" aria-label="' + d.nombre + '" aria-valuemin="0" aria-valuemax="100" aria-valuenow="' + pct + '">' +
                    '<div class="progress-bar" data-w="' + pct + '" style="width: 0%; background: var(--wine);"></div>' +
                '</div></div>';
        }).join("");

        const pasos = n.pasos.map(t =>
            '<li class="d-flex gap-2 mb-1"><i class="bi bi-check2" style="color: var(--wine);"></i><span>' + t + '</span></li>'
        ).join("");

        let alertas = "";
        if (c.criticos > 0) {
            alertas += '<div class="alert alert-danger small py-2 px-3 mb-2 d-flex gap-2 align-items-center" role="alert">' +
                '<i class="bi bi-exclamation-triangle-fill"></i>' +
                '<div>Marcaste <strong>' + c.criticos + '</strong> ' + (c.criticos === 1 ? "factor" : "factores") + ' de riesgo grave.</div></div>';
        }
        if (c.ideacion) {
            alertas += '<div class="alert alert-info small py-2 px-3 mb-2 d-flex gap-2 align-items-center" role="alert">' +
                '<i class="bi bi-heart-pulse-fill"></i>' +
                '<div>Mereces acompañamiento. <a class="alert-link" href="tel:8009112000">Línea de la Vida: 800 911 2000</a></div></div>';
        }

        const btnEmergencia = clave === "rojo"
            ? '<div class="text-center mb-3"><a href="tel:911" class="btn btn-danger btn-sm rounded-pill px-4"><i class="bi bi-telephone-fill me-2"></i>Llamar al 911</a></div>'
            : "";

        $("vio-result").innerHTML =
            '<div class="text-center mb-4">' +
                '<div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 ' + n.texto + '" style="width: 64px; height: 64px; font-size: 1.8rem; background: ' + n.color + ';">' +
                    '<i class="bi ' + n.icono + '"></i>' +
                '</div>' +
                '<h4 class="h5 fw-bold mb-2">' + n.titulo + '</h4>' +
                '<p class="text-secondary small mb-0">' + n.mensaje + '</p>' +
            '</div>' +
            btnEmergencia +
            alertas +
            '<h5 class="h6 fw-bold mt-4 mb-3">Señales por tipo de violencia</h5>' +
            '<div class="row g-3">' + barras + '</div>' +
            '<h5 class="small fw-bold text-uppercase text-secondary mt-4 mb-2">Qué puedes hacer</h5>' +
            '<ul class="list-unstyled small mb-4">' + pasos + '</ul>' +
            '<div class="d-flex flex-wrap justify-content-center align-items-center gap-2">' +
                '<a href="tel:8001084053" class="ws-primary-button" style="padding: 9px 20px; font-size: 0.8rem;"><i class="bi bi-telephone"></i>Llamar 800 10 84 053</a>' +
                '<a href="/mapa" class="btn btn-outline-secondary btn-sm rounded-pill px-3"><i class="bi bi-geo-alt me-1"></i>Instancias cercanas</a>' +
                '<button type="button" class="btn btn-link btn-sm text-secondary text-decoration-none" id="vio-restart"><i class="bi bi-arrow-repeat me-1"></i>Repetir test</button>' +
            '</div>';

        pintarTestimonios(clave);

        $("vio-restart").addEventListener("click", reiniciar);
        mostrar("vio-result");

        if (window.innerWidth < 992) {
            $("vio").scrollIntoView({ behavior: reducido ? "auto" : "smooth", block: "start" });
        }

        // Animación: el medidor sube y las barras se llenan
        setTimeout(() => setMedidor(n.idx), reducido ? 0 : 350);
        setTimeout(() => {
            $("vio-result").querySelectorAll("[data-w]").forEach(b => { b.style.width = b.dataset.w + "%"; });
        }, reducido ? 0 : 600);
    }

    function reiniciar() {
        ocultarTestimonios();
        est = { i: 0, r: {}, activo: false };
        setMedidor(0);
        setProgreso(0);
        mostrar("vio-welcome");
    }

    /* ---------- Salida rápida ---------- */

    function salir() {
        est = { i: 0, r: {}, activo: false };
        $("vio-result").innerHTML = "";
        window.location.replace("https://www.google.com.mx");
    }

    /* ---------- Eventos ---------- */

    $("vio-start").addEventListener("click", iniciar);
    $("vio-prev").addEventListener("click", retroceder);
    $("vio-skip").addEventListener("click", omitir);

    document.addEventListener("keydown", e => {
        if (e.key === "Escape" && est.activo) salir();
    });

})();
</script>