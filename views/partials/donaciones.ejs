      </div>

      <!-- IMPACTO DINÁMICO -->
      <div class="impact-box">
        <div class="icon-big">🎯</div>
        <p>
          <strong id="impactText">Con $250 MXN contribuyes a 1 sensor de la pulsera</strong>
          Cada aporte nos acerca a prototipar más unidades para el piloto.
        </p>
      </div>

      <!-- MÉTODOS DE PAGO -->
      <h2 style="font-size:1.1rem; margin-bottom:1rem;"><span class="icon">💳</span> Método de pago (simulado)</h2>
      <div class="payment-methods" role="radiogroup" aria-label="Método de pago">
        <label class="payment-option selected" data-method="paypal">
          <input type="radio" name="payment" value="paypal" checked />
          <div class="payment-logo logo-paypal">PayPal</div>
          <div class="payment-info">
            <strong>PayPal</strong>
            <small>Pago seguro con tu cuenta o tarjeta</small>
          </div>
          <div class="radio-indicator"></div>
        </label>

        <label class="payment-option" data-method="stripe">
          <input type="radio" name="payment" value="stripe" />
          <div class="payment-logo logo-stripe">stripe</div>
          <div class="payment-info">
            <strong>Stripe</strong>
            <small>Tarjetas de crédito y débito</small>
          </div>
          <div class="radio-indicator"></div>
        </label>

        <label class="payment-option" data-method="paynet">
          <input type="radio" name="payment" value="paynet" />
          <div class="payment-logo logo-paynet">Paynet</div>
          <div class="payment-info">
            <strong>Paynet</strong>
            <small>Pago en efectivo en tiendas</small>
          </div>
          <div class="radio-indicator"></div>
        </label>

        <label class="payment-option" data-method="spei">
          <input type="radio" name="payment" value="spei" />
          <div class="payment-logo logo-spei">SPEI</div>
          <div class="payment-info">
            <strong>Transferencia SPEI</strong>
            <small>Desde tu app bancaria (simulada)</small>
          </div>
          <div class="radio-indicator"></div>
