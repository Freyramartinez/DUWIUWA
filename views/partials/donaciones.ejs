      <!-- TÉRMINOS Y CONDICIONES -->
      <label class="terms" for="termsCheck">
        <input type="checkbox" id="termsCheck" />
        <span>
          He leído y acepto los <a href="#" id="openTerms">Términos y Condiciones</a> y el
          <a href="#" id="openPrivacy">Aviso de Privacidad</a> de WOMEN SAFETY. Entiendo que esta
          es una <strong>simulación de pago</strong> con fines académicos y que no se realizará
          ningún cargo real.
        </span>
      </label>

      <!-- BOTÓN DONAR -->
      <button class="btn-donate" id="donateBtn" disabled>
        <span>🔒</span> Donar ahora
      </button>

      <div class="secure-note">
        <span>🛡️</span> Pago simulado · No se realizan cargos reales
      </div>
    </section>

    <!-- COLUMNA DERECHA: SIDEBAR -->
    <aside>
      <!-- PROGRESO -->
      <div class="sidebar-card">
        <h3>🚀 Meta del proyecto</h3>
        <div class="progress-track">
          <div class="progress-fill" id="progressFill"></div>
