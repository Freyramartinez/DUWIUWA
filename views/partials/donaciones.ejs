<%#
  =====================================================================
  PARTIAL: views/partials/donaciones.ejs  ·  WOMEN SAFETY
  Sección de donaciones.
  Uso en cualquier vista:  include('partials/donaciones')
  Con valores propios:     include('partials/donaciones', { donaciones: { meta, recaudado, donantes } })
  (Nunca escribir etiquetas EJS completas dentro de este comentario.)
  =====================================================================
%>
<%
  const cfgDon = Object.assign(
    { meta: 45000, recaudado: 18650, donantes: 37, costoPulsera: 1200, montoInicial: 500 },
    (typeof donaciones !== 'undefined' && donaciones) ? donaciones : {}
  );
  const mx = n => '$' + Number(n).toLocaleString('es-MX');
%>

<style>
/* =========================================================
   SECCIÓN DE DONACIONES · WOMEN SAFETY
   ========================================================= */
.ws-don{
  --ws-primary:var(--wine,#8e3a68);
  --ws-primary-dark:var(--wine-dark,#67294c);
  --ws-accent:var(--pink,#b34d83);
  --ws-soft:var(--pink-light,#f8e8f1);
  --ws-ink:var(--dark,#2b1d25);
  --ws-muted:var(--gray,#6f6470);
  --ws-line:var(--border,#efdbe6);
  --ws-ok:#1f8a5b;
  --ws-warn-bg:#fff6e0;
  --ws-warn-ink:#7a5300;
  --ws-radius:18px;
  font-family:"Inter",system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
  color:var(--ws-ink);
  background:linear-gradient(135deg,#fff8fb 0%,#ffffff 55%,#f8e8f1 100%);
  padding:96px 16px;
  line-height:1.55;
}
.ws-don *,.ws-don *::before,.ws-don *::after{box-sizing:border-box}
.ws-don .wrap{max-width:1120px;margin:0 auto}

/* Encabezado */
.ws-don .eyebrow{letter-spacing:.14em;font-size:.78rem;font-weight:700;color:var(--ws-accent);text-transform:uppercase}
.ws-don h2{font-family:"Playfair Display",serif;font-weight:500;font-size:clamp(2.2rem,4vw,3.4rem);line-height:1.1;margin:.3em 0 .45em;color:var(--ws-ink)}
.ws-don .lead{max-width:680px;color:var(--ws-muted);font-size:1.05rem;margin:0}

.ws-don .grid{display:grid;grid-template-columns:1.05fr .95fr;gap:32px;margin-top:40px;align-items:start}
@media (max-width:900px){.ws-don .grid{grid-template-columns:1fr}}

.ws-don .card{background:#fff;border:1px solid var(--ws-line);border-radius:var(--ws-radius);padding:24px;box-shadow:0 10px 30px -18px rgba(103,41,76,.35)}

/* Meta / progreso */
.ws-don .goal-top{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap}
.ws-don .goal-amount{font-size:1.9rem;font-weight:800;color:var(--ws-primary)}
.ws-don .goal-of{color:var(--ws-muted);font-size:.95rem}
.ws-don .bar{height:14px;background:var(--ws-soft);border-radius:99px;overflow:hidden;margin:14px 0 10px}
.ws-don .bar > span{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--ws-primary),var(--ws-accent));border-radius:99px;transition:width .9s ease}
.ws-don .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:16px}
.ws-don .stat{background:var(--ws-soft);border-radius:12px;padding:12px;text-align:center}
.ws-don .stat b{display:block;font-size:1.25rem;color:var(--ws-primary-dark)}
.ws-don .stat small{color:var(--ws-muted);font-size:.8rem}

/* Impacto */
.ws-don h3{font-size:1.15rem;margin:28px 0 12px;color:var(--ws-primary-dark)}
.ws-don .impact{display:grid;gap:12px}
.ws-don .impact-item{display:flex;gap:14px;align-items:flex-start;background:#fff;border:1px solid var(--ws-line);border-radius:14px;padding:14px 16px;cursor:pointer;transition:border-color .2s,transform .2s;text-align:left;width:100%;font:inherit;color:inherit}
.ws-don .impact-item:hover{border-color:var(--ws-primary);transform:translateY(-2px)}
.ws-don .impact-item .price{flex:none;min-width:78px;font-weight:800;color:var(--ws-accent);font-size:1.05rem}
.ws-don .impact-item p{margin:2px 0 0;color:var(--ws-muted);font-size:.9rem}
.ws-don .impact-item strong{font-size:.98rem}

.ws-don .transp{margin-top:20px;font-size:.88rem;color:var(--ws-muted);background:#fff;border-left:4px solid var(--ws-primary);border-radius:8px;padding:12px 14px}

/* Formulario */
.ws-don .form-card h3{margin-top:0}
.ws-don .seg{display:grid;grid-template-columns:1fr 1fr;background:var(--ws-soft);border-radius:12px;padding:4px;margin-bottom:18px}
.ws-don .seg button{border:0;background:transparent;padding:10px;border-radius:9px;font:inherit;font-weight:600;color:var(--ws-muted);cursor:pointer}
.ws-don .seg button.active{background:#fff;color:var(--ws-primary-dark);box-shadow:0 2px 8px rgba(0,0,0,.08)}

.ws-don .label{display:block;font-weight:600;font-size:.9rem;margin:16px 0 8px}
.ws-don .amounts{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
@media (max-width:420px){.ws-don .amounts{grid-template-columns:repeat(2,1fr)}}
.ws-don .amounts button{border:1.5px solid var(--ws-line);background:#fff;border-radius:10px;padding:11px 6px;font:inherit;font-weight:700;color:var(--ws-ink);cursor:pointer}
.ws-don .amounts button.active{border-color:var(--ws-primary);background:var(--ws-soft);color:var(--ws-primary-dark)}

.ws-don input[type=text],.ws-don input[type=email],.ws-don input[type=number]{
  width:100%;padding:12px 14px;border:1.5px solid var(--ws-line);border-radius:10px;font:inherit;color:var(--ws-ink);background:#fff;outline:none;transition:border-color .2s
}
.ws-don input:focus{border-color:var(--ws-primary)}
.ws-don .row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
@media (max-width:420px){.ws-don .row{grid-template-columns:1fr}}
.ws-don .custom{position:relative;margin-top:8px}
.ws-don .custom span{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--ws-muted);font-weight:600}
.ws-don .custom input{padding-left:28px}

.ws-don .check{display:flex;gap:10px;align-items:flex-start;font-size:.9rem;margin-top:12px;cursor:pointer}
.ws-don .check input{margin-top:3px;accent-color:var(--ws-primary);width:17px;height:17px;flex:none}

/* Métodos de pago */
.ws-don .methods{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.ws-don .method{border:1.5px solid var(--ws-line);background:#fff;border-radius:12px;padding:12px 6px;cursor:pointer;font:inherit;text-align:center;color:var(--ws-ink)}
.ws-don .method b{display:block;font-size:.98rem}
.ws-don .method small{color:var(--ws-muted);font-size:.75rem}
.ws-don .method.active{border-color:var(--ws-primary);background:var(--ws-soft)}
.ws-don .panel{display:none;margin-top:14px;background:var(--ws-soft);border-radius:12px;padding:14px}
.ws-don .panel.show{display:block}
.ws-don .panel p{margin:0 0 8px;font-size:.88rem;color:var(--ws-muted)}
.ws-don .panel .row + .row,.ws-don .panel input + .row{margin-top:8px}
.ws-don .err{color:#b3261e;font-size:.82rem;min-height:1.1em;margin-top:6px}

.ws-don .summary{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--ws-line);margin-top:20px;padding-top:16px;font-size:.95rem}
.ws-don .summary b{font-size:1.3rem;color:var(--ws-primary-dark)}

.ws-don .ws-btn{display:inline-flex;justify-content:center;align-items:center;gap:8px;width:100%;margin-top:14px;padding:14px 18px;border:0;border-radius:12px;font:inherit;font-weight:700;font-size:1rem;color:#fff;cursor:pointer;background:linear-gradient(90deg,var(--ws-primary),var(--ws-accent));transition:opacity .2s,transform .2s}
.ws-don .ws-btn:hover:not(:disabled){transform:translateY(-1px)}
.ws-don .ws-btn:disabled{opacity:.45;cursor:not-allowed}
.ws-don .ws-btn.ghost{background:#fff;color:var(--ws-primary-dark);border:1.5px solid var(--ws-line)}
.ws-don .linkish{background:none;border:0;padding:0;font:inherit;color:var(--ws-primary);text-decoration:underline;cursor:pointer}
.ws-don .secure{text-align:center;font-size:.8rem;color:var(--ws-muted);margin-top:10px}

.ws-don .spinner{width:18px;height:18px;border:2.5px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:wsspin .8s linear infinite}
@keyframes wsspin{to{transform:rotate(360deg)}}

/* FAQ */
.ws-don .faq{margin-top:48px}
.ws-don details{background:#fff;border:1px solid var(--ws-line);border-radius:12px;padding:14px 18px;margin-bottom:10px}
.ws-don summary{cursor:pointer;font-weight:600}
.ws-don details p{margin:10px 0 0;color:var(--ws-muted);font-size:.93rem}

/* Modales */
.ws-don dialog{border:0;border-radius:var(--ws-radius);padding:0;max-width:560px;width:calc(100% - 32px);box-shadow:0 30px 60px -20px rgba(0,0,0,.45);color:var(--ws-ink)}
.ws-don dialog::backdrop{background:rgba(35,27,46,.55)}
.ws-don .dlg-head{padding:20px 24px 12px;border-bottom:1px solid var(--ws-line);display:flex;justify-content:space-between;align-items:center;gap:12px}
.ws-don .dlg-head h4{margin:0;font-size:1.15rem;color:var(--ws-primary-dark)}
.ws-don .dlg-close{background:none;border:0;font-size:1.5rem;line-height:1;cursor:pointer;color:var(--ws-muted)}
.ws-don .dlg-body{padding:16px 24px;max-height:55vh;overflow:auto;font-size:.9rem}
.ws-don .dlg-body h5{font-size:.95rem;margin:16px 0 4px;color:var(--ws-primary-dark)}
.ws-don .dlg-body p,.ws-don .dlg-body li{color:var(--ws-muted)}
.ws-don .dlg-foot{padding:12px 24px 20px;border-top:1px solid var(--ws-line)}
.ws-don .dlg-foot small{display:block;color:var(--ws-muted);font-size:.78rem;margin-bottom:6px;text-align:center}

/* Recibo */
.ws-don .receipt{position:relative;background:var(--ws-soft);border-radius:12px;padding:16px;overflow:hidden}
.ws-don .receipt dl{display:grid;grid-template-columns:auto 1fr;gap:6px 14px;margin:0}
.ws-don .receipt dt{color:var(--ws-muted)}
.ws-don .receipt dd{margin:0;font-weight:600;word-break:break-word}
.ws-don .ok-ico{width:56px;height:56px;border-radius:50%;background:#e3f4ec;color:var(--ws-ok);display:grid;place-items:center;font-size:1.7rem;margin:0 auto 10px}
.ws-don .barcode{height:54px;margin-top:14px;background:repeating-linear-gradient(90deg,#231b2e 0 2px,transparent 2px 4px,#231b2e 4px 5px,transparent 5px 8px,#231b2e 8px 11px,transparent 11px 13px);border-radius:4px;opacity:.85}
.ws-don .ref{font-family:ui-monospace,Menlo,Consolas,monospace;letter-spacing:.12em;text-align:center;margin-top:6px;font-weight:700}

/* Confirmación de cobro */
.ws-don .confirm-total{text-align:center;padding:8px 0 16px}
.ws-don .confirm-total small{display:block;color:var(--ws-muted);font-size:.85rem}
.ws-don .confirm-total b{display:block;font-size:2.2rem;color:var(--ws-primary-dark);line-height:1.2}
.ws-don .confirm-total .freq{display:inline-block;margin-top:4px;background:var(--ws-soft);color:var(--ws-primary-dark);border-radius:99px;padding:2px 12px;font-size:.8rem;font-weight:700}
.ws-don .confirm-list{display:grid;grid-template-columns:auto 1fr;gap:8px 14px;margin:0;background:var(--ws-soft);border-radius:12px;padding:14px 16px}
.ws-don .confirm-list dt{color:var(--ws-muted)}
.ws-don .confirm-list dd{margin:0;font-weight:600;text-align:right;word-break:break-word}
.ws-don .confirm-note{font-size:.82rem;background:#e3f4ec;color:var(--ws-ok);border-radius:10px;padding:10px 12px;margin:14px 0 0}
.ws-don .dlg-actions{display:grid;grid-template-columns:1fr 1.4fr;gap:10px}
.ws-don .dlg-actions .ws-btn{margin-top:0}
.ws-don .form-err{color:#b3261e;font-size:.85rem;min-height:1.1em;margin-top:8px;text-align:center}
.ws-don .seg button:disabled{opacity:.4;cursor:not-allowed}
.ws-don .card-ok{display:none;align-items:center;gap:8px;color:var(--ws-ok);font-size:.85rem;font-weight:700;margin-top:8px}
.ws-don .card-ok.show{display:flex}
.ws-don .card-ok .dot{width:20px;height:20px;border-radius:50%;background:#e3f4ec;display:grid;place-items:center;font-size:.75rem}
.ws-don input.valid{border-color:var(--ws-ok)!important;background:#f6fcf9}
.ws-don input.invalid{border-color:#b3261e!important}
.ws-don .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
</style>

<section id="donaciones" class="ws-don" aria-labelledby="ws-don-title">
  <div class="wrap">

    <span class="eyebrow">Impulsa el proyecto</span>
    <h2 id="ws-don-title">Cada aporte acerca una pulsera a quien la necesita.</h2>
    <p class="lead">La pulsera WOMEN SAFETY envía alertas silenciosas con ubicación GPS a través de LoRa, incluso sin señal celular. Tu donativo ayuda a fabricar prototipos, instalar antenas y llevar el piloto a más comunidades de Hidalgo.</p>

    <div class="grid">
      <!-- Columna izquierda: meta e impacto -->
      <div>
        <div class="card">
          <div class="goal-top">
            <div><span class="goal-amount" id="ws-raised"><%= mx(cfgDon.recaudado) %></span> <span class="goal-of">recaudados de <b id="ws-goal"><%= mx(cfgDon.meta) %></b> MXN</span></div>
            <span class="goal-of" id="ws-pct">0%</span>
          </div>
          <div class="bar" role="progressbar" aria-label="Avance de la meta" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="ws-bar"><span></span></div>
          <small class="goal-of">Meta del Kit Piloto SafeWave Tlahuelilpan</small>
          <div class="stats">
            <div class="stat"><b id="ws-donors"><%= cfgDon.donantes %></b><small>donantes</small></div>
            <div class="stat"><b id="ws-bands"><%= Math.floor(cfgDon.recaudado / cfgDon.costoPulsera) %></b><small>pulseras financiadas</small></div>
            <div class="stat"><b>1</b><small>antena gateway por instalar</small></div>
          </div>
        </div>

        <h3>¿Qué financia tu aporte?</h3>
        <div class="impact">
          <button type="button" class="impact-item" data-amount="150">
            <span class="price">$150</span>
            <span><strong>Componentes básicos</strong><p>Motor de vibración, botón y batería para la confirmación silenciosa.</p></span>
          </button>
          <button type="button" class="impact-item" data-amount="500">
            <span class="price">$500</span>
            <span><strong>Pantalla y carcasa</strong><p>OLED discreta y carcasa impresa en 3D para un prototipo.</p></span>
          </button>
          <button type="button" class="impact-item" data-amount="1200">
            <span class="price">$1,200</span>
            <span><strong>Una pulsera completa</strong><p>Módulo LilyGO T‑Beam con LoRa 915 MHz y GPS, listo para implementarse.</p></span>
          </button>
          <button type="button" class="impact-item" data-amount="5000">
            <span class="price">$5,000</span>
            <span><strong>Cobertura para una zona</strong><p>Aporte para la antena base LoRaWAN que conecta a la Instancia de la Mujer.</p></span>
          </button>
        </div>

        <div class="transp">
          <strong>Transparencia:</strong> Cada peso donado se reporta en nuestro informe público de avances y financia directamente la fabricación de pulseras e infraestructura.
        </div>
      </div>

      <!-- Columna derecha: formulario -->
      <form class="card form-card" id="ws-form" novalidate>
        <h3>Haz tu donativo</h3>

        <div class="seg" role="tablist" aria-label="Frecuencia">
          <button type="button" class="active" data-freq="unica" role="tab" aria-selected="true">Única vez</button>
          <button type="button" data-freq="mensual" role="tab" aria-selected="false">Mensual</button>
        </div>

        <span class="label">Monto (MXN)</span>
        <div class="amounts" id="ws-amounts">
          <button type="button" data-amount="150">$150</button>
          <button type="button" data-amount="500" class="active">$500</button>
          <button type="button" data-amount="1200">$1,200</button>
          <button type="button" data-amount="5000">$5,000</button>
        </div>
        <div class="custom">
          <span>$</span>
          <label class="sr" for="ws-custom">Otro monto</label>
          <input type="number" id="ws-custom" min="20" max="50000" step="1" placeholder="Otro monto (mín. $20)">
        </div>

        <span class="label">Tus datos</span>
        <div class="row">
          <input type="text" id="ws-name" placeholder="Nombre" autocomplete="name">
          <input type="email" id="ws-email" placeholder="Correo (para el recibo)" autocomplete="email">
        </div>
        <label class="check"><input type="checkbox" id="ws-anon"> Donar de forma anónima</label>

        <span class="label">Método de pago</span>
        <div class="methods" role="radiogroup" aria-label="Método de pago">
          <button type="button" class="method active" data-method="paypal" role="radio" aria-checked="true"><b>PayPal</b><small>Seguro</small></button>
          <button type="button" class="method" data-method="stripe" role="radio" aria-checked="false"><b>Tarjeta</b><small>Crédito/Débito</small></button>
          <button type="button" class="method" data-method="paynet" role="radio" aria-checked="false"><b>Paynet</b><small>Efectivo</small></button>
        </div>

        <div class="panel show" data-panel="paypal">
          <p>Al confirmar serás redirigido al entorno seguro de PayPal para completar tu pago.</p>
        </div>

        <div class="panel" data-panel="stripe">
          <p>Pago procesado de forma segura mediante cifrado de extremo a extremo.</p>
          <input type="text" id="ws-card" inputmode="numeric" placeholder="Número de tarjeta" maxlength="19" autocomplete="off">
          <div class="row">
            <input type="text" id="ws-exp" placeholder="MM/AA" maxlength="5" autocomplete="off">
            <input type="text" id="ws-cvc" placeholder="CVC" maxlength="4" inputmode="numeric" autocomplete="off">
          </div>
          <div class="card-ok" id="ws-card-ok" role="status"><span class="dot">✓</span><span id="ws-card-ok-text">Tarjeta válida</span></div>
          <div class="err" id="ws-card-err"></div>
        </div>

        <div class="panel" data-panel="paynet">
          <p>Se generará una <b>referencia de pago</b> que podrás presentar en cualquier tienda de conveniencia afiliada.</p>
        </div>

        <label class="check">
          <input type="checkbox" id="ws-terms">
          <span>He leído y acepto los <button type="button" class="linkish" id="ws-open-terms">Términos y condiciones</button> y el <a href="/privacidad" class="linkish">Aviso de privacidad</a>.</span>
        </label>

        <div class="summary">
          <span id="ws-sum-label">Donativo único</span>
          <b id="ws-sum">$500 MXN</b>
        </div>

        <button type="submit" class="ws-btn" id="ws-submit" disabled > 
          <span id="ws-submit-text">Acepta los términos para continuar</span>
        </button>
        <div class="form-err" id="ws-form-err" role="alert"></div>
        <p class="secure">🔒 Transacción encriptada y segura</p>
      </form>
    </div>

    <div class="faq">
      <h3>Preguntas frecuentes</h3>
      <details>
        <summary>¿Es seguro mi pago?</summary>
        <p>Sí, procesamos todas las transacciones a través de pasarelas de pago certificadas internacionalmente con altos estándares de seguridad y cifrado.</p>
      </details>
      <details>
        <summary>¿Qué pasa con mis datos financieros?</summary>
        <p>Tus datos de tarjetas o cuentas nunca tocan nuestros servidores. Todo se procesa directamente en los servidores encriptados de nuestros proveedores de pago.</p>
      </details>
      <details>
        <summary>¿Dónde puedo ver en qué se usa el dinero?</summary>
        <p>Publicamos cortes mensuales de nuestros avances. Los fondos se invierten directamente en hardware (módulos, baterías, antenas LoRa) para escalar el proyecto y proteger a más mujeres.</p>
      </details>
      <details>
        <summary>¿Cómo puedo apoyar de otra forma?</summary>
        <p>Compartiendo la plataforma, difundiendo las líneas de apoyo o escribiéndonos desde la sección de contacto para colaborar de manera institucional.</p>
      </details>
    </div>
  </div>

  <!-- Modal: Términos y condiciones -->
  <dialog id="ws-terms-dlg" aria-labelledby="ws-terms-title">
    <div class="dlg-head">
      <h4 id="ws-terms-title">Términos y condiciones de donativos</h4>
      <button type="button" class="dlg-close" data-close aria-label="Cerrar">×</button>
    </div>
    <div class="dlg-body" id="ws-terms-body">
      <p>Última actualización: octubre de 2026.</p>
      <h5>1. Naturaleza del donativo</h5>
      <p>Al realizar un aporte a WOMEN SAFETY, confirmas que los fondos son entregados de manera voluntaria y sin esperar una contraprestación comercial directa. Todos los fondos se destinan al desarrollo tecnológico e infraestructura del proyecto.</p>
      <h5>2. Proyecto académico</h5>
      <p>WOMEN SAFETY es un proyecto estudiantil del ITSOEH. En esta etapa la plataforma no realiza cargos reales ni envía datos de pago a ningún servidor, y solo acepta tarjetas de prueba. Los folios y referencias generados no tienen validez fiscal ni comercial.</p>
      <h5>3. Procesamiento de pagos</h5>
      <p>Cuando el proyecto opere con donativos reales, las transacciones se realizarán a través de procesadores de pago (PayPal, Stripe, Paynet) y no se almacenará información de tarjetas.</p>
      <h5>4. Uso de datos personales</h5>
      <p>El nombre y correo electrónico proporcionados (a menos que elijas donar de forma anónima) se utilizarán exclusivamente para enviar tu recibo de donación e informes de impacto. Nunca venderemos ni compartiremos tus datos con terceros.</p>
      <h5>5. Aceptación</h5>
      <p>Al marcar la casilla de aceptación confirmas que has leído estos términos y autorizas el cargo por el monto seleccionado.</p>
    </div>
    <div class="dlg-foot">
      <small id="ws-scroll-hint">Desplázate hasta el final para aceptar</small>
      <button type="button" class="ws-btn" id="ws-accept" disabled>Acepto los términos</button>
    </div>
  </dialog>

  <!-- Modal: Confirmar cobro -->
  <dialog id="ws-confirm-dlg" aria-labelledby="ws-confirm-title">
    <div class="dlg-head">
      <h4 id="ws-confirm-title">Confirma tu donativo</h4>
      <button type="button" class="dlg-close" data-close aria-label="Cerrar">×</button>
    </div>
    <div class="dlg-body">
      <div class="confirm-total">
        <small>Se realizará un cargo por</small>
        <b id="ws-c-amount">$0 MXN</b>
        <span class="freq" id="ws-c-freq">Pago único</span>
      </div>
      <dl class="confirm-list">
        <dt>Donante</dt><dd id="ws-c-who">—</dd>
        <dt>Correo</dt><dd id="ws-c-email">—</dd>
        <dt>Método</dt><dd id="ws-c-method">—</dd>
        <dt id="ws-c-extra-l">Detalle</dt><dd id="ws-c-extra">—</dd>
        <dt>Destino</dt><dd>Proyecto pulsera WOMEN SAFETY</dd>
      </dl>
      <label class="check" style="margin-top:14px">
        <input type="checkbox" id="ws-c-ok">
        <span>Confirmo que revisé el monto y autorizo este cobro.</span>
      </label>
      <p class="confirm-note">Tu transacción se procesará de forma segura y encriptada.</p>
    </div>
    <div class="dlg-foot dlg-actions">
      <button type="button" class="ws-btn ghost" data-close>Cancelar</button>
      <button type="button" class="ws-btn" id="ws-c-go" disabled><span id="ws-c-go-text">Confirmar cobro</span></button>
    </div>
  </dialog>

  <!-- Modal: Resultado -->
  <dialog id="ws-result-dlg" aria-labelledby="ws-result-title">
    <div class="dlg-head">
      <h4 id="ws-result-title">Resultado</h4>
      <button type="button" class="dlg-close" data-close aria-label="Cerrar">×</button>
    </div>
    <div class="dlg-body" id="ws-result-body"></div>
    
    <div class="dlg-foot">
      <!-- Botón de PDF (Oculto por defecto, se muestra solo si el pago fue exitoso) -->
      <button type="button" class="ws-btn" id="ws-download-pdf" style="display:none; margin-bottom:10px; background-color:#6a1b9a;">
        Descargar Ticket PDF
      </button>
      
      <button type="button" class="ws-btn ghost" data-close>Cerrar</button>
    </div>

  </dialog>
</section>

<script>
(function(){
  const root = document.getElementById('donaciones');
  const $ = s => root.querySelector(s);
  const $$ = s => [...root.querySelectorAll(s)];
  const fmt = n => '$' + Number(n).toLocaleString('es-MX');

  // Estado inicial
  const CFG = <%- JSON.stringify({ meta: Number(cfgDon.meta), recaudado: Number(cfgDon.recaudado), donantes: Number(cfgDon.donantes), costoPulsera: Number(cfgDon.costoPulsera), montoInicial: Number(cfgDon.montoInicial) }) %>;
  const GOAL = CFG.meta;
  const state = { raised: CFG.recaudado, donors: CFG.donantes, amount: CFG.montoInicial, freq: 'unica', method: 'paypal' };

  function renderGoal(){
    const pct = Math.min(100, Math.round(state.raised / GOAL * 100));
    $('#ws-raised').textContent = fmt(state.raised);
    $('#ws-goal').textContent = fmt(GOAL);
    $('#ws-pct').textContent = pct + '%';
    $('#ws-bar').setAttribute('aria-valuenow', pct);
    $('#ws-bar span').style.width = pct + '%';
    $('#ws-donors').textContent = state.donors;
    $('#ws-bands').textContent = Math.floor(state.raised / CFG.costoPulsera);
  }
  function renderSummary(){
    $('#ws-sum').textContent = fmt(state.amount || 0) + ' MXN' + (state.freq === 'mensual' ? '/mes' : '');
    $('#ws-sum-label').textContent = state.freq === 'mensual' ? 'Donativo mensual' : 'Donativo único';
  }
  function setAmount(v){
    state.amount = v;
    $$('#ws-amounts button').forEach(b => b.classList.toggle('active', Number(b.dataset.amount) === v));
    renderSummary();
  }

  // Montos
  $$('#ws-amounts button').forEach(b => b.addEventListener('click', () => {
    $('#ws-custom').value = '';
    setAmount(Number(b.dataset.amount));
  }));
  $('#ws-custom').addEventListener('input', e => setAmount(Number(e.target.value) || 0));
  $$('.impact-item').forEach(b => b.addEventListener('click', () => {
    $('#ws-custom').value = '';
    setAmount(Number(b.dataset.amount));
    $('#ws-form').scrollIntoView({behavior:'smooth', block:'start'});
  }));

  // Frecuencia
  $$('.seg button').forEach(b => b.addEventListener('click', () => {
    $$('.seg button').forEach(x => { x.classList.remove('active'); x.setAttribute('aria-selected','false'); });
    b.classList.add('active'); b.setAttribute('aria-selected','true');
    state.freq = b.dataset.freq; renderSummary();
  }));

  // Anónimo
  $('#ws-anon').addEventListener('change', e => {
    $('#ws-name').disabled = e.target.checked;
    if (e.target.checked) $('#ws-name').value = '';
  });

  // Métodos
  $$('.method').forEach(b => b.addEventListener('click', () => {
    $$('.method').forEach(x => { x.classList.remove('active'); x.setAttribute('aria-checked','false'); });
    b.classList.add('active'); b.setAttribute('aria-checked','true');
    state.method = b.dataset.method;
    $$('.panel').forEach(p => p.classList.toggle('show', p.dataset.panel === state.method));
    // Efectivo no puede ser recurrente
    const mensual = $('.seg [data-freq="mensual"]');
    mensual.disabled = state.method === 'paynet';
    mensual.title = mensual.disabled ? 'El pago en efectivo solo admite donativo único' : '';
    if (mensual.disabled && state.freq === 'mensual') $('.seg [data-freq="unica"]').click();
    updateSubmit();
  }));

  // Formato de tarjeta
  // Tarjetas aceptadas (de prueba)
  const TEST_OK = '4242424242424242', TEST_DECLINE = '4000000000000002';

  $('#ws-card').addEventListener('input', e => {
    const d = e.target.value.replace(/\D/g,'').slice(0,16);
    e.target.value = d.replace(/(.{4})/g,'$1 ').trim();
    liveCard();
  });
  $('#ws-exp').addEventListener('input', e => {
    let d = e.target.value.replace(/\D/g,'').slice(0,4);
    if (d.length > 2) d = d.slice(0,2) + '/' + d.slice(2);
    e.target.value = d;
    liveCard();
  });
  $('#ws-cvc').addEventListener('input', e => {
    e.target.value = e.target.value.replace(/\D/g,'');
    liveCard();
  });

  function expValid(v){
    const m = v.match(/^(\d{2})\/(\d{2})$/);
    return !!m && +m[1] >= 1 && +m[1] <= 12 && new Date(2000 + +m[2], +m[1], 0) >= new Date();
  }

  // Marca en verde/rojo mientras se escribe
  function liveCard(){
    const card = $('#ws-card'), exp = $('#ws-exp'), cvc = $('#ws-cvc'), err = $('#ws-card-err');
    const n = card.value.replace(/\s/g,'');
    const numOk = n === TEST_OK || n === TEST_DECLINE;
    const expOk = expValid(exp.value);
    const cvcOk = cvc.value.length >= 3;
    card.classList.toggle('valid', numOk);
    card.classList.toggle('invalid', n.length === 16 && !numOk);
    exp.classList.toggle('valid', expOk);
    exp.classList.toggle('invalid', exp.value.length === 5 && !expOk);
    cvc.classList.toggle('valid', cvcOk);
    if (n.length === 16 && !numOk) err.textContent = 'Número de tarjeta no válido.';
    else if (exp.value.length === 5 && !expOk) err.textContent = 'La fecha no es válida o la tarjeta expiró.';
    else err.textContent = '';
    $('#ws-card-ok').classList.toggle('show', numOk);
    $('#ws-card-ok-text').textContent = (numOk && expOk && cvcOk)
      ? 'Tarjeta Visa •••• ' + n.slice(-4) + ' verificada'
      : 'Tarjeta Visa válida';
  }

  // Términos
  const termsDlg = $('#ws-terms-dlg');
  const termsBody = $('#ws-terms-body');
  $('#ws-open-terms').addEventListener('click', () => {
    termsDlg.showModal();
    checkScroll();
  });
  function checkScroll(){
    const end = termsBody.scrollTop + termsBody.clientHeight >= termsBody.scrollHeight - 8;
    if (end){ $('#ws-accept').disabled = false; $('#ws-scroll-hint').textContent = 'Gracias por leer'; }
  }
  termsBody.addEventListener('scroll', checkScroll);
  $('#ws-accept').addEventListener('click', () => {
    $('#ws-terms').checked = true; termsDlg.close(); updateSubmit();
  });
  $('#ws-terms').addEventListener('change', updateSubmit);

  $$('[data-close]').forEach(b => b.addEventListener('click', () => b.closest('dialog').close()));

  function updateSubmit(){
    const ok = $('#ws-terms').checked;
    $('#ws-submit').disabled = !ok;
    const labels = { paypal:'Revisar y confirmar · PayPal', stripe:'Revisar y confirmar · Tarjeta', paynet:'Revisar y confirmar · Paynet' };
    $('#ws-submit').innerHTML = '<span id="ws-submit-text">' + (ok ? labels[state.method] : 'Acepta los términos para continuar') + '</span>';
  }

  // Validación de tarjeta general
  // Devuelve '' si es válida, 'DECLINE' si el banco la rechaza, o el mensaje de error
    function validateCard(){
    const n = $('#ws-card').value.replace(/\s/g,'');
    const exp = $('#ws-exp').value, cvc = $('#ws-cvc').value;
    
    // Aceptar cualquier tarjeta de 16 dígitos
    if (n.length !== 16) return 'El número de tarjeta debe tener 16 dígitos.';
    if (!/^\d{2}\/\d{2}$/.test(exp)) return 'Fecha inválida (MM/AA).';
    if (!expValid(exp)) return 'La tarjeta ingresada ha expirado.';
    if (cvc.length < 3) return 'CVC inválido.';
    
    
    return n === TEST_DECLINE ? 'DECLINE' : '';
  }

  const folio = p => p + '-' + Date.now().toString(36).toUpperCase().slice(-6);
  const resultDlg = $('#ws-result-dlg');
  const confirmDlg = $('#ws-confirm-dlg');
  const methodNames = { paypal:'PayPal', stripe:'Tarjeta Crédito/Débito', paynet:'Pago en Efectivo' };
  let pending = null;

  function formError(msg){ $('#ws-form-err').textContent = msg || ''; }
  root.addEventListener('input', () => formError(''));

  // Paso 1: validar y abrir la confirmación
  $('#ws-form').addEventListener('submit', e => {
    e.preventDefault();
    formError('');
    if (!state.amount || state.amount < 20){ formError('Ingresa un monto de al menos $20.'); return; }
    if (state.amount > 50000){ formError('El monto máximo por donativo es de $50,000.'); return; }
    const email = $('#ws-email').value.trim();
    if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){ formError('Revisa el formato del correo.'); return; }

    let extra = '', declined = false;
    if (state.method === 'stripe'){
      const r = validateCard();
      if (r && r !== 'DECLINE'){ $('#ws-card-err').textContent = r; return; }
      declined = r === 'DECLINE';
      extra = 'Visa •••• ' + $('#ws-card').value.replace(/\s/g,'').slice(-4);
    } else if (state.method === 'paypal'){
      extra = 'Pago seguro con PayPal';
    } else {
      extra = 'Referencia para pago en tienda';
    }

    const who = $('#ws-anon').checked ? 'Anónimo' : ($('#ws-name').value.trim() || 'Sin nombre');
    pending = { who, email: email || 'No proporcionado', extra, declined };

    $('#ws-c-amount').textContent = fmt(state.amount) + ' MXN';
    $('#ws-c-freq').textContent = state.freq === 'mensual' ? 'Cargo mensual recurrente' : 'Pago único';
    $('#ws-c-who').textContent = who;
    $('#ws-c-email').textContent = pending.email;
    $('#ws-c-method').textContent = methodNames[state.method];
    $('#ws-c-extra-l').textContent = state.method === 'stripe' ? 'Tarjeta' : 'Detalle';
    $('#ws-c-extra').textContent = extra;
    $('#ws-c-ok').checked = false;
    $('#ws-c-go').disabled = true;
    $('#ws-c-go').innerHTML = '<span id="ws-c-go-text">' + (state.method === 'paynet' ? 'Confirmar y generar referencia' : 'Confirmar cobro de ' + fmt(state.amount)) + '</span>';
    confirmDlg.showModal();
  });

  $('#ws-c-ok').addEventListener('change', e => { $('#ws-c-go').disabled = !e.target.checked; });

  // Paso 2: confirmar → procesar → resultado
  $('#ws-c-go').addEventListener('click', () => {
    if (!pending || !$('#ws-c-ok').checked) return;
    const go = $('#ws-c-go');
    go.disabled = true;
    confirmDlg.querySelectorAll('[data-close]').forEach(b => b.disabled = true);
    const msgs = { paypal:'Conectando con PayPal…', stripe:'Procesando pago seguro…', paynet:'Generando referencia…' };
    go.innerHTML = '<span class="spinner"></span><span>' + msgs[state.method] + '</span>';
    
    // Simulación del tiempo de carga
    setTimeout(() => {
      confirmDlg.querySelectorAll('[data-close]').forEach(b => b.disabled = false);
      confirmDlg.close();
      showResult(pending);
      pending = null;
    }, 1600);
  });
  
  // Evita cerrar con Esc mientras procesa
  confirmDlg.addEventListener('cancel', e => { if ($('#ws-c-go .spinner')) e.preventDefault(); });

    function showResult(info){
    const body = $('#ws-result-body');
    const who = info.who;
    const methodName = methodNames[state.method];
    const amount = fmt(state.amount) + ' MXN' + (state.freq === 'mensual' ? ' / mes' : '');
    const date = new Date().toLocaleString('es-MX', { dateStyle:'medium', timeStyle:'short' });

    if (info.declined){
      $('#ws-result-title').textContent = 'Pago rechazado';
      body.innerHTML = '<div class="ok-ico" style="background:#fde8e7;color:#b3261e">✕</div>' +
        '<p style="text-align:center">Tu banco rechazó la transacción. Intenta con otra tarjeta u otro método de pago.</p>';
    } else if (state.method === 'paynet'){
      const ref = Array.from({length:4}, () => Math.floor(1000 + Math.random()*9000)).join(' ');
      $('#ws-result-title').textContent = 'Referencia generada';
      body.innerHTML = '<p>Presenta esta ficha en caja para realizar tu pago en efectivo.</p>' +
        '<div class="receipt"><dl>' +
        '<dt>Monto</dt><dd id="pdf-monto">' + amount + '</dd>' +
        '<dt>Vigencia</dt><dd>72 horas</dd>' +
        '<dt>Donante</dt><dd id="pdf-donante">' + escapeHtml(who) + '</dd>' +
        '<dt>Folio</dt><dd id="pdf-folio">' + folio('REF') + '</dd>' +
        '<dt>Método</dt><dd id="pdf-metodo">' + methodName + '</dd>' +
        '<dt>Fecha</dt><dd id="pdf-fecha">' + date + '</dd>' +
        '</dl><div class="barcode" aria-hidden="true"></div><div class="ref">' + ref + '</div></div>';
      
      // Hacemos visible el botón para Paynet
      document.getElementById('ws-download-pdf').style.display = 'block'; 

    } else {
      state.raised += state.amount; 
      state.donors += 1; 
      renderGoal();
      
      $('#ws-result-title').textContent = '¡Gracias por tu apoyo!';
      
      const folioGenerado = folio('DON');

      body.innerHTML = '<div class="ok-ico">✓</div>' +
        '<p style="text-align:center">Tu donativo se ha registrado exitosamente. Gracias por impulsar WOMEN SAFETY.</p>' +
        '<div class="receipt"><dl>' +
        '<dt>Folio</dt><dd id="pdf-folio">' + folioGenerado + '</dd>' +
        '<dt>Donante</dt><dd id="pdf-donante">' + escapeHtml(who) + '</dd>' +
        '<dt>Monto</dt><dd id="pdf-monto">' + amount + '</dd>' +
        '<dt>Método</dt><dd id="pdf-metodo">' + methodName + '</dd>' +
        '<dt>Detalle</dt><dd>' + escapeHtml(info.extra) + '</dd>' +
        '<dt>Fecha</dt><dd id="pdf-fecha">' + date + '</dd>' +
        '</dl></div>';
        
      // Hacemos visible el botón para PayPal y Tarjeta
      document.getElementById('ws-download-pdf').style.display = 'block';
    }
    resultDlg.showModal();
  }

  function escapeHtml(s){ return s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

  // Lógica para descargar el PDF
  document.getElementById('ws-download-pdf').addEventListener('click', async function() {
    const btn = this;
    const textoOriginal = btn.innerHTML;
    
    // Cambiamos el texto mientras carga
    btn.innerHTML = 'Generando PDF...';
    btn.disabled = true;

    // Tomamos los datos del recibo que acabamos de pintar en el modal
    const datos = {
      folio: document.getElementById('pdf-folio').innerText,
      donante: document.getElementById('pdf-donante').innerText,
      correo: document.getElementById('ws-email').value || 'No proporcionado',
      monto: document.getElementById('pdf-monto').innerText.replace('$', '').replace(' MXN', '').replace(' / mes', ''),
      metodo: document.getElementById('pdf-metodo').innerText,
      fecha: document.getElementById('pdf-fecha').innerText
    };

    try {
      // Hacemos la petición a tu backend (Node.js)
      const response = await fetch('/donaciones/ticket', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(datos)
      });

      if (response.ok) {
        // Si el backend responde con el PDF, lo descargamos
        const blob = await response.blob();
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `Ticket-${datos.folio}.pdf`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        window.URL.revokeObjectURL(url);
      } else {
        alert('Hubo un error al generar el ticket en el servidor.');
      }
    } catch (error) {
      console.error(error);
      alert('Error de conexión con el servidor.');
    } finally {
      // Restauramos el botón a su estado normal
      btn.innerHTML = textoOriginal;
      btn.disabled = false;
    }
  });



  renderGoal(); renderSummary(); updateSubmit();
})();
</script>