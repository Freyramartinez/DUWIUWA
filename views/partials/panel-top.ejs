<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> · Women Safety</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <!-- Estilos compartidos del sitio (van DESPUÉS de Bootstrap) -->
  <link rel="stylesheet" href="/css/main.css">
  <style>
    /* ===== Puente Bootstrap -> paleta de main.css ===== */
    :root { --bs-primary: var(--wine); --bs-primary-rgb: 142,58,104; --bs-link-color: var(--wine); --bs-link-color-rgb: 142,58,104; --bs-link-hover-color: var(--wine-dark); --bs-body-color: var(--dark); }
    body { font-family: 'Inter', sans-serif; background: #fffdfd linear-gradient(180deg, #fbeaf3 0, #fff8fb 340px, #fffdfd 100%) no-repeat; min-height: 100vh; }
    h1, h2, h3, .modal-title { font-family: 'Playfair Display', serif; font-weight: 600; }
    .ws-panel-main { max-width: 1250px; margin: 0 auto; padding: 48px 28px 70px; }
    .ws-title { font-size: clamp(2rem, 3.4vw, 2.9rem); line-height: 1.15; margin-bottom: 10px; }
    .ws-title em { font-style: normal; color: var(--wine); }
    .ws-sub { color: var(--gray); max-width: 620px; }

    /* Botones (píldora, como el resto del sitio) */
    .btn { border-radius: 30px; font-weight: 600; font-size: .88rem; padding: .65rem 1.4rem; }
    .btn-sm { padding: .4rem 1rem; font-size: .8rem; }
    .btn-primary { --bs-btn-bg: var(--wine); --bs-btn-border-color: var(--wine); --bs-btn-hover-bg: var(--wine-dark); --bs-btn-hover-border-color: var(--wine-dark); --bs-btn-active-bg: var(--wine-dark); --bs-btn-active-border-color: var(--wine-dark); }
    .btn-outline-primary { --bs-btn-color: var(--wine); --bs-btn-border-color: var(--wine); --bs-btn-hover-bg: var(--wine); --bs-btn-hover-border-color: var(--wine); --bs-btn-active-bg: var(--wine-dark); --bs-btn-active-border-color: var(--wine-dark); }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 25px rgba(142,58,104,.22); }

    /* Tarjetas, iconos, píldoras de estado */
    .card { border: 0; border-radius: 20px; box-shadow: 0 8px 30px rgba(80,40,65,.07); }
    .ws-icon { width: 46px; height: 46px; border-radius: 12px; background: var(--pink-light); display: flex; align-items: center; justify-content: center; flex: none; }
    .ws-icon svg { width: 22px; height: 22px; stroke: var(--wine); fill: none; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
    .ws-badge { display: inline-block; padding: .3rem .8rem; border-radius: 30px; font-size: .72rem; font-weight: 600; }
    .ws-badge-ok { background: var(--pink-light); color: var(--wine); }
    .ws-badge-off { background: #eee; color: var(--gray); }
    .ws-badge-warn { background: #fff3e0; color: #9a5b00; }
    .ws-stat-num { font-family: 'Playfair Display', serif; font-size: 1.7rem; line-height: 1; color: var(--dark); }
    .ws-stat-lbl { font-size: .78rem; color: var(--gray); }

    /* Pestañas tipo píldora */
    .nav-pills .nav-link { color: var(--gray); border-radius: 30px; font-weight: 500; padding: .5rem 1.25rem; }
    .nav-pills .nav-link.active { background: var(--wine); color: #fff; }

    /* Tablas y formularios */
    .table > :not(caption) > * > * { padding: 1rem 1.4rem; border-color: var(--border); }
    .table thead th { font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--gray); font-weight: 700; }
    .form-label { font-size: .82rem; font-weight: 600; color: #3d363d; }
    .form-control, .form-select { border-radius: 12px; border-color: var(--border); padding: .65rem .9rem; }
    .form-control:focus, .form-select:focus { border-color: var(--pink); box-shadow: 0 0 0 .2rem rgba(179,77,131,.15); }
    .modal-content { border: 0; border-radius: 20px; }
    .modal-header, .modal-footer { border-color: var(--border); }

    /* Calendario */
    .fc { --fc-border-color: var(--border); --fc-today-bg-color: var(--pink-light); --fc-event-bg-color: var(--wine); --fc-event-border-color: var(--wine); --fc-button-bg-color: var(--wine); --fc-button-border-color: var(--wine); --fc-button-hover-bg-color: var(--wine-dark); --fc-button-hover-border-color: var(--wine-dark); --fc-button-active-bg-color: var(--wine-dark); --fc-button-active-border-color: var(--wine-dark); font-family: 'Inter', sans-serif; }
    .fc a { color: inherit; text-decoration: none; }
    .fc .fc-toolbar-title { font-family: 'Playfair Display', serif; font-size: 1.55rem; text-transform: capitalize; }
    .fc .fc-button { border-radius: 30px; text-transform: capitalize; font-size: .82rem; font-weight: 600; padding: .45rem 1.1rem; }
    .fc .fc-button-group { gap: 6px; }
    .fc .fc-button-group > .fc-button { border-radius: 30px !important; margin-left: 0 !important; }
    .fc .fc-col-header-cell-cushion { font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; color: var(--gray); font-weight: 700; padding: 12px 0; }
    .fc .fc-daygrid-day-number { font-size: .85rem; color: #3d363d; padding: 8px 10px; }
    .fc .fc-event { border-radius: 6px; padding: 1px 5px; font-size: .78rem; cursor: pointer; }

    /* Botón de ojo para mostrar/ocultar contraseña */
    .ws-toggle-pass { background: #fff; border: 1px solid var(--border); color: var(--gray); border-top-right-radius: 12px; border-bottom-right-radius: 12px; padding: .4rem .9rem; }
    .ws-toggle-pass:hover, .ws-toggle-pass:focus { color: var(--wine); background: #fff; border-color: var(--pink); }

    /* Salir */
    .ws-logout { border: 1px solid var(--border); background: transparent; color: var(--gray); border-radius: 30px; padding: 6px 16px; font-size: .82rem; }
    .ws-logout:hover { color: var(--wine); border-color: var(--wine); }
  </style>
</head>
<body>
<nav class="ws-navbar">
  <div class="ws-navbar-inner">
    <span class="ws-logo"><span class="ws-logo-symbol">♀</span>WOMEN SAFETY</span>
    <div class="d-flex align-items-center">
      <span class="ws-badge ws-badge-ok me-3"><%= rol %></span>
      <div class="ws-nav-account m-0">
        <span class="ws-nav-avatar"><%= nombre.charAt(0).toUpperCase() %></span>
        <span class="ws-nav-name"><%= nombre %></span>
      </div>
      <form method="POST" action="/logout" class="ms-3"><button class="ws-logout">Salir</button></form>
    </div>
  </div>
</nav>
<main class="ws-panel-main">
<% if (locals.error) { %><div class="alert alert-danger rounded-4 mb-4"><%= error %></div><% } %>
