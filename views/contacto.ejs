<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SHERO - Contacto y Ubicación</title>
  <!-- Bootstrap 5.3 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <!-- MapLibre GL CSS -->
  <link href="https://unpkg.com/maplibre-gl@3.6.2/dist/maplibre-gl.css" rel="stylesheet" />
</head>
<body class="bg-light">

  <!-- Navegación -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold text-danger" href="/">
        <i class="bi bi-shield-lock-fill me-2"></i>SHERO S.A.P.I.
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link" href="/">Catálogo</a></li>
          <li class="nav-item"><a class="nav-link" href="/quienes-somos">¿Quiénes Somos?</a></li>
          <li class="nav-item"><a class="nav-link active" href="/contacto">Contacto y Ubicación</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container my-5">
    <div class="text-center mb-4">
      <h1 class="fw-bold text-dark"><i class="bi bi-geo-alt-fill text-danger me-2"></i>Contacto y Cobertura</h1>
      <p class="text-muted"><%= infoContacto.institucion %></p>
    </div>

    <div class="row g-4">
      <!-- Columna Formulario de Contacto -->
      <div class="col-lg-5">
        <div class="card border-0 shadow-sm p-4 h-100">
          <h4 class="fw-bold text-dark mb-3"><i class="bi bi-envelope-fill text-primary me-2"></i>Envíanos un mensaje</h4>
          <form>
            <div class="mb-3">
              <label class="form-label fw-semibold">Nombre Completo / Dependencia</label>
              <input type="text" class="form-control" placeholder="Ej. Ayuntamiento de Mixquiahuala" required>
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold">Correo Electrónico</label>
              <input type="email" class="form-control" placeholder="correo@ejemplo.com" required>
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold">Asunto</label>
              <select class="form-select">
                <option selected>Cotización de Kits B2G</option>
                <option>Soporte Técnico Wearable IoT</option>
                <option>Información General</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold">Mensaje</label>
              <textarea class="form-control" rows="4" placeholder="Escribe tu consulta aquí..." required></textarea>
            </div>
            <button type="submit" class="btn btn-primary w-100 fw-bold">
              <i class="bi bi-send-fill me-2"></i>Enviar Mensaje
            </button>
          </form>
        </div>
      </div>

      <!-- Columna Mapa Interactivo -->
      <div class="col-lg-7">
        <div class="card border-0 shadow-sm p-3 h-100">
          <h4 class="fw-bold text-dark mb-2"><i class="bi bi-map-fill text-warning me-2"></i>Mapa de Cobertura e Instalaciones</h4>
          <p class="text-muted small mb-3">Ubicación del centro de desarrollo y nodos receptores en Hidalgo.</p>
          
          <!-- Contenedor del Mapa -->
          <div id="map" class="rounded shadow-sm" style="width: 100%; height: 420px;"></div>
        </div>
      </div>
    </div>
  </div>

  <footer class="bg-dark text-white text-center py-4 mt-auto">
    <p class="mb-0">&copy; 2026 SHERO S.A.P.I. de C.V. - ITSOEH</p>
  </footer>

  <!-- MapLibre GL JS -->
  <script src="https://unpkg.com/maplibre-gl@3.6.2/dist/maplibre-gl.js"></script>
  <script>
    // Inicialización del Mapa con MapLibre GL (Coordenadas ITSOEH / Mixquiahuala)
    const map = new maplibregl.Map({
      container: 'map',
      style: 'https://demotiles.maplibre.org/style.json', // Estilo de mapa libre de llaves API
      center: [-99.2155, 20.2286], // Coordenadas aproximadas Mixquiahuala, Hgo.
      zoom: 12
    });

    // Agregar controles de navegación (Zoom / Brújula)
    map.addControl(new maplibregl.NavigationControl());

    // Agregar un Marcador en la ubicación principal
    new maplibregl.Marker({ color: '#dc3545' })
      .setLngLat([-99.2155, 20.2286])
      .setPopup(new maplibregl.Popup().setHTML('<b>SHERO S.A.P.I. - ITSOEH</b><br>Sede de Desarrollo IoT'))
      .addTo(map);
  </script>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>